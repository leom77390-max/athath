<!-- ============================================================
  SALLA SIDE SEARCH — Tailwind Edition
  Colors via Tailwind config:
    'background': "var(--color-background)"
    'font':       "var(--color-font)"
    'primary':    "var(--color-primary)"
============================================================ -->

<!-- ============================================================
  TRIGGER BUTTON
============================================================ -->


<!-- ============================================================
  OVERLAY
============================================================ -->
<div
  id="search-overlay"
  class="search-overlay fixed inset-0 bg-black/35 backdrop-blur-[4px] z-[1000] opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
></div>

<!-- ============================================================
  SEARCH DRAWER
============================================================ -->
<aside
  id="search-drawer"
  class="search-drawer fixed top-0 bottom-0 w-[420px] max-w-[100vw] bg-background shadow-[0_8px_40px_rgba(0,0,0,0.12)] z-[1001] flex flex-col overflow-hidden will-change-transform
         ltr:left-0 ltr:right-auto
         rtl:right-0 rtl:left-auto 
         max-[480px]:!rounded-none max-[480px]:!w-screen"
  role="dialog"
  aria-modal="true"
  aria-label="Search"
  aria-hidden="true"
>

  <!-- Header -->
  <header class="flex items-center gap-2.5 px-5 py-4  shrink-0">

    <div class="flex-1 relative flex items-center">

      <!-- Search Icon -->
      <span
        class="absolute flex items-center text-font pointer-events-none ltr:left-2 rtl:right-2"
        aria-hidden="true"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </span>

      <!-- Input -->
      <input
        type="search"
        id="search-input"
        class="w-full h-[52px] bg-font/5 border border-transparent border-b-1 border-b-[#8B8B8B]  text-sm text-font transition-[border-color,background] duration-300 appearance-none focus:outline-none focus:bg-background focus:border-primary placeholder:text-font/40 ltr:pl-11 ltr:pr-10 rtl:pr-11 rtl:pl-10 [&::-webkit-search-cancel-button]:hidden"
        placeholder="{{trans('blocks.side_search.placeholder')}}"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        maxlength="100"
        aria-label="Search"
        aria-autocomplete="list"
        aria-controls="search-results"
      >

      <!-- Clear Button -->
      <button
        id="search-clear"
        class="search-drawer__clear absolute flex items-center justify-center w-7 h-7 border-0 bg-font/10 rounded-full cursor-pointer text-font/60 opacity-0 scale-[0.8] transition-[opacity,transform,background] duration-200 hover:bg-font/20 ltr:right-2.5 rtl:left-2.5"
        aria-label="Clear search"
        hidden
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

    </div>

    <!-- Close -->
    <button
      id="search-close"
      class="inline-flex items-center justify-center w-10 h-10 shrink-0 border-0 text-font cursor-pointer  transition-[background,color] duration-300 hover:bg-font/5 hover:text-font
      bg-[#F7F7F8] rounded-full
      "
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

  </header>

  <!-- Scrollable Body -->
  <div class="search-drawer__body flex-1 overflow-y-auto overflow-x-hidden p-5 scroll-smooth [-webkit-overflow-scrolling:touch]">

    <!-- ── DEFAULT STATE ── -->
    <section
      id="search-default"
      class="search-section"
      aria-label="Default search suggestions"
    >

      <div
        id="search-settings-data"
        hidden
        data-categories='{{ theme.settings.get("side_search_popular_categories") | json_encode | raw }}'
        data-products='{{ theme.settings.get("side_search_featured_products") | json_encode | raw }}'
      ></div>

      <!-- Popular Searches -->
      <div id="popular-searches-section" class="mb-7 last:mb-0" hidden>
        <h2 class="font-normal text-[18px] leading-[18px] tracking-[0px] text-font mt-0 mb-3">
          {{trans('blocks.side_search.popular_searches')}}
        </h2>
        <nav id="popular-tags" class="flex flex-wrap gap-2" aria-label="Popular searches"></nav>
      </div>

      <!-- Featured Products -->
      <div id="featured-products-section" class="mb-7 last:mb-0" hidden>
        <h2 class="font-normal text-[18px] leading-[18px] tracking-[0px] text-font mt-0 mb-3">
          {{trans('blocks.side_search.most_searched_products')}}
        </h2>
        <div id="featured-products-list" class="flex flex-col gap-0.5" role="list"></div>
      </div>

    </section>

    <!-- ── LOADING STATE ── -->
    <section
      id="search-loading"
      class="search-section"
      aria-label="Loading"
      aria-live="polite"
      hidden
    >
      <div class="flex flex-col gap-2.5" aria-hidden="true">
        <div class="search-skeleton h-[88px] rounded-2xl"></div>
        <div class="search-skeleton h-[88px] rounded-2xl opacity-75"></div>
        <div class="search-skeleton h-[88px] rounded-2xl opacity-50"></div>
      </div>
    </section>

    <!-- ── RESULTS STATE ── -->
    <section
      id="search-results"
      class="search-section"
      role="listbox"
      aria-label="Search results"
      aria-live="polite"
      hidden
    ></section>

    <!-- ── EMPTY STATE ── -->
<section
  id="search-empty"
  class="search-section px-5 py-10 text-center"
  aria-live="polite"
  hidden
>

  <div class="flex flex-col items-center justify-center gap-2.5">

    <div class="text-font/40 mb-1.5 opacity-60" aria-hidden="true">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        <line x1="8" y1="11" x2="14" y2="11"/>
      </svg>
    </div>

    <p class="text-[15px] font-semibold text-font m-0" id="search-empty-text"></p>

    <p class="text-[13px] text-font/40 m-0">
      {{trans('blocks.side_search.try_different_keywords')}}
    </p>

  </div>

</section>

  </div>

</aside>


<!-- ============================================================
  MINIMAL STYLES
  Only what Tailwind can't express:
    - JS-toggled state classes (.is-open, .is-visible)
    - Keyframe animations
    - Webkit scrollbar overrides
    - Reduced motion reset
============================================================ -->
<style>

  /* ── Drawer slide transform (JS adds/removes .is-open) ── */
  .search-drawer {
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  [dir="ltr"] .search-drawer,
  :root:not([dir]) .search-drawer {
    transform: translateX(-100%);
  }

  [dir="rtl"] .search-drawer {
    transform: translateX(100%);
  }

  .search-drawer.is-open {
    transform: translateX(0);
  }

  /* ── Overlay visible state (JS adds .is-visible) ── */
  .search-overlay.is-visible {
    opacity: 1;
    pointer-events: all;
  }

  /* ── Body scroll lock ── */
  body.search-is-open {
    overflow: hidden;
  }

  /* ── Clear button revealed state ── */
  .search-drawer__clear:not([hidden]) {
    opacity: 1;
    transform: scale(1);
  }

  /* ── Section fade-in animation ── */
  @keyframes fadeSlideIn {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .search-section {
    animation: fadeSlideIn 0.24s ease forwards;
  }

  /* ── Skeleton shimmer animation ── */
  @keyframes shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .search-skeleton {
    background: linear-gradient(
      90deg,
      rgba(var(--color-font-raw, 0 0 0) / 0.07) 25%,
      rgba(var(--color-font-raw, 0 0 0) / 0.12) 50%,
      rgba(var(--color-font-raw, 0 0 0) / 0.07) 75%
    );
    background-size: 200% 100%;
    animation: shimmer 1.4s infinite;
  }

  /* ── Scrollbar ── */
  .search-drawer__body::-webkit-scrollbar { width: 4px; }
  .search-drawer__body::-webkit-scrollbar-track { background: transparent; }
  .search-drawer__body::-webkit-scrollbar-thumb {
    background: rgba(var(--color-font-raw, 0 0 0) / 0.1);
    border-radius: 4px;
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .search-drawer,
    .search-overlay,
    .search-drawer__clear,
    .search-section,
    .search-skeleton {
      transition: none !important;
      animation: none !important;
    }
  }

</style>


<!-- ============================================================
  JAVASCRIPT
============================================================ -->
<script>

salla.onReady(() => {

  'use strict';

  /* ════════════════════════════════════════════════════════════
     CONFIGURATION
  ════════════════════════════════════════════════════════════ */

  const CONFIG = {
    debounceDelay:   400,
    minQueryLength:  2,
    maxResults:      8,
  };

  /* ════════════════════════════════════════════════════════════
     STATE
  ════════════════════════════════════════════════════════════ */

  const state = {
    isOpen:          false,
    lastQuery:       '',
    debounceTimer:   null,
    abortController: null,
  };

  /* ════════════════════════════════════════════════════════════
     DOM REFERENCES
  ════════════════════════════════════════════════════════════ */

  const dom = {
    trigger:         document.querySelectorAll('.search-trigger'),
    overlay:         document.getElementById('search-overlay'),
    drawer:          document.getElementById('search-drawer'),
    closeBtn:        document.getElementById('search-close'),
    input:           document.getElementById('search-input'),
    clearBtn:        document.getElementById('search-clear'),

    defaultPanel:    document.getElementById('search-default'),
    loadingPanel:    document.getElementById('search-loading'),
    resultsPanel:    document.getElementById('search-results'),
    emptyPanel:      document.getElementById('search-empty'),
    emptyText:       document.getElementById('search-empty-text'),

    settingsData:    document.getElementById('search-settings-data'),
    popularSection:  document.getElementById('popular-searches-section'),
    featuredSection: document.getElementById('featured-products-section'),
    popularTags:     document.getElementById('popular-tags'),
    featuredList:    document.getElementById('featured-products-list'),
  };

  /* ════════════════════════════════════════════════════════════
     UTILITY HELPERS
  ════════════════════════════════════════════════════════════ */

  function debounce(fn, delay) {
    return function (...args) {
      clearTimeout(state.debounceTimer);
      state.debounceTimer = setTimeout(() => fn.apply(this, args), delay);
    };
  }

  function isArabic() {
    return document.documentElement.lang === 'ar';
  }

  function t(ar, en) {
    return isArabic() ? ar : en;
  }

  function escapeHTML(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function showPanel(panel) {
    [dom.defaultPanel, dom.loadingPanel, dom.resultsPanel, dom.emptyPanel]
      .forEach((p) => { p.hidden = p !== panel; });
  }

  /* ════════════════════════════════════════════════════════════
     DRAWER OPEN / CLOSE
  ════════════════════════════════════════════════════════════ */

  function openDrawer() {
    if (state.isOpen) return;
    state.isOpen = true;

    dom.drawer.classList.add('is-open');
    dom.drawer.setAttribute('aria-hidden', 'false');
    dom.overlay.classList.add('is-visible');
    dom.overlay.setAttribute('aria-hidden', 'false');
    dom.trigger.forEach((t) => t.setAttribute('aria-expanded', 'true'));
    document.body.classList.add('search-is-open');

    requestAnimationFrame(() => {
      setTimeout(() => dom.input.focus(), 50);
    });
  }

  function closeDrawer() {
    if (!state.isOpen) return;
    state.isOpen = false;

    dom.drawer.classList.remove('is-open');
    dom.drawer.setAttribute('aria-hidden', 'true');
    dom.overlay.classList.remove('is-visible');
    dom.overlay.setAttribute('aria-hidden', 'true');
    dom.trigger.forEach((t) => t.setAttribute('aria-expanded', 'false'));
    document.body.classList.remove('search-is-open');

    dom.trigger.forEach((t) => t.focus());
  }

  /* ════════════════════════════════════════════════════════════
     SEARCH LOGIC
  ════════════════════════════════════════════════════════════ */

  const handleInput = debounce(async () => {

    const query = dom.input.value.trim();

    dom.clearBtn.hidden = !query.length;

    if (!query.length) {
      state.lastQuery = '';
      showPanel(dom.defaultPanel);
      return;
    }

    if (query.length < CONFIG.minQueryLength) return;
    if (query === state.lastQuery) return;

    state.lastQuery = query;
    showPanel(dom.loadingPanel);

    try {
      const response = await salla.product.search(query);
      const products = (response.data || []).slice(0, CONFIG.maxResults);

      if (!products.length) { renderEmpty(query); return; }

      renderResults(products);
    } catch (err) {
      console.error('[SallaSearch] Search error:', err);
      renderError();
    }

  }, CONFIG.debounceDelay);

  /* ════════════════════════════════════════════════════════════
     RENDER FUNCTIONS
  ════════════════════════════════════════════════════════════ */

  function renderResults(products) {
    dom.resultsPanel.innerHTML = products
      .map((p) => buildProductCard(p, {
        nameKey:    'name',
        thumbKey:   'thumbnail',
        urlKey:     'url',
        priceKey:   'price',
        saleKey:    'sale_price',
        regularKey: 'regular_price',
        onSaleKey:  'has_special_price',
      }))
      .join('');
    showPanel(dom.resultsPanel);
  }

  function renderEmpty(query) {
    dom.emptyText.textContent = t(
      `لا توجد نتائج لـ "${escapeHTML(query)}"`,
      `No results for "${escapeHTML(query)}"`
    );
    showPanel(dom.emptyPanel);
  }

  function renderError() {
    dom.emptyText.textContent = t(
      'حدث خطأ أثناء البحث، حاول مجدداً',
      'Something went wrong. Please try again.'
    );
    showPanel(dom.emptyPanel);
  }

  function buildProductCard(product, keys) {

    const name   = escapeHTML(product[keys.nameKey] || '');
    const thumb  = product[keys.thumbKey] || (product.image && product.image.url) || '';
    const url    = product[keys.urlKey] || '#';
    const onSale = product[keys.onSaleKey] || product.is_on_sale || false;

    let priceHTML = '';

    if (onSale) {
      priceHTML = `
        <span class="text-sm font-bold text-red-500 leading-none">${formatPrice(product[keys.saleKey])}</span>
        <span class="text-xs font-normal text-font/40 line-through leading-none">${formatPrice(product[keys.regularKey])}</span>
      `;
    } else {
      priceHTML = `
        <span class="text-sm font-bold text-font leading-none">${formatPrice(product[keys.priceKey])}</span>
      `;
    }

    return `
      <a
        href="${url}"
        class="group flex items-center gap-3.5 p-2.5 rounded-2xl no-underline transition-colors duration-300 hover:bg-font/5"
        role="option"
        aria-label="${name}"
      >
        <div class="w-[123px] h-[123px] rounded-xl overflow-hidden shrink-0 bg-font/5">
          <img
            src="${escapeHTML(thumb)}"
            alt="${name}"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover block transition-transform duration-300 group-hover:scale-[1.04]"
            onerror="this.style.display='none'"
          >
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-[13.5px] font-semibold text-font m-0 mb-1.5 leading-[1.45] line-clamp-2">${name}</h3>
          <div class="flex items-center gap-2 flex-wrap">${priceHTML}</div>
        </div>
      </a>
    `;
  }

  function formatPrice(priceData) {
    if (!priceData) return '';
    if (typeof priceData === 'object' && priceData !== null) {
      return `${priceData.amount ?? ''} ${priceData.currency ?? ''}`.trim();
    }
    return String(priceData);
  }

  /* ════════════════════════════════════════════════════════════
     LOAD DEFAULT DATA
  ════════════════════════════════════════════════════════════ */

  async function loadDefaultData() {
    if (!dom.settingsData) return;

    let categoriesConfig = {};
    let productsConfig   = {};

    try {
      categoriesConfig = JSON.parse(dom.settingsData.dataset.categories || '{}');
      productsConfig   = JSON.parse(dom.settingsData.dataset.products   || '{}');
    } catch (e) {
      console.warn('[SallaSearch] Failed to parse settings data:', e);
    }

    const categoryIds = categoriesConfig.value || [];
    const productIds  = productsConfig.value   || [];

    if (categoryIds.length) loadPopularCategories(categoryIds);
    if (productIds.length)  loadFeaturedProducts(productIds);
  }

  async function loadPopularCategories(ids) {
    try {
      const responses = await Promise.all(ids.map((id) => salla.product.categories(id)));
      const tags = responses.map((r) => r.data).filter(Boolean);

      if (!tags.length) return;

      dom.popularTags.innerHTML = tags
        .map((cat) => `
          <a
            href="${escapeHTML(cat.url || '#')}"
            class="inline-flex items-center px-3.5 py-[7px] bg-[#F3F3F3] rounded-full text-[13px] font-medium text-font no-underline transition-[background,transform] duration-300 hover:bg-primary/10 hover:-translate-y-px whitespace-nowrap"
          >
            ${escapeHTML(cat.name || '')}
          </a>
        `)
        .join('');

      dom.popularSection.hidden = false;
    } catch (err) {
      console.warn('[SallaSearch] Categories load failed:', err);
    }
  }

  async function loadFeaturedProducts(ids) {
    try {
      const response = await salla.product.fetch({ source: 'selected', source_value: ids });
      const products = response.data || [];

      if (!products.length) return;

      dom.featuredList.innerHTML = products
        .map((p) => buildProductCard(p, {
          nameKey:    'name',
          thumbKey:   'thumbnail',
          urlKey:     'url',
          priceKey:   'price',
          saleKey:    'sale_price',
          regularKey: 'regular_price',
          onSaleKey:  'is_on_sale',
        }))
        .join('');

      dom.featuredSection.hidden = false;
    } catch (err) {
      console.warn('[SallaSearch] Featured products load failed:', err);
    }
  }

  /* ════════════════════════════════════════════════════════════
     CLEAR SEARCH
  ════════════════════════════════════════════════════════════ */

  function clearSearch() {
    dom.input.value = '';
    dom.clearBtn.hidden = true;
    state.lastQuery = '';
    showPanel(dom.defaultPanel);
    dom.input.focus();
  }

  /* ════════════════════════════════════════════════════════════
     EVENT LISTENERS
  ════════════════════════════════════════════════════════════ */

  dom.trigger.forEach((btn) => {
  btn.addEventListener('click', openDrawer);
  });
  dom.closeBtn.addEventListener('click', closeDrawer);
  dom.overlay.addEventListener('click', closeDrawer);
  dom.clearBtn.addEventListener('click', clearSearch);
  dom.input.addEventListener('input', handleInput);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && state.isOpen) closeDrawer();
  });

  dom.drawer.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !state.isOpen) return;

    const focusable = dom.drawer.querySelectorAll(
      'button:not([disabled]), input, a[href], [tabindex]:not([tabindex="-1"])'
    );
    const first = focusable[0];
    const last  = focusable[focusable.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault(); last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault(); first.focus();
    }
  });

  /* ════════════════════════════════════════════════════════════
     INIT
  ════════════════════════════════════════════════════════════ */

  function init() {
    showPanel(dom.defaultPanel);
    loadDefaultData();
  }

  init();

});

</script>