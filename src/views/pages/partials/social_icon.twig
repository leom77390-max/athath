

<!-- Share Modal -->
<div id="shareModal"
  class="fixed inset-0 z-[9999] hidden items-center justify-center !m-0">

  <!-- Backdrop -->
  <div id="shareBackdrop"
    class="absolute inset-0 bg-black/50 backdrop-blur-sm opacity-0 transition-opacity duration-500 ease-out">
  </div>

  <!-- Dialog -->
  <div id="shareDialog"
    class="relative bg-background w-[92vw] max-w-md rounded-[28px]
           p-8 shadow-[0_25px_80px_rgba(0,0,0,.18)]
           opacity-0 scale-[0.96] translate-y-6
           transition-all duration-500
           ease-[cubic-bezier(.16,1,.3,1)]">

    <button id="closeShareModal"
      class="absolute top-5 right-5 w-10 h-10 rounded-full
             flex items-center justify-center
             hover:bg-gray-100 transition">
      ✕
    </button>

    <h3 class="text-2xl font-semibold text-center mb-8 text-gray-900">
      Share this product
    </h3>

    <ul class="grid grid-cols-5 gap-4">

      <!-- Facebook -->
      <li>
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ product.url|url_encode }}"
          target="_blank"
          class="group flex flex-col items-center gap-2">

          <div class="w-14 h-14 rounded-2xl bg-[#1877F2]/10 text-[#1877F2]
                      flex items-center justify-center
                      transition-all duration-300
                      group-hover:scale-110 group-hover:-translate-y-1">

            <i class="sicon-facebook text-2xl"></i>
          </div>

          <span class="text-xs text-gray-500">Facebook</span>
        </a>
      </li>

      <!-- X -->
      <li>
        <a href="https://twitter.com/intent/tweet?url={{ product.url|url_encode }}"
          target="_blank"
          class="group flex flex-col items-center gap-2">

          <div class="w-14 h-14 rounded-2xl bg-black/5
                      flex items-center justify-center
                      transition-all duration-300
                      group-hover:scale-110 group-hover:-translate-y-1">

            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26L22.827 21.75H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231L18.244 2.25z"/>
            </svg>
          </div>

          <span class="text-xs text-gray-500">X</span>
        </a>
      </li>

      <!-- WhatsApp -->
      <li>
        <a href="https://wa.me/?text={{ product.url|url_encode }}"
          target="_blank"
          class="group flex flex-col items-center gap-2">

          <div class="w-14 h-14 rounded-2xl bg-[#25D366]/10 text-[#25D366]
                      flex items-center justify-center
                      transition-all duration-300
                      group-hover:scale-110 group-hover:-translate-y-1">

            <i class="sicon-whatsapp text-2xl"></i>
          </div>

          <span class="text-xs text-gray-500">WhatsApp</span>
        </a>
      </li>

      <!-- Email -->
      <li>
        <a href="mailto:?subject={{ product.name|url_encode }}&body={{ product.url|url_encode }}"
          class="group flex flex-col items-center gap-2">

          <div class="w-14 h-14 rounded-2xl bg-gray-100
                      flex items-center justify-center
                      transition-all duration-300
                      group-hover:scale-110 group-hover:-translate-y-1">

            <i class="sicon-mail text-xl"></i>
          </div>

          <span class="text-xs text-gray-500">Email</span>
        </a>
      </li>

      <!-- Copy -->
      <li>
        <button id="copyShareLink"
          class="group flex flex-col items-center gap-2 w-full">

          <div id="copyIcon"
            class="w-14 h-14 rounded-2xl bg-gray-100
                   flex items-center justify-center
                   transition-all duration-300
                   group-hover:scale-110 group-hover:-translate-y-1">

            <i class="sicon-link text-xl"></i>
          </div>

          <span id="copyText"
            class="text-xs text-gray-500 transition-all duration-300">
            Copy
          </span>
        </button>
      </li>

    </ul>

  </div>
</div>

<script>
(() => {

  const modal = document.getElementById('shareModal');
  const dialog = document.getElementById('shareDialog');
  const backdrop = document.getElementById('shareBackdrop');

  let isOpen = false;

  function openModal() {
    if (isOpen) return;

    isOpen = true;

    modal.classList.remove('hidden');
    modal.classList.add('flex');

    requestAnimationFrame(() => {

      backdrop.classList.remove('opacity-0');
      backdrop.classList.add('opacity-100');

      dialog.classList.remove(
        'opacity-0',
        'scale-[0.96]',
        'translate-y-6'
      );

      dialog.classList.add(
        'opacity-100',
        'scale-100',
        'translate-y-0'
      );

    });
  }

  function closeModal() {

    backdrop.classList.remove('opacity-100');
    backdrop.classList.add('opacity-0');

    dialog.classList.remove(
      'opacity-100',
      'scale-100',
      'translate-y-0'
    );

    dialog.classList.add(
      'opacity-0',
      'scale-[0.96]',
      'translate-y-6'
    );

    setTimeout(() => {
      modal.classList.remove('flex');
      modal.classList.add('hidden');
      isOpen = false;
    }, 500);
  }

  document.getElementById('openShareModal')
    .addEventListener('click', openModal);

  document.getElementById('closeShareModal')
    .addEventListener('click', closeModal);

  backdrop.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      closeModal();
    }
  });

  // Copy Link
  document.getElementById('copyShareLink')
    .addEventListener('click', async () => {

      try {

        await navigator.clipboard.writeText("{{ product.url }}");

        const copyText = document.getElementById('copyText');
        const copyIcon = document.getElementById('copyIcon');

        copyText.textContent = 'Copied ✓';

        copyIcon.classList.remove('bg-gray-100');
        copyIcon.classList.add(
          'bg-emerald-100',
          'text-emerald-600',
          'scale-110'
        );

        setTimeout(() => {

          copyText.textContent = 'Copy';

          copyIcon.classList.remove(
            'bg-emerald-100',
            'text-emerald-600',
            'scale-110'
          );

          copyIcon.classList.add('bg-gray-100');

        }, 1800);

      } catch (err) {
        console.error(err);
      }

    });

})();
</script>