{% if theme.settings.get('enable_loader_screen') %}
	{% if theme.settings.get('loader_type') == 'logo_loader' %}
		<style>
			.loader-init {
				position: fixed;
				top: 0;
				left: 0;
				width: 100vw;
				height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				backdrop-filter: blur(15px);
				transition: opacity 0.75s, visibility 0.75s;
				z-index: 9999;
			}
			.loader-init--hidden {
				opacity: 0;
				visibility: hidden;
			}
			.loader-container {
				position: relative;
				width: 300px;
				height: 300px;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				gap: 20px;
			}
			
			/* حاوية اللوجو مع تأثير النبض */
			.logo-wrapper {
				position: relative;
				z-index: 2;
				animation: logoPulse 2s ease-in-out infinite;
			}
			
			.logo-wrapper img {
				max-height: 80px;
				width: auto;
				filter: drop-shadow(0 0 20px rgba(33, 99, 109, 0.3));
			}
			
			@keyframes logoPulse {
				0%, 100% { transform: scale(1); }
				50% { transform: scale(1.05); }
			}
			
			
			@keyframes spin {
				from { transform: translate(-50%, -50%) rotate(0deg); }
				to { transform: translate(-50%, -50%) rotate(360deg); }
			}
			
			.particles {
				position: absolute;
				width: 100%;
				height: 100%;
				top: 0;
				left: 0;
				z-index: 1;
			}
			
			.particle {
				position: absolute;
				border-radius: 50%;
				background: radial-gradient(circle at 30% 30%, rgba(33, 99, 109, 0.3), rgba(33, 99, 109, 0.1));
				animation: float 4s ease-in-out infinite;
			}
			
			.particle:nth-child(1) {
				width: 12px;
				height: 12px;
				top: 5%;
				left: 15%;
				animation-delay: 0s;
			}
			.particle:nth-child(2) {
				width: 8px;
				height: 8px;
				bottom: 10%;
				right: 10%;
				animation-delay: 1s;
			}
			.particle:nth-child(3) {
				width: 10px;
				height: 10px;
				top: 20%;
				right: 5%;
				animation-delay: 2s;
			}
			.particle:nth-child(4) {
				width: 6px;
				height: 6px;
				bottom: 25%;
				left: 5%;
				animation-delay: 0.5s;
			}
			.particle:nth-child(5) {
				width: 14px;
				height: 14px;
				top: 50%;
				left: -5%;
				animation-delay: 1.5s;
			}
			.particle:nth-child(6) {
				width: 7px;
				height: 7px;
				top: 60%;
				right: -5%;
				animation-delay: 2.5s;
			}
			
			@keyframes float {
				0%, 100% { transform: translateY(0px) scale(1); opacity: 0.6; }
				50% { transform: translateY(-15px) scale(1.2); opacity: 1; }
			}
			
			/* نص العلامة التجارية أسفل اللودر */
			.brand-text {
				position: relative;
				z-index: 2;
				color: #21636d;
				font-size: 13px;
				font-weight: 300;
				letter-spacing: 3px;
				opacity: 0;
				animation: fadeInText 1.5s ease-in-out 0.5s forwards;
			}
			
			@keyframes fadeInText {
				from { opacity: 0; transform: translateY(10px); }
				to { opacity: 0.7; transform: translateY(0); }
			}
			
			/* توهج الخلفية */
			.glow-bg {
				position: absolute;
				width: 100%;
				height: 100%;
				background: radial-gradient(circle, rgba(33, 99, 109, 0.08) 0%, transparent 70%);
				border-radius: 50%;
				z-index: 0;
				animation: glowPulse 3s ease-in-out infinite;
			}
			
			@keyframes glowPulse {
				0%, 100% { transform: scale(1); opacity: 0.5; }
				50% { transform: scale(1.1); opacity: 1; }
			}
		</style>
		
		<div class="loader-init" id="page-loader">
			<div class="loader-container">
				<div class="glow-bg"></div>
				
				<div class="particles">
					<div class="particle"></div>
					<div class="particle"></div>
					<div class="particle"></div>
					<div class="particle"></div>
					<div class="particle"></div>
					<div class="particle"></div>
				</div>
				
				<div class="logo-wrapper">
					{% if theme.settings.get('change_loder') %}
						{% if theme.settings.get('custom_loader_image') %}
							<img src="{{ theme.settings.get('custom_loader_image') }}" alt="{{ store.name }}" />
						{% else %}
							{% if store.logo %}
								<img src="{{ store.logo }}" alt="{{ store.name }}" />
							{% endif %}
						{% endif %}
					{% else %}
						{% if store.logo %}
							<img src="{{ store.logo }}" alt="{{ store.name }}" />
						{% endif %}
					{% endif %}
				</div>
      </div>
		</div>
		
	{% elseif theme.settings.get('loader_type') == 'custom_loader' %}
		<style>
    .loader-init{position:fixed;inset:0;display:flex;align-items:center;
      justify-content:center;background:#f9f6f2;z-index:999999;
      transition:opacity .8s,visibility .8s}
    .lc{display:flex;flex-direction:column;align-items:center;gap:20px;position:relative;z-index:2}
    .ring{position:absolute;border-radius:50%;border:1px solid rgba(126,184,163,.25);
      animation:rEx 3.2s ease-out infinite}
    .ring:nth-child(1){width:120px;height:120px;animation-delay:0s}
    .ring:nth-child(2){width:168px;height:168px;animation-delay:.8s}
    .ring:nth-child(3){width:220px;height:220px;animation-delay:1.6s}
    @keyframes rEx{0%{opacity:.6;transform:scale(.6)}100%{opacity:0;transform:scale(1)}}
    .sb{position:relative;width:64px;height:90px}
    .s-cap{position:absolute;top:0;left:50%;transform:translateX(-50%);
      width:28px;height:22px;background:#8a7a68;border-radius:4px 4px 2px 2px;
      animation:cB 3s ease-in-out infinite}
    @keyframes cB{0%,100%{transform:translateX(-50%) translateY(0)}
      50%{transform:translateX(-50%) translateY(-5px)}}
    .s-neck{position:absolute;top:18px;left:50%;transform:translateX(-50%);
      width:20px;height:18px;background:#b8a590;border-radius:3px 3px 0 0}
    .s-body{position:absolute;bottom:0;left:50%;transform:translateX(-50%);
      width:44px;height:64px;background:linear-gradient(160deg,#e8ddd2,#c9b89e);
      border-radius:8px 8px 14px 14px;overflow:hidden}
    .s-shine{position:absolute;top:8px;left:8px;width:10px;height:28px;
      background:rgba(255,255,255,.35);border-radius:5px}
    .s-fill{position:absolute;bottom:0;left:0;right:0;
      background:linear-gradient(to top,#7eb8a3,#a2cfc0);
      border-radius:0 0 14px 14px;animation:fR 3s ease-in-out infinite}
    @keyframes fR{0%{height:10%;opacity:.7}50%{height:65%;opacity:1}100%{height:10%;opacity:.7}}
    .drop{position:absolute;width:7px;height:10px;
      background:radial-gradient(ellipse at 35% 30%,rgba(162,207,192,.9),rgba(126,184,163,.6));
      border-radius:50% 50% 60% 60%;opacity:0;animation:dA 4s ease-in-out infinite}
    .drop:nth-child(1){left:18%;top:20%;animation-delay:0s}
    .drop:nth-child(2){right:16%;top:30%;animation-delay:1.3s}
    .drop:nth-child(3){left:12%;bottom:22%;animation-delay:2.1s}
    .drop:nth-child(4){right:14%;bottom:28%;animation-delay:.7s}
    @keyframes dA{0%{opacity:0;transform:translateY(-12px) scale(.6)}
      25%{opacity:1;transform:translateY(0) scale(1)}
      75%{opacity:1;transform:translateY(0) scale(1)}
      100%{opacity:0;transform:translateY(16px) scale(.7)}}
    .brand-name{font-size:22px;font-weight:500;letter-spacing:6px;color:#4a3f35;
      text-transform:uppercase;animation:nP 3s ease-in-out infinite}
    .tagline{font-size:11px;letter-spacing:3px;color:#8a7a6a;text-transform:uppercase;
      animation:nP 3s ease-in-out infinite .5s}
    .prog{width:120px;height:2px;background:rgba(126,184,163,.2);border-radius:2px;overflow:hidden}
    .prog-f{height:100%;width:0;background:linear-gradient(90deg,#7eb8a3,#b2d4c8);
      border-radius:2px;animation:pF 3s ease-in-out infinite}
    @keyframes nP{0%,100%{opacity:.7}50%{opacity:1}}
    @keyframes pF{0%{width:0}60%{width:100%}100%{width:100%;opacity:0}}
    </style>

    <div class="loader-init" id="page-loader">
      <div style="position:relative;display:flex;align-items:center;justify-content:center">
        <div class="ring"></div><div class="ring"></div><div class="ring"></div>
        <div class="lc">
          <div class="sb">
            <div class="s-cap"></div>
            <div class="s-neck"></div>
            <div class="s-body">
              <div class="s-shine"></div>
              <div class="s-fill"></div>
              <div class="drop"></div>
              <div class="drop"></div>
              <div class="drop"></div>
              <div class="drop"></div>
            </div>
          </div>
          <div style="text-align:center;display:flex;flex-direction:column;gap:10px;align-items:center">
            <div class="brand-name">{{store.name}}</div>
            <div class="prog"><div class="prog-f"></div></div>
          </div>
        </div>
      </div>
    </div>
		
	{% elseif theme.settings.get('loader_type') == 'shopflex_loader' %}
		<style>
			/* Shopflex Custom Animations */
			.shopflex-layer {
				transform: translateY(100vh);
				border-top-left-radius: 50% 15vh;
				border-top-right-radius: 50% 15vh;
			}
			.shopflex-white-layer {
				z-index: 1;
				animation: slideInFromBottom 1s cubic-bezier(0.77, 0, 0.175, 1) forwards;
			}
			.shopflex-black-layer {
				z-index: 2;
				animation: slideInFromBottom 1s cubic-bezier(0.77, 0, 0.175, 1) 0.15s forwards;
			}
			.shopflex-loader-wrapper.hide .shopflex-black-layer .curtain-path {
				animation: pullCurtain 1s cubic-bezier(0.77, 0, 0.175, 1) forwards;
				animation-delay: 0.1s; 
			}
			.shopflex-loader-wrapper.hide .shopflex-white-layer .curtain-path {
				animation: pullCurtain 1s cubic-bezier(0.77, 0, 0.175, 1) forwards;
				animation-delay: 0.25s; 
			}
			.shopflex-loader-wrapper.hide .loader-content {
				transform: translateY(-40px);
				opacity: 0;
			}
			.logo-path {
				stroke: #ffffff; 
				stroke-width: 1;
				fill: transparent;
				stroke-dasharray: 300;
				stroke-dashoffset: 300;
				animation: drawLogo 1.5s ease 1s forwards, fillLogo 0.5s ease 2.2s forwards;
			}
			.loader-progress::after {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				height: 100%;
				width: 100%;
				background: #ffffff; 
				transform: translateX(-100%);
				animation: loadProgress 2s cubic-bezier(0.4, 0, 0.2, 1) 1s forwards;
			}

			@keyframes slideInFromBottom {
				0% { transform: translateY(100vh); border-top-left-radius: 50% 15vh; border-top-right-radius: 50% 15vh; }
				100% { transform: translateY(0); border-top-left-radius: 50% 0; border-top-right-radius: 50% 0; }
			}
			@keyframes pullCurtain {
				0% { d: path("M 0 0 L 100 0 L 100 100 Q 50 100 0 100 Z"); }
				50% { d: path("M 0 0 L 100 0 L 100 75 Q 50 40 0 75 Z"); }
				100% { d: path("M 0 0 L 100 0 L 100 0 Q 50 0 0 0 Z"); }
			}
			@keyframes drawLogo {
				100% { stroke-dashoffset: 0; }
			}
			@keyframes fillLogo {
				100% { fill: #ffffff; stroke-color: transparent; }
			}
			@keyframes loadProgress {
				100% { transform: translateX(0); }
			}
		</style>

		<div id="page-loader" class="shopflex-loader-wrapper fixed inset-0 w-screen h-screen z-[9999] pointer-events-auto">
			<!-- LAYER 1: The White Background -->
			<div class="shopflex-layer shopflex-white-layer absolute inset-0 flex justify-center items-center overflow-hidden">
				<svg class="curtain-svg absolute inset-0 w-full h-full -z-10" viewBox="0 0 100 100" preserveAspectRatio="none">
					<path class="curtain-path" fill="#ffffff" d="M 0 0 L 100 0 L 100 100 Q 50 100 0 100 Z"></path>
				</svg>
			</div>

			<!-- LAYER 2: The Black Loader Layer -->
			<div class="shopflex-layer shopflex-black-layer absolute inset-0 flex justify-center items-center overflow-hidden">
				<svg class="curtain-svg absolute inset-0 w-full h-full -z-10" viewBox="0 0 100 100" preserveAspectRatio="none">
					<path class="curtain-path" fill="#000000" d="M 0 0 L 100 0 L 100 100 Q 50 100 0 100 Z"></path>
				</svg>

				<!-- The Logo and Progress Bar -->
				<div class="loader-content flex flex-col items-center text-white transition-all duration-500 ease-in-out z-10">
					<svg class="loader-logo w-[150px] h-auto mb-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 118 34">
						<g>
							<path class="logo-path" d="M66.99 21.947c-2.609 0-4.79-2.032-4.79-4.958.118-6.55 9.484-6.522 9.613 0 0 2.932-2.216 4.957-4.824 4.957Zm0-13.357c-6.958-.097-10.814 7.554-7.005 13.282 3.124 4.69 10.902 4.673 14.038 0 3.839-5.74-.07-13.379-7.028-13.282m32.031 6.225c.24-.645.603-1.232 1.137-1.706 2.157-1.866 6.5-1.318 7.185 1.706h-8.322Zm12.208 1.945c.129-11.148-16.323-10.651-16.276.177-.076 3.292 1.835 6.636 5.052 7.857 3.271 1.3 7.415.519 9.712-2.169 0 0 .446-.456-.053-.798l-.445-.308s-1.231-.845-1.624-1.153c-.392-.308-.638.052-.638.052-1.044 1.26-2.849 1.7-4.443 1.466-2.222-.274-3.722-2.083-3.833-4.21h11.968c.322 0 .58-.258.58-.571v-.348"></path>
							<path class="logo-path" d="M85.352 21.952c-2.58 0-4.865-1.968-4.865-5.003.287-6.562 9.495-6.465 9.595 0 0 2.807-2.122 5.003-4.73 5.003Zm.416-13.362c-2.075 0-4.12.793-5.281 2.305V2.896a.477.477 0 0 0-.48-.467h-2.75a.476.476 0 0 0-.48.467V16.51c-.235 5.295 3.3 8.94 8.475 8.895 11.288.245 11.248-16.677.522-16.808M38.62 23.87l-3.006 7.234c-.082.256.059.467.328.467h3.025c.263 0 .55-.21.638-.467l9.05-21.452a.47.47 0 0 0-.446-.645h-2.79a.774.774 0 0 0-.714.468l-4.074 9.784-4.068-9.784a.77.77 0 0 0-.715-.468h-2.795a.47.47 0 0 0-.446.645l6.02 14.223-.006-.006Zm20.122-11.948.3-2.561a.472.472 0 0 0-.382-.508c-.504-.103-1.67-.268-2.227-.263-4.8-.256-7.62 2.785-7.532 7.258v8.683c0 .257.217.468.481.468h2.784a.44.44 0 0 0 .446-.434V16.88c0-1.951.263-3.183 1.066-3.868 1.348-1.141 3.576-.89 4.525-.702a.446.446 0 0 0 .533-.382M6.192 16.949c0-2.842 2.121-4.907 4.73-4.907 6.406.211 6.523 9.693 0 9.916-2.609 0-4.73-2.197-4.73-5.004m-3.681.023c0 5.198 3.51 8.444 8.51 8.421 5.181.052 8.71-3.594 8.475-8.889V2.896a.47.47 0 0 0-.48-.467h-2.75a.476.476 0 0 0-.48.467v8c-1.16-1.507-3.206-2.306-5.28-2.306-4.361 0-7.995 3.287-7.995 8.387Zm28.696-5.055.299-2.561a.472.472 0 0 0-.381-.508c-.504-.103-1.67-.268-2.227-.263-4.8-.256-7.62 2.785-7.532 7.258v8.683c0 .257.217.468.48.468h2.785a.44.44 0 0 0 .445-.434V16.88c0-1.951.264-3.183 1.067-3.868 1.348-1.141 3.575-.89 4.525-.702a.443.443 0 0 0 .533-.382m80.76-3.446c-1.488 0-2.696-1.175-2.696-2.624.141-3.48 5.252-3.48 5.393 0 0 1.449-1.208 2.624-2.697 2.624Zm0-6.053c-1.945 0-3.522 1.534-3.522 3.429.188 4.552 6.863 4.552 7.051 0 0-1.895-1.583-3.43-3.529-3.43Z"></path>
						</g>
					</svg>
					<div class="loader-progress w-[150px] h-[2px] bg-white/20 relative overflow-hidden rounded-[2px]"></div>
				</div>
			</div>
		</div>
		
	{% else %}
		<style>
			.loader-init {
				position: fixed;
				top: 0;
				left: 0;
				width: 100vw;
				height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				background: white;
				transition: opacity 0.75s, visibility 0.75s;
				z-index: 9999;
			}
			.loader-init--hidden {
				opacity: 0;
				visibility: hidden;
			}
			.loader-init::after {
				content: "";
				width: 36px;
				height: 36px;
				border: 3px solid #eee;
				border-top-color: var(--color-primary);
				border-radius: 50%;
				animation: loading 0.75s ease infinite;
			}
			@keyframes loading {
				from {
					transform: rotate(0turn);
				}
				to {
					transform: rotate(1turn);
				}
			}
		</style>
		
		<div class="loader-init" id="page-loader"></div>
	{% endif %}

	<script>
		window.addEventListener("load", () => {
			const loader = document.getElementById("page-loader");
			if (loader) {
				if (loader.classList.contains('shopflex-loader-wrapper')) {
					// Shopflex specific logic
					setTimeout(() => {
						loader.classList.add('hide');
						setTimeout(() => {
							if (loader.parentNode) {
								loader.parentNode.removeChild(loader);
							}
						}, 1500); 
					}, 3500);
				} else {
					// Default logic
					loader.style.opacity = '0';
					loader.style.visibility = 'hidden';
					loader.addEventListener("transitionend", () => {
						if (loader.parentNode) {
							loader.parentNode.removeChild(loader);
						}
					});
				}
			}
		});
	</script>
{% endif %}