{% if theme.settings.get('enable_loader_screen') %}
	{% if theme.settings.get('loader_type') == 'logo_loader' %}
		<style>
			.loader-init {
				position: fixed;
				top: 0;
				left: 0;
				width: 100vw;
				height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				backdrop-filter: blur(15px);
				transition: opacity 0.75s, visibility 0.75s;
				z-index: 9999;
			}
			.loader-container {
				position: relative;
				width: 400px;
				height: 300px;
				display: flex;
				justify-content: center;
				align-items: center;
			}
			.text {
				position: relative;
				z-index: 1;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.text img {
				animation: scaleUpDown 1s ease-in-out infinite;
			}
			@keyframes scaleUpDown {
				0,
				100% {
					transform: scale(1);
				}
				50% {
					transform: scale(1.2);
				}
			}
			.orbit-container {
				position: absolute;
				width: 100%;
				height: 100%;
				animation: rotate 2.5s linear infinite;
			}
			.semicircle {
				position: absolute;
				top: 50%;
				left: 50%;
				width: 200px;
				height: 200px;
				border: 4px solid var(--color-primary);
				border-bottom-color: transparent;
				border-left-color: transparent;
				border-radius: 50%;
				transform: translate(-50%, -50%) rotate(-45deg);
			}
			.ball {
				position: absolute;
				top: 75%;
				left: 57%;
				width: 20px;
				height: 20px;
				background: var(--color-primary);
				border-radius: 50%;
				box-shadow: 0 0 15px rgba(76, 175, 80, 0.6);
				transform: translate(-50%, -50%) rotate(-45deg) translateX(100px);
			}
			@keyframes rotate {
				from {
					transform: rotate(0deg);
				}
				to {
					transform: rotate(360deg);
				}
			}
			.glow {
				position: absolute;
				width: 100%;
				height: 100%;
				background: radial-gradient(circle, rgba(76, 175, 80, 0.1) 0%, transparent 70%);
				border-radius: 50%;
				animation: pulse 2s ease-in-out infinite;
			}
			@keyframes pulse {
				0,
				100% {
					opacity: 0.5;
					transform: scale(1);
				}
				50% {
					opacity: 0.8;
					transform: scale(1.1);
				}
			}
		</style>
	{% elseif theme.settings.get('loader_type') == 'custom_loader' %}
		<style>
		.loader-init {
			position: fixed;
			inset: 0;
			width: 100vw;
			height: 100vh;
			display: flex;
			align-items: center;
			justify-content: center;
			background-color: #ffffff;
			z-index: 999999;
			transition: opacity 0.6s ease, visibility 0.6s ease;
		}

		.smart-loader-container {
			position: relative;
			width: 120px;
			height: 140px;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
		}

		.circuit-leaf {
			width: 80px;
			height: 80px;
			fill: none;
			stroke-linecap: round;
			stroke-linejoin: round;
			overflow: visible;
		}

		.leaf-path {
			stroke: var(--color-primary, #367e18); /* Green */
			stroke-width: 2;
			stroke-dasharray: 200;
			stroke-dashoffset: 200;
			animation: draw-circuit 3s ease-in-out infinite;
			opacity: 0.8;
		}

		.vein-path {
			stroke: var(--color-primary, #367e18);
			stroke-width: 1.5;
			stroke-dasharray: 50;
			stroke-dashoffset: 50;
			animation: draw-circuit 3s ease-in-out infinite;
			animation-delay: 0.5s; /* Draw veins after outline starts */
			opacity: 0.6;
		}

		.node-point {
			fill: #fff;
			stroke: var(--color-primary, #367e18);
			stroke-width: 1.5;
			transform: scale(0);
			transform-origin: center;
			animation: pop-node 3s ease-in-out infinite;
			animation-delay: 1.5s;
		}

		.data-dot {
			position: absolute;
			width: 6px;
			height: 6px;
			background-color: var(--secondary-color, #f57328); /* Orange */
			border-radius: 50%;
			box-shadow: 0 0 10px var(--secondary-color, #f57328);
			top: 0;
			left: 0;
			offset-path: path("M60 105 C 20 80, 10 50, 60 15 C 110 50, 100 80, 60 105"); /* Follows leaf shape approx */
			animation: trace-path 3s linear infinite;
			z-index: 10;
			opacity: 0;
		}

		.smart-text {
			margin-top: 15px;
			font-size: 20px;
			letter-spacing: 2px;
			color: var(--color-primary, #367e18);
			opacity: 0;
			animation: text-fade 3s ease-in-out infinite;
			font-weight: bold;
		}


		@keyframes draw-circuit {
			0% { stroke-dashoffset: 200; opacity: 0; }
			20% { opacity: 1; }
			80% { stroke-dashoffset: 0; opacity: 1; }
			100% { stroke-dashoffset: 0; opacity: 0; }
		}

		@keyframes pop-node {
			0%, 40% { transform: scale(0); }
			50% { transform: scale(1.5); }
			70% { transform: scale(1); }
			100% { transform: scale(0); }
		}

		@keyframes trace-path {
			0% { offset-distance: 0%; opacity: 0; }
			10% { opacity: 1; }
			90% { opacity: 1; }
			100% { offset-distance: 100%; opacity: 0; }
		}

		@keyframes text-fade {
			0%, 20% { opacity: 0; letter-spacing: 0px; }
			50% { opacity: 1; letter-spacing: 2px; }
			90% { opacity: 0; letter-spacing: 4px; }
		}
		</style>
	{% else %}
		<style>
			.loader-init {
				position: fixed;
				top: 0;
				left: 0;
				width: 100vw;
				height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				background: white;
				transition: opacity 0.75s, visibility 0.75s;
				z-index: 9999;
			}
			.loader-init--hidden {
				opacity: 0;
				visibility: hidden;
			}
			.loader-init::after {
				content: "";
				width: 36px;
				height: 36px;
				border: 3px solid #eee;
				border-top-color: var(--color-primary);
				border-radius: 50%;
				animation: loading 0.75s ease infinite;
			}
			@keyframes loading {
				from {
					transform: rotate(0turn);
				}
				to {
					transform: rotate(1turn);
				}
			}
		</style>
	{% endif %}

	<script>
		window.addEventListener("load", () => {
			const loader = document.querySelector(".loader-init");
			if (loader) {
				loader.style.opacity = '0';
				loader.style.visibility = 'hidden';
				loader.addEventListener("transitionend", () => {
					if (loader.parentNode) {
						loader.parentNode.removeChild(loader);
					}
				});
			}
		});
	</script>
{% endif %}