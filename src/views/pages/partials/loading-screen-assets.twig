{% if theme.settings.get('enable_loader_screen') %}
	{% if theme.settings.get('loader_type') == 'logo_loader' %}
		<style>
			.loader-init {
				position: fixed;
				top: 0;
				left: 0;
				width: 100vw;
				height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				backdrop-filter: blur(15px);
				transition: opacity 0.75s, visibility 0.75s;
				z-index: 9999;
			}
			.loader-init--hidden {
				opacity: 0;
				visibility: hidden;
			}
			.loader-container {
				position: relative;
				width: 300px;
				height: 300px;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				gap: 20px;
			}
			
			/* حاوية اللوجو مع تأثير النبض */
			.logo-wrapper {
				position: relative;
				z-index: 2;
				animation: logoPulse 2s ease-in-out infinite;
			}
			
			.logo-wrapper img {
				max-height: 80px;
				width: auto;
				filter: drop-shadow(0 0 20px rgba(33, 99, 109, 0.3));
			}
			
			@keyframes logoPulse {
				0%, 100% { transform: scale(1); }
				50% { transform: scale(1.05); }
			}
			
			
			@keyframes spin {
				from { transform: translate(-50%, -50%) rotate(0deg); }
				to { transform: translate(-50%, -50%) rotate(360deg); }
			}
			
			/* جسيمات العناية (مثل الفقاعات أو القطرات) */
			.particles {
				position: absolute;
				width: 100%;
				height: 100%;
				top: 0;
				left: 0;
				z-index: 1;
			}
			
			.particle {
				position: absolute;
				border-radius: 50%;
				background: radial-gradient(circle at 30% 30%, rgba(33, 99, 109, 0.3), rgba(33, 99, 109, 0.1));
				animation: float 4s ease-in-out infinite;
			}
			
			.particle:nth-child(1) {
				width: 12px;
				height: 12px;
				top: 5%;
				left: 15%;
				animation-delay: 0s;
			}
			.particle:nth-child(2) {
				width: 8px;
				height: 8px;
				bottom: 10%;
				right: 10%;
				animation-delay: 1s;
			}
			.particle:nth-child(3) {
				width: 10px;
				height: 10px;
				top: 20%;
				right: 5%;
				animation-delay: 2s;
			}
			.particle:nth-child(4) {
				width: 6px;
				height: 6px;
				bottom: 25%;
				left: 5%;
				animation-delay: 0.5s;
			}
			.particle:nth-child(5) {
				width: 14px;
				height: 14px;
				top: 50%;
				left: -5%;
				animation-delay: 1.5s;
			}
			.particle:nth-child(6) {
				width: 7px;
				height: 7px;
				top: 60%;
				right: -5%;
				animation-delay: 2.5s;
			}
			
			@keyframes float {
				0%, 100% { transform: translateY(0px) scale(1); opacity: 0.6; }
				50% { transform: translateY(-15px) scale(1.2); opacity: 1; }
			}
			
			/* نص العلامة التجارية أسفل اللودر */
			.brand-text {
				position: relative;
				z-index: 2;
				color: #21636d;
				font-size: 13px;
				font-weight: 300;
				letter-spacing: 3px;
				opacity: 0;
				animation: fadeInText 1.5s ease-in-out 0.5s forwards;
			}
			
			@keyframes fadeInText {
				from { opacity: 0; transform: translateY(10px); }
				to { opacity: 0.7; transform: translateY(0); }
			}
			
			/* توهج الخلفية */
			.glow-bg {
				position: absolute;
				width: 100%;
				height: 100%;
				background: radial-gradient(circle, rgba(33, 99, 109, 0.08) 0%, transparent 70%);
				border-radius: 50%;
				z-index: 0;
				animation: glowPulse 3s ease-in-out infinite;
			}
			
			@keyframes glowPulse {
				0%, 100% { transform: scale(1); opacity: 0.5; }
				50% { transform: scale(1.1); opacity: 1; }
			}
		</style>
		
		<div class="loader-init" id="page-loader">
			<div class="loader-container">
				<div class="glow-bg"></div>
				
				<div class="particles">
					<div class="particle"></div>
					<div class="particle"></div>
					<div class="particle"></div>
					<div class="particle"></div>
					<div class="particle"></div>
					<div class="particle"></div>
				</div>
				
				<div class="logo-wrapper">
					{% if theme.settings.get('change_loder') %}
						{% if theme.settings.get('custom_loader_image') %}
							<img src="{{ theme.settings.get('custom_loader_image') }}" alt="{{ store.name }}" />
						{% else %}
							{% if store.logo %}
								<img src="{{ store.logo }}" alt="{{ store.name }}" />
							{% endif %}
						{% endif %}
					{% else %}
						{% if store.logo %}
							<img src="{{ store.logo }}" alt="{{ store.name }}" />
						{% endif %}
					{% endif %}
				</div>
				
				<div class="brand-text">✨ العناية ببشرتك تبدأ من هنا ✨</div>
			</div>
		</div>
		
	{% elseif theme.settings.get('loader_type') == 'custom_loader' %}
		<style>
			.loader-init {
				position: fixed;
				inset: 0;
				width: 100vw;
				height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				background: linear-gradient(135deg, #f8f4f0 0%, #ffffff 50%, #f8f4f0 100%);
				z-index: 999999;
				transition: opacity 0.8s ease, visibility 0.8s ease;
			}
			
			.skincare-loader {
				position: relative;
				width: 220px;
				height: 220px;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
			}
			
			/* زهرة اللوتس - رمز الجمال والعناية */
			.lotus-flower {
				position: relative;
				width: 180px;
				height: 180px;
				animation: lotusFloat 4s ease-in-out infinite;
			}
			
			.lotus-petal {
				position: absolute;
				bottom: 0;
				left: 50%;
				transform-origin: bottom center;
				width: 40px;
				height: 70px;
				border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
				background: linear-gradient(to top, #e8a87c, #f57328);
				opacity: 0;
				transform: translateX(-50%) rotate(0deg);
				animation: petalGrow 3s ease-in-out infinite;
			}
			
			.lotus-petal:nth-child(1) { transform: translateX(-50%) rotate(0deg); animation-delay: 0s; }
			.lotus-petal:nth-child(2) { transform: translateX(-50%) rotate(45deg); animation-delay: 0.2s; }
			.lotus-petal:nth-child(3) { transform: translateX(-50%) rotate(90deg); animation-delay: 0.4s; }
			.lotus-petal:nth-child(4) { transform: translateX(-50%) rotate(135deg); animation-delay: 0.6s; }
			.lotus-petal:nth-child(5) { transform: translateX(-50%) rotate(180deg); animation-delay: 0.8s; }
			.lotus-petal:nth-child(6) { transform: translateX(-50%) rotate(225deg); animation-delay: 1s; }
			.lotus-petal:nth-child(7) { transform: translateX(-50%) rotate(270deg); animation-delay: 1.2s; }
			.lotus-petal:nth-child(8) { transform: translateX(-50%) rotate(315deg); animation-delay: 1.4s; }
			
			/* الطبقة الداخلية من البتلات */
			.lotus-petal-inner {
				position: absolute;
				bottom: 15px;
				left: 50%;
				transform-origin: bottom center;
				width: 25px;
				height: 45px;
				border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
				background: linear-gradient(to top, #f5cba7, #f57328);
				opacity: 0;
				transform: translateX(-50%) rotate(0deg);
				animation: petalGrow 3s ease-in-out infinite;
				animation-delay: 1.6s;
			}
			
			.lotus-petal-inner:nth-child(9) { transform: translateX(-50%) rotate(0deg); animation-delay: 1.6s; }
			.lotus-petal-inner:nth-child(10) { transform: translateX(-50%) rotate(60deg); animation-delay: 1.8s; }
			.lotus-petal-inner:nth-child(11) { transform: translateX(-50%) rotate(120deg); animation-delay: 2s; }
			.lotus-petal-inner:nth-child(12) { transform: translateX(-50%) rotate(180deg); animation-delay: 2.2s; }
			.lotus-petal-inner:nth-child(13) { transform: translateX(-50%) rotate(240deg); animation-delay: 2.4s; }
			.lotus-petal-inner:nth-child(14) { transform: translateX(-50%) rotate(300deg); animation-delay: 2.6s; }
			
			@keyframes petalGrow {
				0%, 100% { opacity: 0; transform: translateX(-50%) rotate(var(--rotation, 0deg)) scale(0.8); }
				20% { opacity: 1; transform: translateX(-50%) rotate(var(--rotation, 0deg)) scale(1); }
				80% { opacity: 1; transform: translateX(-50%) rotate(var(--rotation, 0deg)) scale(1); }
			}
			
			@keyframes lotusFloat {
				0%, 100% { transform: translateY(0px) rotate(-2deg); }
				50% { transform: translateY(-10px) rotate(2deg); }
			}
			
			/* مركز الزهرة */
			.lotus-center {
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				width: 30px;
				height: 30px;
				background: radial-gradient(circle, #f5cba7, #e8a87c);
				border-radius: 50%;
				z-index: 5;
				box-shadow: 0 0 30px rgba(245, 115, 40, 0.3);
				animation: centerPulse 2s ease-in-out infinite;
			}
			
			@keyframes centerPulse {
				0%, 100% { transform: translate(-50%, -50%) scale(1); }
				50% { transform: translate(-50%, -50%) scale(1.1); }
			}
			
			/* قطرات الماء المتلألئة */
			.water-droplets {
				position: absolute;
				width: 100%;
				height: 100%;
				top: 0;
				left: 0;
				z-index: 10;
				pointer-events: none;
			}
			
			.droplet {
				position: absolute;
				width: 8px;
				height: 12px;
				background: linear-gradient(to bottom, rgba(33, 99, 109, 0.6), rgba(33, 99, 109, 0.1));
				border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
				animation: dropletFall 4s ease-in-out infinite;
				opacity: 0;
			}
			
			.droplet:nth-child(1) { top: 5%; left: 20%; animation-delay: 0s; }
			.droplet:nth-child(2) { top: 10%; right: 15%; animation-delay: 1s; }
			.droplet:nth-child(3) { bottom: 15%; left: 10%; animation-delay: 2s; }
			.droplet:nth-child(4) { bottom: 5%; right: 20%; animation-delay: 3s; }
			.droplet:nth-child(5) { top: 30%; left: 0%; animation-delay: 0.5s; }
			.droplet:nth-child(6) { top: 25%; right: 0%; animation-delay: 1.5s; }
			.droplet:nth-child(7) { bottom: 30%; left: 0%; animation-delay: 2.5s; }
			.droplet:nth-child(8) { bottom: 25%; right: 0%; animation-delay: 3.5s; }
			
			@keyframes dropletFall {
				0% { transform: translateY(-20px) rotate(0deg); opacity: 0; }
				20% { opacity: 1; }
				80% { opacity: 1; }
				100% { transform: translateY(30px) rotate(180deg); opacity: 0; }
			}
			
			/* النص المتحرك */
			.loader-text {
				margin-top: 25px;
				font-size: 16px;
				font-weight: 300;
				letter-spacing: 2px;
				color: #21636d;
				position: relative;
				z-index: 15;
				animation: textGlow 2s ease-in-out infinite;
			}
			
			.loader-text span {
				display: inline-block;
				animation: textLetter 3s ease-in-out infinite;
			}
			
			@keyframes textGlow {
				0%, 100% { opacity: 0.6; }
				50% { opacity: 1; }
			}
			
			@keyframes textLetter {
				0%, 100% { transform: translateY(0); }
				50% { transform: translateY(-3px); }
			}
			
			/* نقاط التحميل */
			.loading-dots {
				display: flex;
				gap: 8px;
				margin-top: 5px;
				position: relative;
				z-index: 15;
			}
			
			.loading-dot {
				width: 8px;
				height: 8px;
				background: #21636d;
				border-radius: 50%;
				animation: dotBounce 1.5s ease-in-out infinite;
			}
			
			.loading-dot:nth-child(1) { animation-delay: 0s; }
			.loading-dot:nth-child(2) { animation-delay: 0.3s; }
			.loading-dot:nth-child(3) { animation-delay: 0.6s; }
			
			@keyframes dotBounce {
				0%, 80%, 100% { transform: scale(0.6); opacity: 0.3; }
				40% { transform: scale(1); opacity: 1; }
			}
		</style>
		
		<div class="loader-init" id="page-loader">
			<div class="skincare-loader">
				<div class="water-droplets">
					<div class="droplet"></div>
					<div class="droplet"></div>
					<div class="droplet"></div>
					<div class="droplet"></div>
					<div class="droplet"></div>
					<div class="droplet"></div>
					<div class="droplet"></div>
					<div class="droplet"></div>
				</div>
				
				<div class="lotus-flower">
					<!-- البتلات الخارجية -->
					<div class="lotus-petal"></div>
					<div class="lotus-petal"></div>
					<div class="lotus-petal"></div>
					<div class="lotus-petal"></div>
					<div class="lotus-petal"></div>
					<div class="lotus-petal"></div>
					<div class="lotus-petal"></div>
					<div class="lotus-petal"></div>
					
					<!-- البتلات الداخلية -->
					<div class="lotus-petal-inner"></div>
					<div class="lotus-petal-inner"></div>
					<div class="lotus-petal-inner"></div>
					<div class="lotus-petal-inner"></div>
					<div class="lotus-petal-inner"></div>
					<div class="lotus-petal-inner"></div>
					
					<!-- مركز الزهرة -->
					<div class="lotus-center"></div>
				</div>
				
				<div class="loader-text">
					{% for letter in store.name|split('') %}
						<span>{{ letter }}</span>
					{% endfor %}
				</div>
				
				<div class="loading-dots">
					<div class="loading-dot"></div>
					<div class="loading-dot"></div>
					<div class="loading-dot"></div>
				</div>
			</div>
		</div>
		
	{% else %}
		<style>
			.loader-init {
				position: fixed;
				top: 0;
				left: 0;
				width: 100vw;
				height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				background: white;
				transition: opacity 0.75s, visibility 0.75s;
				z-index: 9999;
			}
			.loader-init--hidden {
				opacity: 0;
				visibility: hidden;
			}
			.loader-init::after {
				content: "";
				width: 36px;
				height: 36px;
				border: 3px solid #eee;
				border-top-color: var(--color-primary);
				border-radius: 50%;
				animation: loading 0.75s ease infinite;
			}
			@keyframes loading {
				from {
					transform: rotate(0turn);
				}
				to {
					transform: rotate(1turn);
				}
			}
		</style>
		
		<div class="loader-init" id="page-loader"></div>
	{% endif %}

	<script>
		window.addEventListener("load", () => {
			const loader = document.getElementById("page-loader");
			if (loader) {
				loader.style.opacity = '0';
				loader.style.visibility = 'hidden';
				loader.addEventListener("transitionend", () => {
					if (loader.parentNode) {
						loader.parentNode.removeChild(loader);
					}
				});
			}
		});
	</script>
{% endif %}