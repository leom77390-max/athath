{#
| Variable                                          | Type                | Description                                                    |
|---------------------------------------------------|---------------------|----------------------------------------------------------------|
| page                                              | object              |                                                                |
| page.title                                        | string              |                                                                |
| page.slug                                         | string              |                                                                |
| cart                                              | Cart                |                                                                |
| cart.id                                           | string              | Unique string for current cart                                 |
| cart.is_require_shipping                          | bool                | Does one of cart items require shipping?                       |
| cart.has_shipping                                 | bool                | Does shipping company selected?                                |
| cart.real_shipping_cost                           | float               | Shipping cost can become free by an offer, coupon              |
| cart.sub_total                                    | float               | The sum of items price without shipping or other costs         |
| cart.discount                                     | float               | final discount                                                 |
| cart.coupon                                       | ?string             |                                                                |
| cart.total                                        | float               |                                                                |
| cart.tax_amount                                   | float               | Calculate Tax amount                                                               |
| cart.free_shipping_bar                            | ?object             |                                                                |
| cart.free_shipping_bar.minimum_amount             | float               | how much cart total should be to apply free shipping ex: 1000  |
| cart.free_shipping_bar.has_free_shipping          | bool                | true when `cart.free_shipping_bar.percent==100`                |
| cart.free_shipping_bar.percent                    | float               | `0 - 100`                                                      |
| cart.free_shipping_bar.remaining                  | float               | `830`                                                          |
| cart.items                                        | CartItem[]          |                                                                |
| cart.options                                      | CartOptions[]       | array of options                                               |
| cart.items[].id                                   | int                 |                                                                |
| cart.items[].is_hidden_quantity                   | bool                |                                                                |
| cart.items[].url                                  | string              | Product url                                                    |
| cart.items[].quantity                             | int                 |                                                                |
| cart.items[].type                                 | string              | product type                                                   |
| cart.items[].product_price                        | MoneyTaxable        |                                                                |
| cart.items[].price                                | Money\|MoneyTaxable |                                                                |
| cart.items[].total                                | Money               |                                                                |
| cart.items[].product_id                           | int                 |                                                                |
| cart.items[].notes                                | string              |                                                                |
| cart.items[].can_add_note                         | bool                |                                                                |
| cart.items[].can_upload_file                      | bool                |                                                                |
| cart.items[].is_available                         | bool                |                                                                |
| cart.items[].offer                                | ?object             |                                                                |
| cart.items[].offer.discount                       | float               |                                                                |
| cart.items[].offer.is_free                        | bool                |                                                                |
| cart.items[].offer.names                          | ?string             | ex: `Buy 3 and the 4th on us, National Day`                    |
| cart.items[].donation                             | ?object             |                                                                |
| cart.items[].attachments                          | ?array              |                                                                |
| cart.items[].attachments[].id                     | int                 | image id, to be attache with the formData                      |
| cart.items[].attachments[].url                    | string              | image url                                                      |
| cart.items[].attachments[].product_id             | int                 |                                                                |
| cart.items[].attachments[].item_id                | int                 |                                                                |
| cart.items[].attachments[].name                   | int                 | image file name                                                |
#}

{% extends "layouts.master" %}
{% block content %}
<style>
    /* ===== Cart Page Styles ===== */
    .cart-page-wrapper {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 20px 80px;
    }

    /* Title */
    .cart-page-title {
        text-align: center;
        font-size: 2rem;
        font-weight: 700;
        color: #111;
        margin-bottom: 12px;
    }

    /* Free Shipping Progress Bar (top, centered) */
    .cart-top-free-shipping {
        text-align: center;
        margin-bottom: 32px;
    }
    .cart-top-free-shipping p {
        font-size: 0.85rem;
        color: #555;
        margin-bottom: 6px;
    }
    .cart-top-free-shipping p strong {
        color: #111;
    }
    .cart-top-shipping-bar-track {
        max-width: 420px;
        margin: 0 auto;
        height: 5px;
        background: #e5e7eb;
        border-radius: 999px;
        overflow: hidden;
    }
    .cart-top-shipping-bar-fill {
        height: 100%;
        background: #111;
        border-radius: 999px;
        transition: width 0.5s;
    }

    /* Table Layout */
    .cart-table-layout {
        display: flex;
        gap: 48px;
        align-items: flex-start;
    }

    /* Left: Items Table */
    .cart-items-table {
        flex: 1;
        min-width: 0;
    }

    /* Table Header Row */
    .cart-table-header {
        display: grid;
        grid-template-columns: 1fr 120px 160px 100px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 4px;
    }
    .cart-table-header span {
        font-size: 0.78rem;
        font-weight: 600;
        color: #555;
        text-transform: capitalize;
        letter-spacing: 0.02em;
    }
    .cart-table-header .col-price,
    .cart-table-header .col-qty,
    .cart-table-header .col-total {
        text-align: center;
    }

    /* Each Item Row */
    .cart-item-row {
        display: grid;
        grid-template-columns: 1fr 120px 160px 100px;
        align-items: center;
        padding: 20px 0;
        border-bottom: 1px solid #e5e7eb;
        position: relative;
    }

    /* Product Cell */
    .cart-item-product {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .cart-item-img {
        width: 72px;
        height: 72px;
        object-fit: cover;
        object-position: center;
        border-radius: 6px;
        border: 1px solid #e5e7eb;
        background: #f3f4f6;
        flex-shrink: 0;
    }
    .cart-item-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .cart-item-name {
        font-size: 0.95rem;
        font-weight: 500;
        color: #111;
        line-height: 1.4;
        text-decoration: none;
    }
    .cart-item-name:hover { text-decoration: underline; }
    .cart-item-variant {
        font-size: 0.8rem;
        color: #888;
    }
    .cart-item-remove {
        font-size: 0.78rem;
        color: #555;
        text-decoration: underline;
        cursor: pointer;
        background: none;
        border: none;
        padding: 0;
        display: inline-block;
        margin-top: 2px;
    }
    .cart-item-remove:hover { color: #e53e3e; }

    /* Free ribbon */
    .free-ribbon {
        position: absolute;
        top: 11px;
        right: -38px;
        width: 128px;
        background: #dc2626;
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        text-align: center;
        padding: 2px 0;
        transform: rotate(45deg);
        box-shadow: 0 1px 4px rgba(0,0,0,0.15);
    }

    /* Price / Total cells */
    .cart-item-price,
    .cart-item-total {
        text-align: center;
        font-size: 0.95rem;
        color: #111;
        font-weight: 500;
    }
    .cart-item-price .line-through {
        text-decoration: line-through;
        color: #aaa;
        font-size: 0.8rem;
        display: block;
    }
    .cart-item-total {
        font-weight: 600;
        color: #e05c00;
    }

    /* Quantity cell */
    .cart-item-qty {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Offer & weight lines */
    .item-offer-name {
        font-size: 0.78rem;
        color: #888;
        margin-top: 2px;
    }

    /* Empty Cart */
    .no-content-placeholder {
        text-align: center;
        padding: 80px 20px;
        color: #888;
    }
    .no-content-placeholder .icon {
        font-size: 3rem;
        display: block;
        margin-bottom: 16px;
        color: #ccc;
    }
    .no-content-placeholder p {
        font-size: 1rem;
        margin-bottom: 20px;
    }

    /* Cart Options section */
    .cart-options {
        margin-top: 16px;
    }

    /* ===== Right Sidebar (Summary) ===== */
    .cart-sidebar {
        width: 320px;
        flex-shrink: 0;
        position: sticky;
        top: 88px;
    }

    /* Gift wrapping checkbox row */
    .cart-extra-options {
        margin-bottom: 12px;
    }
    .cart-gift-wrap-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.82rem;
        color: #555;
        cursor: pointer;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: 10px 14px;
        margin-bottom: 8px;
    }
    .cart-gift-wrap-label input[type="checkbox"] {
        accent-color: #111;
        width: 14px;
        height: 14px;
    }
    .cart-gift-wrap-label a {
        color: #e05c00;
        text-decoration: underline;
    }

    /* Order note & Estimate Shipping accordions */
    .cart-accordion {
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        overflow: hidden;
        margin-bottom: 8px;
    }
    .cart-accordion-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 11px 14px;
        font-size: 0.85rem;
        color: #333;
        cursor: pointer;
        user-select: none;
        background: #fff;
    }
    .cart-accordion-header .acc-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .cart-accordion-header i {
        color: #888;
        font-size: 1rem;
    }
    .cart-accordion-chevron {
        font-size: 0.7rem;
        color: #aaa;
        transition: transform 0.2s;
    }

    /* Summary Box */
    .cart-summary-box {
        margin-top: 24px;
    }
    .cart-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.88rem;
        color: #555;
        margin-bottom: 4px;
    }
    .cart-summary-row b {
        color: #111;
        font-weight: 600;
    }
    .cart-summary-total-row {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-top: 14px;
        margin-bottom: 4px;
    }
    .cart-summary-total-label {
        font-size: 1rem;
        font-weight: 600;
        color: #111;
    }
    .cart-summary-total-value {
        font-size: 1.15rem;
        font-weight: 700;
        color: #111;
    }
    .cart-summary-tax-note {
        font-size: 0.75rem;
        color: #888;
        margin-bottom: 16px;
    }
    .cart-summary-tax-note a {
        color: #888;
        text-decoration: underline;
    }

    /* Checkout Button */
    .cart-checkout-btn {
        display: block;
        width: 100%;
        background: #111;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 14px;
        font-size: 1rem;
        font-weight: 600;
        text-align: center;
        cursor: pointer;
        transition: background 0.2s;
    }
    .cart-checkout-btn:hover { background: #333; }

    /* Coupon inside summary */
    .cart-coupon-row {
        padding: 10px 0;
        border-top: 1px solid #f0f0f0;
        border-bottom: 1px solid #f0f0f0;
        margin: 8px 0;
    }

    /* Loyalty panel spacing */
    salla-loyalty-panel { display: block; margin-bottom: 8px; }
    salla-tiered-offer  { display: block; margin-top: 16px; }
    salla-offer         { display: block; margin-top: 8px; }
</style>

<div class="cart-page-wrapper">
    <nav class="breadcrumbs w-full py-5" style="display:none;">
        <salla-breadcrumb></salla-breadcrumb>
    </nav>
    <h1 class="cart-page-title">{{ trans('blocks.header.cart') }}</h1>

    {# â”€â”€ Free Shipping Progress Bar (top, centered) â”€â”€ #}
    {% if cart.free_shipping_bar %}
    <div class="cart-top-free-shipping" id="free-shipping-top">
        {% set is_free = cart.free_shipping_bar.has_free_shipping %}
        <p id="free-shipping-msg-top">
            {% if is_free %}
                {{ trans('blocks.cart.has_free_shipping') | raw }} ðŸŽ‰
            {% else %}
                {{ trans('blocks.cart.free_shipping_alert', {'amount': cart.free_shipping_bar.remaining|money}) | raw }}
            {% endif %}
        </p>
        {% if not is_free %}
        <div class="cart-top-shipping-bar-track">
            <div class="cart-top-shipping-bar-fill" style="width:{{ cart.free_shipping_bar.percent }}%"></div>
        </div>
        {% endif %}
    </div>
    {% endif %}

    <salla-conditional-offer></salla-conditional-offer>

    <div class="cart-table-layout">

        {# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
           LEFT â€” Items Table
        â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• #}
        <div class="cart-items-table">

            {% hook 'cart:items.start' %}

            {% if cart.items|length %}
            {# Table Header #}
            <div class="cart-table-header">
                <span class="col-product">{{ trans('blocks.cart.product') }}</span>
                <span class="col-price">{{ trans('blocks.cart.price') }}</span>
                <span class="col-qty">{{ trans('blocks.cart.quantity') }}</span>
                <span class="col-total">{{ trans('blocks.cart.total') }}</span>
            </div>
            {% endif %}

            {% for item in cart.items %}
                <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ item.id }}">
                    <input type="hidden" name="id" value="{{ item.id }}">

                    <div class="cart-item-row">

                        {# â”€â”€ Product Cell â”€â”€ #}
                        <div class="cart-item-product">
                            <a href="{{ item.url }}" class="relative overflow-hidden shrink-0" style="position:relative;">
                                {% if loop.first %}
                                    <img src="{{ item.product_image }}"
                                         alt="{{ item.product_name }}"
                                         loading="eager"
                                         class="cart-item-img">
                                {% else %}
                                    <img src="{{ item.product_image }}"
                                         alt="{{ item.product_name }}"
                                         loading="lazy"
                                         class="cart-item-img">
                                {% endif %}

                                {# Free ribbon #}
                                <div class="free-ribbon {{ (item.price.getMoney().amount == 0 and item.has_discount) ? '' : 'hidden' }}">
                                    {{ trans('pages.loyalty_program.free_product') }}
                                </div>
                            </a>

                            <div class="cart-item-info">
                                <a href="{{ item.url }}" class="cart-item-name">{{ item.product_name }}</a>

                                {# Variant / options label if any #}
                                {% if item.options is defined and item.options|length %}
                                    <span class="cart-item-variant">
                                        {% for opt in item.options %}{{ opt.name }}: {{ opt.value }}{% if not loop.last %}, {% endif %}{% endfor %}
                                    </span>
                                {% endif %}

                                {# Weight #}
                                <p class="cart-item-variant item-weight-row {{ item.weight_label ? '' : 'hidden' }}">
                                    {{ trans('pages.products.weight') }}: <span class="item-weight">{{ item.weight_label }}</span>
                                </p>

                                {# Offer name #}
                                <span class="old-offers item-offer-name {{ item.detailed_offers ? 'hidden' : '' }}">
                                    <i class="sicon-discount-calculator {{ item.offer ? '' : 'hidden' }}"></i>
                                    <span class="offer-name {{ item.offer ? '' : 'hidden' }}">{{ item.offer.names }}</span>
                                </span>

                                {# Cart Item Offers component #}
                                <salla-cart-item-offers
                                    quantity="{{ item.quantity }}"
                                    item-id="{{ item.id }}"
                                    product-price="{{ item.product_price }}"
                                    offers="{{ item.detailed_offers|json_encode }}">
                                </salla-cart-item-offers>

                                {# Remove button #}
                                <button type="button"
                                        class="cart-item-remove"
                                        aria-label="Remove from the cart"
                                        onclick="salla.cart.deleteItem('{{ item.id }}').then(() => document.querySelector('#item-{{ item.id }}').closest('.cart-item-row').remove())">
                                    {{ trans('blocks.cart.remove') }}
                                </button>
                            </div>
                        </div>

                        {# â”€â”€ Price Cell â”€â”€ #}
                        <div class="cart-item-price">
                            <span class="line-through item-regular-price {{ item.offer ? '' : 'hidden' }}">{{ item.product_price|money }}</span>
                            <span class="inline-flex gap-1 line-through item-original-price {{ item.is_on_sale ? '' : 'hidden' }}">{{ item.original_price|money }}</span>
                            <span class="item-price {{ item.has_discount ? 'text-red-800' : '' }}">{{ item.price|money }}</span>
                        </div>

                        {# â”€â”€ Quantity Cell â”€â”€ #}
                        <div class="cart-item-qty">
                            {% if item.type == 'donating' %}
                                <span></span>
                            {% elseif item.is_hidden_quantity %}
                                <input type="hidden" value="{{ item.quantity }}" name="quantity" aria-label="Quantity"/>
                                <span class="w-10 text-center">{{ item.quantity }}</span>
                            {% else %}
                                <salla-quantity-input
                                    cart-item-id="{{ item.id }}"
                                    max="{{ item.max_quantity }}"
                                    class="transtion transition-color duration-300"
                                    aria-label="Quantity"
                                    value="{{ item.quantity }}"
                                    name="quantity">
                                </salla-quantity-input>
                            {% endif %}
                        </div>

                        {# â”€â”€ Total Cell â”€â”€ #}
                        <div class="cart-item-total">
                            {% set item_total = item.detailed_offers|length > 0 ? item.total_special_price|money : item.total|money %}
                            <span class="item-total">{{ item.is_available ? item_total : trans('blocks.cart.out_of_stock') }}</span>
                        </div>

                    </div>{# end cart-item-row #}

                    {% include 'pages.partials.product.options' with {product: item} %}

                </form>
            {% else %}
                <div class="no-content-placeholder">
                    <i class="sicon-shopping-bag icon"></i>
                    <p>{{ trans('blocks.cart.empty_cart') }}</p>
                    <a href="{{ link('/') }}" class="btn btn--outline-primary btn--rounded-full">
                        {{ trans('common.elements.back_home') }}
                    </a>
                </div>
            {% endfor %}

            {# Cart Options #}
            {% if cart.options|length %}
                <div class="cart-options">
                    {% for product_option in cart.options %}
                        <form class="first:pt-5 relative"
                              onchange="salla.form.onChange('cart.updateItem', event)"
                              id="item-{{ product_option.id }}">
                            <input type="hidden" name="id" value="{{ product_option.id }}">
                            <input type="hidden" name="quantity" value="{{ product_option.quantity }}">
                            {% include 'pages.partials.product.options' with { product: product_option } %}
                        </form>
                    {% endfor %}
                </div>
            {% endif %}

            <salla-offer></salla-offer>

            {% hook 'cart:items.end' %}
        </div>{# end cart-items-table #}

        {% hook 'cart:summary.start' %}

        {# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
           RIGHT â€” Sidebar Summary
        â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• #}
        {% if cart.items|length %}
        <div class="cart-sidebar">

            {# Loyalty #}
            {% if loyalty %}
                <salla-loyalty-panel
                    prize-points='{{ loyalty.prize.points }}'
                    prize-title='{{ loyalty.prize.title }}'>
                </salla-loyalty-panel>
            {% endif %}

            {# Gifting widget #}
            <div id="cart-gifting" class="mb-2 {{ gift.enabled ? '' : 'hidden' }}">
                <salla-gifting id="salla-gifting"
                    widget-title="{{ trans('blocks.cart.gift_widget_title') }}"
                    widget-subtitle="{{ gift.text }}"
                    {{ gift.type }}-products vertical>
                </salla-gifting>
            </div>

            {# â”€â”€ Extra Options: Gift wrap + Order note + Estimate Shipping â”€â”€ #}
            <div class="cart-extra-options">

                {# Gift Wrap Checkbox â€” shown when available #}
                <label class="cart-gift-wrap-label">
                    <input type="checkbox" name="gift_wrap" value="1">
                    {{ trans('blocks.cart.gift_wrap_label') }}
                    <a href="#">{{ trans('blocks.cart.gift_wrap_subtitle') }}</a>
                </label>

                {# Order Note Accordion #}
                <div class="cart-accordion">
                    <div class="cart-accordion-header">
                        <span class="acc-left">
                            <i class="sicon-edit"></i>
                            {{ trans('blocks.cart.order_note') }}
                        </span>
                        <i class="sicon-arrow-down cart-accordion-chevron"></i>
                    </div>
                </div>

                {# Estimate Shipping Accordion #}
                <div class="cart-accordion">
                    <div class="cart-accordion-header">
                        <span class="acc-left">
                            <i class="sicon-clock"></i>
                            {{ trans('blocks.cart.estimate_shipping') }}
                        </span>
                        <i class="sicon-arrow-down cart-accordion-chevron"></i>
                    </div>
                </div>

            </div>{# end cart-extra-options #}

            {# â”€â”€ Summary totals â”€â”€ #}
            <div class="cart-summary-box">

                {# Subtotal #}
                <div class="cart-summary-row">
                    <span>{{ trans(cart.tax_amount ? 'blocks.cart.items_total_without_tax' : 'blocks.cart.items_total') }}</span>
                    <b id="sub-total">{{ cart.sub_total|money }}</b>
                </div>

                {# Options total #}
                {% if cart.options|length %}
                    <div class="cart-summary-row">
                        <span>{{ trans('blocks.cart.order_options_total') }}</span>
                        <b id="cart-options-total">{{ cart.options_total|money }}</b>
                    </div>
                {% endif %}

                {# Shipping cost #}
                <div id="shipping-cost" class="cart-summary-row {{ cart.has_shipping ? '' : 'hidden' }}">
                    <span>{{ trans('blocks.cart.shipping_cost') }}</span>
                    <b>{{ cart.real_shipping_cost|money }}</b>
                </div>

                {# Coupon #}
                {% if store.settings.cart.apply_coupon_enabled %}
                    <div class="cart-coupon-row">
                        <salla-cart-coupons></salla-cart-coupons>
                    </div>
                {% endif %}

                {# Discount #}
                <div id="total-discount" class="cart-summary-row {{ cart.total_discount ? '' : 'hidden' }}">
                    <span>{{ trans('blocks.cart.total_discount') }}</span>
                    <b>- {{ cart.total_discount|money }}</b>
                </div>

                {# VAT #}
                {% if cart.tax_amount %}
                    <div class="cart-summary-row">
                        <span>{{ trans('blocks.cart.VAT_tax_amount') }}</span>
                        <b id="tax-amount">{{ cart.tax_amount|money }}</b>
                    </div>
                {% endif %}

                {# â”€â”€ Estimated Total â”€â”€ #}
                <div class="cart-summary-total-row">
                    <span class="cart-summary-total-label">{{ trans('blocks.cart.final_total') ?? 'Estimated total' }}</span>
                    <span class="cart-summary-total-value" data-cart-total>{{ cart.total|money }}</span>
                </div>
                <p class="cart-summary-tax-note">
                    {{ trans('blocks.cart.taxes_shipping_note') }}
                    <a href="#">{{ trans('blocks.cart.shipping') }}</a>
                    {{ trans('blocks.cart.calculated_at_checkout') }}
                </p>

                {# â”€â”€ Checkout Button â”€â”€ #}
                <div class="cart-submit-wrap">
                    {% hook 'cart:submit.start' %}
                    <salla-button id="cart-submit" loader-position="center" width="wide" class="cart-checkout-btn">
                        {{ trans('blocks.cart.complete_order') }}
                    </salla-button>
                    {% hook 'cart:submit.end' %}
                </div>

                {% hook 'cart:summary.end' %}
            </div>

            {# Tiered Offer #}
            <salla-tiered-offer></salla-tiered-offer>

        </div>{# end cart-sidebar #}
        {% endif %}

    </div>{# end cart-table-layout #}
</div>{# end cart-page-wrapper #}
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'checkout.js' | asset }}"></script>
{% endblock %}
