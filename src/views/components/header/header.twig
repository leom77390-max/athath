						<a class="mburger mburger--collapse leading-none justify-start items-center gap-2 lg:!hidden !flex" href="#mobile-menu" aria-label="Open-menu">
							<p class="flex flex-col gap-1 items-start group ltr:scale-x-[-1]">
								<span class="w-5 h-[2px] bg-background rounded-lg"></span>
