												</g>
												</svg>
										</button>
								
							</div>
							<span class="text-sm font-medium hidden lg:inline">{{ trans('blocks.header.language') }}</span>
						</div>
						{% endif %}
						

						{# Cart Button #}
						<div class="flex flex-col items-center gap-1.5 lg:px-2 lg:min-w-16">
						{% if theme.settings.get('enable_side_cart') %}
							<button id="sidecart-button" class="custom-button flex flex-col items-center gap-2 relative">
								<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 20 20" fill="none">
									<path d="M7.00002 5.41667H13C15.8334 5.41667 16.1167 6.74167 16.3084 8.35834L17.0584 14.6083C17.3 16.6583 16.6667 18.3333 13.75 18.3333H6.25835C3.33335 18.3333 2.70002 16.6583 2.95002 14.6083L3.70003 8.35834C3.88336 6.74167 4.16669 5.41667 7.00002 5.41667Z" stroke-width="1.4375" stroke-linecap="round" stroke-linejoin="round"/>
									<path d="M6.66669 6.66666V3.75C6.66669 2.5 7.50002 1.66666 8.75002 1.66666H11.25C12.5 1.66666 13.3334 2.5 13.3334 3.75V6.66666" stroke-width="1.4375" stroke-linecap="round" stroke-linejoin="round"/>
									<path d="M17.0084 14.1917H6.66669" stroke-width="1.4375" stroke-linecap="round" stroke-linejoin="round"/>
								</svg>
								<span class="cart-total-items bg-red-500 absolute top-[-0.75rem] right-2 text-background text-xxs rounded-full w-[18px] h-[18px] !flex items-center justify-center select-none" title="{{ trans('pages.cart.items_count') }}">{{ cart.items_count }}</span>
								<span class="text-sm font-medium hidden lg:inline">{{ trans('blocks.header.cart') }}</span>
							</button>
						{% else %}
							<a class="relative flex items-center !min-h-fit !min-w-fit" href="{{ store.url }}/cart">
								<salla-cart-summary class="custom-cart-summary">
									<svg xmlns="http://www.w3.org/2000/svg" width="22" height="21" viewbox="0 0 22 21" fill="none">
										<path d="M6.05624 9.60579V5.05289C6.05624 3.84539 6.53593 2.68734 7.38977 1.83351C8.24361 0.979678 9.40167 0.5 10.6092 0.5C11.8167 0.5 12.9748 0.979678 13.8286 1.83351C14.6824 2.68734 15.1621 3.84539 15.1621 5.05289V9.60579"  stroke-linecap="round"/>
										<path d="M1.15492 10.3663C1.31997 8.38468 1.40306 7.39442 2.0564 6.7923C2.70975 6.19018 3.70457 6.19132 5.69307 6.19132H15.5263C17.5136 6.19132 18.5085 6.19132 19.1618 6.7923C19.8152 7.39328 19.8982 8.38468 20.0633 10.3663L20.6483 17.3846C20.744 18.5376 20.7918 19.1147 20.4548 19.4824C20.1156 19.85 19.5374 19.85 18.3787 19.85H2.83951C1.68193 19.85 1.10256 19.85 0.764508 19.4824C0.426452 19.1147 0.474258 18.5376 0.571008 17.3846L1.15492 10.3663Z" />
									</svg>
								</salla-cart-summary>
							</a>
							<span class="text-sm font-medium hidden lg:inline">{{ trans('blocks.header.cart') }}</span>
							</a>
						{% endif %}
						</div>
						{% if below_logo_menu %}
												{# Wishlist #}
						<div class="flex-col items-center gap-1.5 hidden lg:flex lg:min-w-16">
							<div class="flex items-center justify-center button-style relative">
								<a class="absolute block h-full w-full" href="{{ store.url }}/wishlist"></a>
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="21" viewbox="0 0 24 21" fill="none">
									<path d="M2.4883 11.4753L10.9196 19.3948C11.2106 19.6677 11.3561 19.8047 11.5259 19.8387C11.6031 19.8539 11.6826 19.8539 11.7599 19.8387C11.9321 19.8047 12.0764 19.6689 12.3662 19.3948L20.7975 11.4765C21.9427 10.4013 22.6455 8.9375 22.7687 7.37148C22.8918 5.80546 22.4263 4.24984 21.4632 3.00885L21.0873 2.52502C18.7009 -0.550159 13.9111 -0.0347998 12.234 3.47934C12.1807 3.59071 12.0969 3.68472 11.9924 3.75052C11.888 3.81633 11.767 3.85124 11.6435 3.85124C11.52 3.85124 11.399 3.81633 11.2946 3.75052C11.1901 3.68472 11.1063 3.59071 11.053 3.47934C9.37592 -0.0347998 4.58611 -0.551372 2.1997 2.52502L1.82379 3.01006C0.861405 4.25088 0.396321 5.80598 0.519431 7.37143C0.642541 8.93688 1.345 10.4002 2.48951 11.4753H2.4883Z" />
								</svg>
							</div>
							<span class="text-sm font-medium hidden lg:inline">{{ trans('blocks.header.wishlist') }}</span>
						</div>
						{% else %}
							

                        {# Search Button #}
						<div class="flex-col items-center gap-1.5 hidden lg:flex lg:min-w-16">
							{% if theme.settings.get('enable_side_search') %}
								<button id="search-trigger" class="search-trigger inline-flex items-center justify-center lg:w-5 lg:h-5 w-4 h-4 border-0 bg-transparent cursor-pointer rounded-[10px] text-inherit transition-colors duration-300 hover:bg-font/5" aria-label="Search" aria-expanded="false" aria-controls="search-drawer">
									<svg xmlns="http://www.w3.org/2000/svg" width="23" height="21" viewbox="0 0 23 21" fill="none">
										<path d="M22.5 19.8534L17.703 15.0562" stroke-linecap="round" stroke-linejoin="round"/>
										<path d="M9.32203 18.1448C14.1943 18.1448 18.1441 14.1949 18.1441 9.32239C18.1441 4.44992 14.1943 0.5 9.32203 0.5C4.44976 0.5 0.5 4.44992 0.5 9.32239C0.5 14.1949 4.44976 18.1448 9.32203 18.1448Z"  stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
								</button>
							{% else %}

								<button onclick="salla.event.dispatch('search::open')" class="aspect-square button-style">
									<svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 33 34" fill="none">
										<path d="M20 20L28 28M13.3333 22.6667C8.17868 22.6667 4 18.488 4 13.3333C4 8.17868 8.17868 4 13.3333 4C18.488 4 22.6667 8.17868 22.6667 13.3333C22.6667 18.488 18.488 22.6667 13.3333 22.6667Z" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
									</svg>
								</button>
							{% endif %}
							<span class="text-sm font-medium hidden lg:inline">{{ trans('blocks.header.search') }}</span>
						</div>
						{% endif %}

					</div>


					{# Center Section - Logo #}
					<div class="flex flex-1 lg:justify-center {{ show_top_navbar and logo_end ? 'justify-start' : 'justify-center' }} {{ not show_top_navbar ? 'justify-center' : '' }}" href="{{ store.url }}">
						<div class="the-logo navbar-brand !w-auto lg:h-6 h-4 relative">
							<a class="block absolute h-full w-full" href="{{ store.url }}"></a>

							<img class="h-full w-full object-contain" fetchpriority="high" loading="eager" src="{{ store.logo }}" alt="{{ store.name }} logo">
						</div>
					</div>


                    {# right Section - Menu Toggle #}
					<div class="flex-1 gap-4 justify-end items-center {{ side_menu ? 'flex' : 'flex items-center lg:hidden' }}">
                        						{% if store.settings.is_multilingual or store.settings.currencies_enabled %}
							<div class="flex items-center custom-button justify-end lg:hidden">
								<button type="button" onclick="salla.event.dispatch('localization::open')" class="flex items-center basis-0 !p-0">
											<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" width="256" height="256" viewBox="0 0 256 256" xml:space="preserve">
