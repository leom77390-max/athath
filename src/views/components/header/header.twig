			</div>
		</div>
	</div>
</header>
{% if theme.settings.get('enable_side_cart') %}
    {% include 'components.custom.side_cart.twig' %}
{% endif %}
{% if theme.settings.get('enable_side_search') %}
    {% include "pages.partials.product.search_product.twig" %}
{% endif %}
{# Styles #}
<style>

    /* Cart Summary - Hide SVG icon */
    salla-cart-summary > .s-cart-summary-wrapper svg {
        display: none !important;
    }


    /* Header Colors - Only when not absolute header */
    {% if not absolute_header and add_header_colors %}
        .Sleek-header {
            /* Sub-menu Styles */
            .has-children li a:hover,
            .has-children:hover > a {
                background: color-mix(in srgb, {{ topnav_bg }} 9%, transparent) !important;
            }

            /* Inner Elements Colors */
            .inner *,
            .button-style i,
            .custom-cart-summary i {
                stroke: {{ topnav_text_colors }} !important;
                color: {{ topnav_text_colors }} !important;
            }
            .inner .s-cart-summary-count{
                color: #fff !important;
            }

            /* Sub-menu Background */
            .sub-menu ul {
                background-color: {{ topnav_text_colors }} !important;
            }

            .sub-menu * {
                color: {{ topnav_bg }} !important;
            }

            .Sleek-header .main-menu .sub-menu span {
                color: {{ topnav_bg }} !important;
            }
            

            /* Menu Item Hover */
            .main-menu li > a:hover {
                opacity: 0.7;
                color: {{ topnav_text_colors }} !important;
            }

            /* Inner Background */
            .inner {
                background: {{ topnav_bg }} !important;
            }

            /* Mobile Menu Toggle */
            .mburger span {
                color: {{ topnav_text_colors }} !important;
                background-color: {{ topnav_text_colors }} !important;
            }
        }
    {% endif %}

    /* Mobile Menu Padding - Non-homepage */
    {% if page.slug != 'index' %}
        .mm-ocd__content {
            padding: 10px;
        }
    {% endif %}

    /* Mobile Menu Backdrop Positioning */
    [dir="ltr"].mm-ocd__backdrop::after {
        right: 0px;
    }

    [dir="rtl"].mm-ocd__backdrop::after {
        left: 0px;
    }

    /* Mobile Menu Logo */
    [dir="rtl"] .mm-spn.mm-spn--navbar.mm-spn--main .main-menu.logo {
        background: url({{ store.logo }}) center right / contain no-repeat var(--color-background);
        padding: 40px 0px;
    }

    [dir="ltr"] .mm-spn.mm-spn--navbar.mm-spn--main .main-menu.logo {
        background: url({{ store.logo }}) center right / contain no-repeat var(--color-background);
        padding: 40px 0px;
    }

    {/* Hide Cart Total */}
    {% if not show_total %}
        .Sleek-header .s-cart-summary-content {
            display: none;
        }

        .Sleek-header salla-cart-summary {
            gap: 0;
        }
    {% endif %}
    {% if logo_size %}
        .the-logo {
            height: {{ logo_size_lg }}px;
        }
        
        @media (max-width: 1024px) {
            .the-logo {
                height: {{ logo_size_sm }}px;
            }
        }
    {% endif %}
		
</style>

<script>
(() => {
    const lang = '{{ language.code }}';
    const placeholderText = lang === 'ar'
        ? 'بحث'
        : "Search";

    const setPlaceholder = () => {
        const input = document.querySelector('salla-search .s-search-input');

        if (input && input.placeholder !== placeholderText) {
            input.placeholder = placeholderText;
        }
    };

    setPlaceholder();

    new MutationObserver(setPlaceholder).observe(document.body, {
        childList: true,
        subtree: true,
    });
})();
</script>

