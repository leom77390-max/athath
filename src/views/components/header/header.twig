								<span class="w-2.5 group-hover:w-5 transition-all h-[2px] bg-background rounded-lg"></span>
							</p>
							

						</a> #}
                        								<button id="custom-menu-trigger" class="custom-menu-trigger  justify-start gap-2 items-center flex">
									<p class="flex flex-col gap-1 items-start group">
										<span class="w-5 h-[2px] bg-primary rounded-lg span-menue"></span>
										<span class="w-5 group-hover:w-3 transition-all h-[2px] bg-primary rounded-lg span-menue"></span>
										<span class="w-2.5 group-hover:w-5 transition-all h-[2px] bg-primary rounded-lg span-menue"></span>

									</p>
								</button>



					</div>
					{% if below_logo_menu %}
					
					{# Search bar #}
					<div class="header-search flex-1 justify-end hidden lg:flex">
						<salla-search oval inline height="36"></salla-search>
					</div>
					{% else %}
                    <custom-main-menu class="flex-1 justify-start hidden lg:block head-level mob-menu"></custom-main-menu>	
