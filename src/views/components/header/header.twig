{#
| Variable         | Type    | Description                                |
|------------------|---------|--------------------------------------------|
| cart             | object  | Cart data object                           |
| cart.items_count | int     | Number of items in cart                     |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"               |
| user             | object  | Current user data                           |
| user.type        | string  | User type ('user' or 'guest')               |
| user.language    | object  | Current user language                        |
| store            | object  | Store data object                            |
| store.name       | string  | Store name                                   |
| store.logo       | string  | Store logo URL                               |
| store.url        | string  | Store base URL                               |
| store.scope      | object  | Store scope/location data                    |
| store.settings   | object  | Store settings                               |
| currency         | object  | Current currency data                         |
| currency.symbol  | string  | Currency symbol                               |
| page             | object  | Current page data                             |
| page.slug        | string  | Page slug (e.g., 'index' for homepage)       |

#}

{# Theme Settings #}
{% set important_links = theme.settings.get('important_links') %}
{% set show_total = theme.settings.get('show_total') %}
{% set hide_topnavbar = theme.settings.get('hide_topnavbar') %}
{% set add_promo_bar = theme.settings.get('add_promo_bar') %}
{% set customize_promo_bar_colors = theme.settings.get('customize_promo_bar_colors') %}
{% set promo_bar_bg = theme.settings.get('promo_bar_bg') %}
{% set promo_bar_text_color = theme.settings.get('promo_bar_text_color') %}
{% set promo_text = theme.settings.get('promo_text') %}
{% set promo_icon = theme.settings.get('promo_icon') %}
{% set add_header_colors = theme.settings.get('add_header_colors') %}
{% set topnav_bg = theme.settings.get('topnav_bg') %}
{% set topnav_text_colors = theme.settings.get('topnav_text_colors') %}
{% set logo_size = theme.settings.get('logo_size_control') %}
{% set logo_size_sm = theme.settings.get('logo_size_sm') %}
{% set logo_size_lg = theme.settings.get('logo_size_lg') %}
{% set below_logo_menu = theme.settings.get('below_logo_menu') %}






<header class="store-header Sleek-header relative z-50 ">
{% if add_promo_bar %}
	<div style="background-color: {{ customize_promo_bar_colors ? promo_bar_bg : 'var(--color-primary)' }}; color: {{ customize_promo_bar_color ? promo_bar_text_color : 'var(--color-background)' }};" class="promo-bar min-h-8 lg:min-h-12 flex items-center justify-center">
        <div class="max-w-[1412px] px-4 text-center py-1 text-sm">
            {% if promo_icon %}
            <img src="{{ promo_icon }}" alt="Promo Icon" class="inline-block ltr:mr-2 rtl:ml-2" style="height: clamp(1.063rem, 1.7171rem + -2.6163vw, 1.438rem); width: auto;">
            {% endif %}
            {% if promo_text %}
                 <span class="font-medium text-[clamp(10px,1.1705rem+-2.3302vw,15px)]">{{ promo_text }}</span>
            {% endif %}
		</div>
    </div>
{% endif %}

	{# Top Navigation Bar #}
	{% if show_top_navbar %}
	<div class="top-navbar bg-primary flex items-center justify-between z-2">
		<div
			class="max-w-[1412px] px-4 flex justify-between flex-wrap gap-1 top-navbar">

			{# Important Links Menu #}
			{% if important_links %}
				<salla-menu source="footer" topnav class="lg:!flex hidden lg:flex-1 justify-start flex-wrap text-background items-center"></salla-menu>
			{% endif %}

			{# Store Scope/Location #}
			{% if store.scope %}
				<button class="btn--rounded-gray" onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
					<i class="sicon-location rtl:ml-1 ltr:mr-1"></i>
					{{ store.scope.name }}
				</button>
			{% endif %}

			{# Contact Information #}
			<salla-contacts is-header class="!flex lg:flex-1 justify-end text-background"></salla-contacts>


		</div>
	</div>
	{% endif %}

	{# Main Navigation #}
	<div id="mainnav" class="main-nav-container relative">

		<div class="inner lg:py-4 py-2 z-50 text-background bg-font relative min-h-12 lg:min-h-20  flex items-center justify-center{% if page.slug == 'index' and absolute_header %} absolute-header bg-transparent {% else %} {% endif %}">
			<div class="custom-menu top-[var(--mainnav-height)] lg:block hidden" data-id="main-dropdown"></div>

			<div
				class="max-w-[1412px] px-4 w-full flex flex-col items-stretch justify-stretch gap-4">

				{# Header Main Row #}
				<div
					class="flex relative h-auto lg:py-1 py-2 items-center gap-4 lg:gap-6 justify-between">
                {# left Section - Action Icons #}
					<div
						class="flex icons lg:gap-6 gap-4 items-center justify-start flex-1">
                        {# User Menu / Login Button #}
						{% if user.type == 'user' %}
							<div class="flex flex-col items-center gap-1.5 lg:px-2 lg:min-w-16">

								<salla-user-menu avatar-only show-header></salla-user-menu>
								<span class="text-sm font-medium hidden lg:inline">{{ trans('blocks.header.account') }}</span>
							</div>
						{% else %}
							<div class="flex flex-col items-center gap-1.5 lg:px-2 lg:min-w-16">
								<button class="header-btn button-style" aria-label="user-icon" onclick="salla.event.dispatch('login::open')">
									<svg xmlns="http://www.w3.org/2000/svg" width="17" height="21" viewbox="0 0 17 21" fill="none">
										<path d="M8.37006 8.24C10.5074 8.24 12.2401 6.50734 12.2401 4.37C12.2401 2.23266 10.5074 0.5 8.37006 0.5C6.23272 0.5 4.50006 2.23266 4.50006 4.37C4.50006 6.50734 6.23272 8.24 8.37006 8.24Z" />
										<path d="M15.9801 15.4962C15.9801 17.9005 15.9801 19.85 8.24006 19.85C0.500061 19.85 0.500061 17.9005 0.500061 15.4962C0.500061 13.092 3.96565 11.1425 8.24006 11.1425C12.5145 11.1425 15.9801 13.092 15.9801 15.4962Z" />
									</svg>
								</button>
								<span class="text-sm font-medium hidden lg:inline">{{ trans('blocks.header.account') }}</span>
							</div>
						{% endif %}
						{# Wishlist #}
						<div class="flex lg:hidden flex-col items-center gap-1.5 lg:px-2 lg:min-w-16">
							<div class="flex items-center justify-center button-style relative">
								<a class="absolute block h-full w-full" href="{{ store.url }}/wishlist"></a>
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="21" viewbox="0 0 24 21" fill="none">
									<path d="M2.4883 11.4753L10.9196 19.3948C11.2106 19.6677 11.3561 19.8047 11.5259 19.8387C11.6031 19.8539 11.6826 19.8539 11.7599 19.8387C11.9321 19.8047 12.0764 19.6689 12.3662 19.3948L20.7975 11.4765C21.9427 10.4013 22.6455 8.9375 22.7687 7.37148C22.8918 5.80546 22.4263 4.24984 21.4632 3.00885L21.0873 2.52502C18.7009 -0.550159 13.9111 -0.0347998 12.234 3.47934C12.1807 3.59071 12.0969 3.68472 11.9924 3.75052C11.888 3.81633 11.767 3.85124 11.6435 3.85124C11.52 3.85124 11.399 3.81633 11.2946 3.75052C11.1901 3.68472 11.1063 3.59071 11.053 3.47934C9.37592 -0.0347998 4.58611 -0.551372 2.1997 2.52502L1.82379 3.01006C0.861405 4.25088 0.396321 5.80598 0.519431 7.37143C0.642541 8.93688 1.345 10.4002 2.48951 11.4753H2.4883Z" />
								</svg>
							</div>
						</div>

                        {# Localization (Language/Currency) #}
						{% if store.settings.is_multilingual or store.settings.currencies_enabled %}
						<div class="hidden lg:flex flex-col items-center gap-1.5 lg:px-2 lg:min-w-16">
							<div class="flex items-center justify-center button-style relative">
								
								
										<button type="button" onclick="salla.event.dispatch('localization::open')" class="flex items-center basis-0 !p-0">
												<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" width="256" height="256" viewBox="0 0 256 256" xml:space="preserve">
