{# ======================================================
   Button Effect Pattern
====================================================== #}
{% set selector = selector|default('btn-effect') %}
{% set text = text|default('Button') %}
{% set icon = icon|default('') %}
<a href="{{href}}" class="{{ selector }} {{class}}">
    <span>{{ text }}</span>
    {% if icon %}
        <i class="{{ icon }}"></i>
    {% endif %}
</a>
{% set bg = bg|default('transparent') %}
{% set color = color|default('#111') %}
{% set border = border|default('#111') %}
{% set shine = shine|default('rgba(255,255,255,.45)') %}
<style>
.{{ selector }}{
    --btn-bg: {{ bg }};
    --btn-color: {{ color }};
    --btn-border: {{ border }};
    --btn-hover-bg: {{ color }};
    --btn-hover-color: {{ bg }};

    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;

    background: var(--btn-bg);
    color: var(--btn-color);
    border: 1px solid var(--btn-border);

    transition:
        color .45s cubic-bezier(.7,0,.3,1),
        border-color .35s ease,
        transform .25s,
        box-shadow .25s;
}

.{{ selector }}::before,
.{{ selector }}::after{
    content: "";
    position: absolute;
    inset: 0;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform .5s cubic-bezier(.7,0,.3,1);
    z-index: 1;
}

.{{ selector }}::before{
    background: var(--btn-hover-bg);
    opacity: .3;
    transition-delay: .1s;
}

.{{ selector }}::after{
    background: var(--btn-hover-bg);
    transition-delay: 0s;
}

.{{ selector }} > *{
    position: relative;
    z-index: 2;
    transition: color .5s cubic-bezier(.7,0,.3,1);
}

@media (hover:hover){

.{{ selector }}:hover{
    color: var(--btn-hover-color);
    border-color: var(--btn-hover-bg);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(0,0,0,.18);
}

.{{ selector }}:hover::before,
.{{ selector }}:hover::after{
    transform: scaleX(1);
    transform-origin: left;
}

.{{ selector }}:hover::before{
    transition-delay: 0s;
}

.{{ selector }}:hover::after{
    transition-delay: .1s;
}

.{{ selector }}:hover > *{
    color: var(--btn-hover-color);
}

}
</style>