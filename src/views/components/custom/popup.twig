{% if theme.settings.get("show_popup") %}
<section class="full-screen-popup">
  <div
    class="pop-up pop-up-{{ position }}"
    style="background-color: {{ theme.settings.get('popup_bg') }};">

    <button id="popup-close">
      <i class="sicon-cancel"></i>
    </button>

    <div class="popup-layout">

      {% if theme.settings.get('popup_img') %}
      <div class="popup-image">
        <img
          src="{{ theme.settings.get('popup_img') }}"
          alt="Popup Image"
          loading="lazy">
      </div>
      {% endif %}

      <div class="popup-content">

        <div class="popup-logo">
          <img src="{{ store.logo }}" alt="{{ store.name }} logo">
        </div>

        <div class="popup-badge">
          <span style="color: {{ theme.settings.get('promotional_header_color') }};">
            {{ theme.settings.get("promotional_header") }}
          </span>
        </div>

        <p class="popup-main-header"
          style="color: {{ theme.settings.get('main_header_color') }};">
          {{ theme.settings.get("main_header") }}
        </p>

        {% if theme.settings.get('code_switch') %}

          <div class="popup-divider">
            <span>{{ trans('blocks.popup.click_to_copy') }}</span>
          </div>

          <div class="coupon-code-container">
            <div
              id="coupon-code"
              data-code="{{ theme.settings.get('code_text') }}"
              title="{{ trans('blocks.popup.click_to_copy') }}"
              style="
                color: {{ theme.settings.get('code_text_color') }};
                background-color: {{ theme.settings.get('code_text_bg') }};
                border-color: var(--color-secondary);
              ">
              <i class="sicon-copy"></i>
              {{ theme.settings.get("code_text") }}
            </div>
            <p class="coupon-hint">{{ trans('blocks.popup.click_to_copy') }}</p>
          </div>

        {% else %}

          <form
            id="newsletter-form-popup"
            action="{{ theme.settings.get('newsletter_url') }}"
            method="POST">

            <div class="newsletter-form">
              <span class="email-icon"><i class="sicon-envelope"></i></span>
              <input
                placeholder="{{ trans('blocks.popup.email_address') }}"
                id="newsletter-email-popup"
                name="email"
                required
                style="
                  color: {{ theme.settings.get('input_text_color') }};
                  border-color: {{ theme.settings.get('input_text_bg') }};
                ">
              <label
                for="newsletter-email-popup"
                style="
                  background-color: {{ theme.settings.get('popup_bg') }};
                  color: {{ theme.settings.get('switch_color') ? theme.settings.get('placeholder_text_color') : '#7a7676' }};
                ">
                {{ trans('blocks.popup.email_address') }}
              </label>
            </div>

            <button
              type="submit"
              id="newsletter-submit-popup"
              class="popup-submit-btn">
              <span>{{ theme.settings.get("btn_text") }}</span>
              <i class="sicon-arrow-right"></i>
            </button>

          </form>

          <p class="popup-privacy">
            <i class="sicon-lock"></i>
            {{ theme.settings.get("privacy_note") }}
          </p>

        {% endif %}

      </div>
    </div>
  </div>
</section>

<style>
  .full-screen-popup {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    z-index: 999999 !important;
    display: none;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.55);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .full-screen-popup.show {
    opacity: 1;
    visibility: visible;
  }

  .pop-up {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    max-width: 900px;
    width: 92%;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.18);
    transform: translateY(28px);
    transition: transform 0.35s ease;
  }

  .full-screen-popup.show .pop-up {
    transform: translateY(0);
  }

  .popup-layout {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    min-height: 480px;
  }

  .popup-image {
    flex: 0 0 46%;
    max-width: 46%;
    overflow: hidden;
  }

  .popup-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .popup-content {
    flex: 1;
    padding: 44px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    text-align: center;
  }

  .popup-logo {
    display: flex;
    justify-content: center;
    margin-bottom: 2px;
  }

  .popup-logo img {
    height: 44px;
    width: auto;
    object-fit: contain;
  }

  .popup-badge {
    display: inline-block;
    background-color: #f4f4f4;
    border-radius: 20px;
    padding: 5px 18px;
    font-size: 13px;
    font-weight: 600;
  }

  .popup-main-header {
    font-size: 15px;
    line-height: 1.7;
    color: #555;
    margin: 0;
    max-width: 320px;
  }

  .popup-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    color: #aaa;
    font-size: 13px;
  }

  .popup-divider::before,
  .popup-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #e0e0e0;
  }

  #newsletter-form-popup {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .newsletter-form {
    position: relative;
    width: 100%;
  }

  .newsletter-form input {
    width: 100%;
    padding: 14px 44px 14px 16px;
    border: 1.5px solid;
    border-radius: 10px;
    font-size: 14px;
    background: #fff;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s;
    direction: rtl;
    text-align: right;
  }

  .newsletter-form input:focus {
    border-color: var(--color-secondary) !important;
  }

  .email-icon {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #aaa;
    font-size: 16px;
    pointer-events: none;
  }

  .newsletter-form label {
    display: none;
  }

  .popup-submit-btn {
    width: 100%;
    padding: 14px 20px;
    border: none;
    border-radius: 10px;
    background-color: var(--color-secondary);
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: opacity 0.2s, transform 0.15s;
  }

  .popup-submit-btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }

  .popup-submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .popup-privacy {
    font-size: 12px;
    color: #999;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .coupon-code-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  #coupon-code {
    width: 100%;
    padding: 14px 20px;
    border: 2px dashed;
    border-radius: 10px;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 2px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    transition: transform 0.15s, opacity 0.15s;
    box-sizing: border-box;
  }

  #coupon-code:hover {
    opacity: 0.85;
  }

  .coupon-hint {
    font-size: 12px;
    color: #999;
    margin: 0;
  }

  #popup-close {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 10;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 14px;
    color: #555;
    transition: background 0.2s, transform 0.2s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
  }

  #popup-close:hover {
    background: #fff;
    transform: scale(1.08);
  }

  @media (max-width: 640px) {
    .popup-layout {
      flex-direction: column;
    }

    .popup-image {
      flex: 0 0 200px;
      max-width: 100%;
      height: 200px;
    }

    .popup-content {
      padding: 28px 24px;
    }
  }
</style>

<script>
  const closeBtn = document.getElementById("popup-close");
  const popup = document.querySelector(".full-screen-popup");
  const popupBox = document.querySelector(".pop-up");

  if (closeBtn && popup && popupBox) {
    const hasSeenPopup = sessionStorage.getItem("popupShown");

   if (!hasSeenPopup) {
      window.addEventListener("load", function () {
        setTimeout(() => {
          popup.style.display = "flex";
          popup.classList.add("show");
          sessionStorage.setItem("popupShown", "true");
        }, 5000);
      });
    }

    closeBtn.addEventListener("click", function () {
      popup.classList.remove("show");
      setTimeout(() => {
        popup.style.display = "none";
      }, 350);
    });

    popup.addEventListener("click", function (e) {
      if (!popupBox.contains(e.target)) {
        popup.classList.remove("show");
        setTimeout(() => {
          popup.style.display = "none";
        }, 350);
      }
    });
  }

  const couponCode = document.getElementById("coupon-code");
  if (couponCode) {
    const isRTL = document.documentElement.dir === "rtl";

    couponCode.addEventListener("click", function () {
      const code = this.dataset.code;

      navigator.clipboard
        .writeText(code)
        .then(() => {
          const successMessage = isRTL
            ? "تم نسخ الكود بنجاح!"
            : "Code copied successfully!";
          salla.notify.success(successMessage);

          this.style.transform = "scale(0.95)";
          setTimeout(() => {
            this.style.transform = "scale(1)";
          }, 100);
        })
        .catch(() => {
          const errorMessage = isRTL ? "فشل نسخ الكود" : "Failed to copy code";
          salla.notify.error(errorMessage);
        });
    });
  }

  document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("newsletter-form-popup");
    if (!form) return;

    const emailInput = document.getElementById("newsletter-email-popup");
    const submitBtn = document.getElementById("newsletter-submit-popup");
    const isRTL = document.documentElement.dir === "rtl";

    const messages = {
      required: isRTL
        ? "الرجاء إدخال بريد إلكتروني صحيح"
        : "Please enter a valid email",
      invalid: isRTL
        ? "صيغة البريد الإلكتروني غير صحيحة"
        : "Invalid email format",
      sending: isRTL ? "جاري الإرسال..." : "Sending...",
      success: isRTL
        ? "تم الاشتراك بنجاح! شكراً لك"
        : "Subscription successful! Thank you",
      error: isRTL
        ? "حدث خطأ ما. حاول مرة أخرى"
        : "Something went wrong. Please try again",
    };

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      const emailValue = emailInput.value.trim();

      if (!emailValue) {
        salla.notify.error(messages.required);
        emailInput.focus();
        return;
      }

      if (!emailRegex.test(emailValue)) {
        salla.notify.error(messages.invalid);
        emailInput.focus();
        return;
      }

      submitBtn.disabled = true;
      salla.notify.info(messages.sending);

      fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        mode: "no-cors",
      })
        .then(() => {
          salla.notify.success(messages.success);
          emailInput.value = "";
          form.reset();
          if (popup) {
            popup.classList.remove("show");
            setTimeout(() => {
              popup.style.display = "none";
            }, 350);
          }
        })
        .catch(() => {
          salla.notify.error(messages.error);
        })
        .finally(() => {
          submitBtn.disabled = false;
        });
    });
  });
</script>
{% endif %}
