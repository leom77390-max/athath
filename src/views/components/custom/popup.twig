{% if theme.settings.get("show_popup") %}
<section class="full-screen-popup">
  <div
    class="pop-up pop-up-{{ position }}"
    style="background-color: {{ theme.settings.get('popup_bg') }};">

    <button id="popup-close">
      <i class="sicon-cancel text-primary"></i>
    </button>

    <div class="popup-layout">

      {% if theme.settings.get('popup_img') %}
      <div class="popup-image">
        <img
          src="{{ theme.settings.get('popup_img') }}"
          alt="Popup Image"
          loading="lazy">
      </div>
      {% endif %}

      <div class="popup-content">

        <h2
          style="color: {{ theme.settings.get('promotional_header_color') }};">
          {{ theme.settings.get("promotional_header") }}
        </h2>

        <p
          style="color: {{ theme.settings.get("main_header_color") }};">
          {{ theme.settings.get("main_header") }}
        </p>

        {% if theme.settings.get('code_switch') %}

        <div class="coupon-code-container">
          <div
            id="coupon-code"
            data-code="{{ theme.settings.get('code_text') }}"
            title="{{ trans('blocks.popup.click_to_copy') }}"
            style="
              color: {{ theme.settings.get('code_text_color') }};
              background-color: {{ theme.settings.get('code_text_bg') }};
              border-color: {{ theme.settings.get('code_text_color') }};
            ">
            {{ theme.settings.get("code_text") }}

            <i class="sicon-copy"></i>
          </div>

          <p>{{ trans('blocks.popup.click_to_copy') }}</p>
        </div>

        {% else %}

        <form
          id="newsletter-form-popup"
          action="{{ theme.settings.get('newsletter_url') }}"
          method="POST">

          <div class="newsletter-form">

            <input
              placeholder="{{ trans('blocks.popup.email_address') }}"
              id="newsletter-email-popup"
              name="email"
              required
              style="
                color: {{ theme.settings.get('input_text_color') }};
                border-color: {{ theme.settings.get('input_text_bg') }};
              ">

            <label
              for="newsletter-email-popup"
              style="
                background-color: {{ theme.settings.get('popup_bg') }};
                color: {{ theme.settings.get('switch_color') ? theme.settings.get('placeholder_text_color') : '#7a7676' }};
              ">
              {{ trans('blocks.popup.email_address') }}
            </label>

          </div>

          <button
            type="submit"
            id="newsletter-submit-popup"
            style="
              --btn-clr: {{ theme.settings.get('btn_text_color') }};
              --btn-bg: {{ theme.settings.get('btn_text_bg') }};
            ">
            <span>{{ theme.settings.get("btn_text") }}</span>
          </button>

        </form>

        {% endif %}

      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .animate-float {
    animation: float 3s ease-in-out infinite;
  }

  .full-screen-popup.show {
    opacity: 1;
    visibility: visible;
  }

  .full-screen-popup.show .pop-up {
    transform: translateY(0);
  }

</style>

<script>
  const closeBtn = document.getElementById("popup-close");
  const popup = document.querySelector(".full-screen-popup");
  const popupBox = document.querySelector(".pop-up");

  if (closeBtn && popup && popupBox) {
    const hasSeenPopup = sessionStorage.getItem("popupShown");

    if (!hasSeenPopup) {
      setTimeout(() => {
        popup.classList.add("show");
        sessionStorage.setItem("popupShown", "true");
      }, 5000); 
    }

    closeBtn.addEventListener("click", function () {
      popup.classList.remove("show");
      setTimeout(() => {
        popup.style.display = "none";
      }, 300);
    });

    popup.addEventListener("click", function (e) {
      if (!popupBox.contains(e.target)) {
        popup.classList.remove("show");
        setTimeout(() => {
          popup.style.display = "none";
        }, 300);
      }
    });
  }

  const couponCode = document.getElementById("coupon-code");
  if (couponCode) {
    const isRTL = document.documentElement.dir === "rtl";

    couponCode.addEventListener("click", function () {
      const code = this.dataset.code;

      navigator.clipboard
        .writeText(code)
        .then(() => {
          const successMessage = isRTL
            ? "تم نسخ الكود بنجاح!"
            : "Code copied successfully!";
          salla.notify.success(successMessage);

          this.style.transform = "scale(0.95)";
          setTimeout(() => {
            this.style.transform = "scale(1)";
          }, 100);
        })
        .catch(() => {
          const errorMessage = isRTL ? "فشل نسخ الكود" : "Failed to copy code";
          salla.notify.error(errorMessage);
        });
    });
  }

  document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("newsletter-form-popup");
    if (!form) return;

    const emailInput = document.getElementById("newsletter-email-popup");
    const submitBtn = document.getElementById("newsletter-submit-popup");
    const isRTL = document.documentElement.dir === "rtl";

    const messages = {
      required: isRTL
        ? "الرجاء إدخال بريد إلكتروني صحيح"
        : "Please enter a valid email",
      invalid: isRTL
        ? "صيغة البريد الإلكتروني غير صحيحة"
        : "Invalid email format",
      sending: isRTL ? "جاري الإرسال..." : "Sending...",
      success: isRTL
        ? "تم الاشتراك بنجاح! شكراً لك"
        : "Subscription successful! Thank you",
      error: isRTL
        ? "حدث خطأ ما. حاول مرة أخرى"
        : "Something went wrong. Please try again",
    };

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      const emailValue = emailInput.value.trim();

      if (!emailValue) {
        salla.notify.error(messages.required);
        emailInput.focus();
        return;
      }

      if (!emailRegex.test(emailValue)) {
        salla.notify.error(messages.invalid);
        emailInput.focus();
        return;
      }

      submitBtn.disabled = true;
      salla.notify.info(messages.sending);

      fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        mode: "no-cors",
      })
        .then(() => {
          salla.notify.success(messages.success);
          emailInput.value = "";
          form.reset();
          if (popup) {
            popup.classList.remove("show");
            setTimeout(() => {
              popup.style.display = "none";
            }, 300);
          }
        })
        .catch(() => {
          salla.notify.error(messages.error);
        })
        .finally(() => {
          submitBtn.disabled = false;
        });
    });
  });
</script>
{% endif %}

<style>
.full-screen-popup {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(3px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999999;
  opacity: 0;
  visibility: hidden;
  transition: all .3s ease;
}

.full-screen-popup.show {
  opacity: 1;
  visibility: visible;
}

.pop-up {
  position: relative;
  width: min(900px, calc(100vw - 32px));
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(0,0,0,.15);
  transform: translateY(100%);
  transition: transform .5s ease;
}

.full-screen-popup.show .pop-up {
  transform: translateY(0);
}

.popup-layout {
  display: flex;
  align-items: center;
}

.popup-image {
  width: 40%;
  flex-shrink: 0;
}

.popup-image img {
  width: 100%;
  display: block;
  height: 100%;
  object-fit: cover;
}

.popup-content {
  width: 60%;
  padding: 40px;
  text-align: right;
}

.popup-content h2 {
  font-size: 24px;
  font-weight: 700;
  margin-bottom: 12px;
}

.popup-content p {
  font-size: 15px;
  line-height: 1.8;
  margin-bottom: 20px;
}

#popup-close {
  position: absolute;
  top: 15px;
  right: 15px;
  width: 36px;
  height: 36px;
  border: 2px solid var(--color-primary);
  border-radius: 50%;
  background: transparent;
  cursor: pointer;
  z-index: 5;
}

.newsletter-form {
  position: relative;
  margin-bottom: 15px;
}

.newsletter-form input {
  width: 100%;
  padding: 16px 20px;
  border: 1px solid;
  border-radius: 12px;
  background: transparent;
  outline: none;
}

.newsletter-form label {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  padding: 0 8px;
  transition: .3s;
}

.newsletter-form input:focus + label,
.newsletter-form input:not(:placeholder-shown) + label {
  top: 0;
}

#newsletter-submit-popup {
  width: 100%;
  border: 0;
  border-radius: 12px;
  padding: 16px;
  cursor: pointer;
  background: var(--btn-bg);
  color: var(--btn-clr);
  font-weight: 700;
}

#coupon-code {
  position: relative;
  padding: 14px;
  border: 2px dashed;
  border-radius: 12px;
  text-align: center;
  font-weight: 700;
  cursor: pointer;
}

#coupon-code .sicon-copy {
  position: absolute;
  left: 15px;
  top: 50%;
  transform: translateY(-50%);
}

.coupon-code-container p {
  margin-top: 10px;
  font-size: 12px;
  opacity: .7;
}

@media (max-width: 768px) {
  .popup-layout {
    flex-direction: column;
  }

  .popup-image,
  .popup-content {
    width: 100%;
  }

  .popup-content {
    padding: 24px;
    text-align: center;
  }
}

</style>