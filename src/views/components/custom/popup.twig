{% if theme.settings.get("show_popup") %}
<section class="full-screen-popup">
  <div
    class="pop-up pop-up-{{ position }}"
    style="background-color: {{ theme.settings.get('popup_bg') }};">

    <button id="popup-close">
      <i class="sicon-cancel text-primary"></i>
    </button>

    <div class="popup-layout">

      {% if theme.settings.get('popup_img') %}
      <div class="popup-image">
        <img
          src="{{ theme.settings.get('popup_img') }}"
          alt="Popup Image"
          loading="lazy">
      </div>
      {% endif %}

      <div class="popup-content">

        <h2
          style="color: {{ theme.settings.get('promotional_header_color') }};">
          {{ theme.settings.get("promotional_header") }}
        </h2>

        <p
          style="color: {{ theme.settings.get("main_header_color") }};">
          {{ theme.settings.get("main_header") }}
        </p>

        {% if theme.settings.get('code_switch') %}

        <div class="coupon-code-container">
          <div
            id="coupon-code"
            data-code="{{ theme.settings.get('code_text') }}"
            title="{{ trans('blocks.popup.click_to_copy') }}"
            style="
              color: {{ theme.settings.get('code_text_color') }};
              background-color: {{ theme.settings.get('code_text_bg') }};
              border-color: {{ theme.settings.get('code_text_color') }};
            ">
            {{ theme.settings.get("code_text") }}

            <i class="sicon-copy"></i>
          </div>

          <p>{{ trans('blocks.popup.click_to_copy') }}</p>
        </div>

        {% else %}

        <form
          id="newsletter-form-popup"
          action="{{ theme.settings.get('newsletter_url') }}"
          method="POST">

          <div class="newsletter-form">

            <input
              placeholder="{{ trans('blocks.popup.email_address') }}"
              id="newsletter-email-popup"
              name="email"
              required
              style="
                color: {{ theme.settings.get('input_text_color') }};
                border-color: {{ theme.settings.get('input_text_bg') }};
              ">

            <label
              for="newsletter-email-popup"
              style="
                background-color: {{ theme.settings.get('popup_bg') }};
                color: {{ theme.settings.get('switch_color') ? theme.settings.get('placeholder_text_color') : '#7a7676' }};
              ">
              {{ trans('blocks.popup.email_address') }}
            </label>

          </div>

          <button
            type="submit"
            id="newsletter-submit-popup"
            style="
              --btn-clr: {{ theme.settings.get('btn_text_color') }};
              --btn-bg: {{ theme.settings.get('btn_text_bg') }};
            ">
            <span>{{ theme.settings.get("btn_text") }}</span>
          </button>

        </form>

        {% endif %}

      </div>
    </div>
  </div>
</section>

<style>
  .full-screen-popup {
    position: fixed !important;
    inset: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    z-index: 999999 !important;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .full-screen-popup.show {
    opacity: 1;
    visibility: visible;
  }

  .pop-up {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    max-width: 860px;
    width: 90%;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
    transform: translateY(30px);
    transition: transform 0.3s ease;
  }

  .full-screen-popup.show .pop-up {
    transform: translateY(0);
  }

  /* Layout: image on LEFT, content on RIGHT */
  .popup-layout {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    min-height: 400px;
  }

  .popup-image {
    flex: 0 0 45%;
    max-width: 45%;
    overflow: hidden;
  }

  .popup-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .popup-content {
    flex: 1;
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
  }

  #popup-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
    background: rgba(255, 255, 255, 0.85);
    border: none;
    border-radius: 50%;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  #popup-close:hover {
    background: rgba(255, 255, 255, 1);
    transform: scale(1.1);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .popup-layout {
      flex-direction: column;
    }

    .popup-image {
      flex: 0 0 220px;
      max-width: 100%;
      height: 220px;
    }

    .popup-content {
      padding: 28px 24px;
    }
  }
</style>

<script>
  const closeBtn = document.getElementById("popup-close");
  const popup = document.querySelector(".full-screen-popup");
  const popupBox = document.querySelector(".pop-up");

  if (closeBtn && popup && popupBox) {
    const hasSeenPopup = sessionStorage.getItem("popupShown");

    if (!hasSeenPopup) {
      setTimeout(() => {
        popup.classList.add("show");
        sessionStorage.setItem("popupShown", "true");
      }, 5000); 
    }

    closeBtn.addEventListener("click", function () {
      popup.classList.remove("show");
      setTimeout(() => {
        popup.style.display = "none";
      }, 300);
    });

    popup.addEventListener("click", function (e) {
      if (!popupBox.contains(e.target)) {
        popup.classList.remove("show");
        setTimeout(() => {
          popup.style.display = "none";
        }, 300);
      }
    });
  }

  const couponCode = document.getElementById("coupon-code");
  if (couponCode) {
    const isRTL = document.documentElement.dir === "rtl";

    couponCode.addEventListener("click", function () {
      const code = this.dataset.code;

      navigator.clipboard
        .writeText(code)
        .then(() => {
          const successMessage = isRTL
            ? "ØªÙ… Ù†Ø³Ø® Ø§Ù„ÙƒÙˆØ¯ Ø¨Ù†Ø¬Ø§Ø­!"
            : "Code copied successfully!";
          salla.notify.success(successMessage);

          this.style.transform = "scale(0.95)";
          setTimeout(() => {
            this.style.transform = "scale(1)";
          }, 100);
        })
        .catch(() => {
          const errorMessage = isRTL ? "ÙØ´Ù„ Ù†Ø³Ø® Ø§Ù„ÙƒÙˆØ¯" : "Failed to copy code";
          salla.notify.error(errorMessage);
        });
    });
  }

  document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("newsletter-form-popup");
    if (!form) return;

    const emailInput = document.getElementById("newsletter-email-popup");
    const submitBtn = document.getElementById("newsletter-submit-popup");
    const isRTL = document.documentElement.dir === "rtl";

    const messages = {
      required: isRTL
        ? "Ø§Ù„Ø±Ø¬Ø§Ø¡ Ø¥Ø¯Ø®Ø§Ù„ Ø¨Ø±ÙŠØ¯ Ø¥Ù„ÙƒØªØ±ÙˆÙ†ÙŠ ØµØ­ÙŠØ­"
        : "Please enter a valid email",
      invalid: isRTL
        ? "ØµÙŠØºØ© Ø§Ù„Ø¨Ø±ÙŠØ¯ Ø§Ù„Ø¥Ù„ÙƒØªØ±ÙˆÙ†ÙŠ ØºÙŠØ± ØµØ­ÙŠØ­Ø©"
        : "Invalid email format",
      sending: isRTL ? "Ø¬Ø§Ø±ÙŠ Ø§Ù„Ø¥Ø±Ø³Ø§Ù„..." : "Sending...",
      success: isRTL
        ? "ØªÙ… Ø§Ù„Ø§Ø´ØªØ±Ø§Ùƒ Ø¨Ù†Ø¬Ø§Ø­! Ø´ÙƒØ±Ø§Ù‹ Ù„Ùƒ"
        : "Subscription successful! Thank you",
      error: isRTL
        ? "Ø­Ø¯Ø« Ø®Ø·Ø£ Ù…Ø§. Ø­Ø§ÙˆÙ„ Ù…Ø±Ø© Ø£Ø®Ø±Ù‰"
        : "Something went wrong. Please try again",
    };

    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    form.addEventListener("submit", function (e) {
      e.preventDefault();

      const emailValue = emailInput.value.trim();

      if (!emailValue) {
        salla.notify.error(messages.required);
        emailInput.focus();
        return;
      }

      if (!emailRegex.test(emailValue)) {
        salla.notify.error(messages.invalid);
        emailInput.focus();
        return;
      }

      submitBtn.disabled = true;
      salla.notify.info(messages.sending);

      fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        mode: "no-cors",
      })
        .then(() => {
          salla.notify.success(messages.success);
          emailInput.value = "";
          form.reset();
          if (popup) {
            popup.classList.remove("show");
            setTimeout(() => {
              popup.style.display = "none";
            }, 300);
          }
        })
        .catch(() => {
          salla.notify.error(messages.error);
        })
        .finally(() => {
          submitBtn.disabled = false;
        });
    });
  });
</script>
{% endif %}
