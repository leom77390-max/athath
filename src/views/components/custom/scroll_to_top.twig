{% if theme.settings.get('scrolltotopbtn') %}

<button id="scrollToTopBtn" aria-label="Scroll to top">
    <div class="scroll-btn-inner">
        <i class="sicon-caret-up-double plane-icon"></i>
        <span class="scroll-px-counter" id="pxCounter">0</span>
    </div>

    <div class="scroll-btn-circle">
        <svg width="100%" height="100%" viewBox="0 0 60 60">
            <circle class="scroll-progress" cx="30" cy="30" r="26"/>
        </svg>
    </div>
</button>

{% endif %}


<style>
:root {
    --scroll-btn-size: 60px;
}

@media (max-width: 425px) {
    :root { --scroll-btn-size: 44px; }
}

#scrollToTopBtn {
    position: fixed;
    bottom: 50px;
    right: 20px;
    width: var(--scroll-btn-size);
    height: var(--scroll-btn-size);
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 30;
    opacity: 0;
    pointer-events: none;
    transform: translateY(20px);
    transition: opacity .35s ease, transform .3s ease;
}

#scrollToTopBtn.show {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
}

/* Inner circle */
.scroll-btn-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-primary) 15%, white 85%);
    border: 2px solid var(--color-primary);
    box-shadow: 0 4px 12px rgba(0,0,0,.12);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    position: relative;
}

/* Arrow icon — shows when NOT hovering */
.plane-icon {
    color: var(--color-primary);
    font-size: 1.25rem;
    line-height: 1;
    transition: opacity .2s ease, transform .2s ease;
}

/* Pixel counter — hidden by default */
.scroll-px-counter {
    font-size: 9px;
    font-weight: 600;
    color: var(--color-primary);
    letter-spacing: -.3px;
    line-height: 1;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity .2s ease, transform .2s ease;
    pointer-events: none;
}

/* On hover: show counter, push arrow up slightly */
#scrollToTopBtn:hover .plane-icon {
    transform: translateY(-3px);
    opacity: .5;
}

#scrollToTopBtn:hover .scroll-px-counter {
    opacity: 1;
    transform: translateY(0);
}

/* Progress ring */
.scroll-btn-circle {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
    pointer-events: none;
}

.scroll-progress {
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 3;
    stroke-linecap: round;
    transition: stroke-dashoffset .15s linear;
}

/* Mobile */
@media (max-width: 425px) {
    .plane-icon { font-size: 1rem; }
    .scroll-px-counter { font-size: 8px; }
    .scroll-progress { stroke-width: 2.5; }
}
</style>


<script>
(function () {
    const btn    = document.getElementById("scrollToTopBtn");
    const arc    = document.querySelector(".scroll-progress");
    const label  = document.getElementById("pxCounter");

    let circ = arc.getTotalLength();
    arc.style.strokeDasharray  = circ;
    arc.style.strokeDashoffset = circ;

    function fmt(n) {
        if (n >= 1000) return (n / 1000).toFixed(1) + "k";
        return Math.round(n) + "";
    }

    function update() {
        const top     = window.scrollY;
        const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        const progress  = Math.min(1, top / maxScroll);

        arc.style.strokeDashoffset = circ - progress * circ;
        label.textContent = fmt(top) + "px";
        btn.classList.toggle("show", top > 300);
    }

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", () => {
        circ = arc.getTotalLength();
        arc.style.strokeDasharray = circ;
        update();
    }, { passive: true });

    btn.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
    });
})();
</script>