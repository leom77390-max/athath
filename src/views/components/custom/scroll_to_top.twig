{% if theme.settings.get('scrolltotopbtn') %}
<button
    id="scrollToTopBtn"
    {# class="{{ theme.settings.get('enable_bottom_nav') ? '!bottom-[90px] md:!bottom-[65px]' : '' }}" #}
    aria-label="Scroll to top"
>
    <div class="scroll-btn-inner">
        <i class="sicon-caret-up-double plane-icon"></i>
    </div>

    <div class="scroll-btn-particles"></div>

    <div class="scroll-btn-circle">
        <svg width="100%" height="100%" viewBox="0 0 60 60">
            <circle
                class="scroll-progress"
                cx="30"
                cy="30"
                r="26"
            />
        </svg>
    </div>
</button>
{% endif %}



<style>
  :root {
    --scroll-btn-size: 60px;
}

@media (max-width: 425px) {
    :root {
        --scroll-btn-size: 40px;
    }
}

#scrollToTopBtn {
    position: fixed;
    bottom: 50px;
    right: 20px;
    width: var(--scroll-btn-size);
    height: var(--scroll-btn-size);
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 30;
    opacity: 0;
    pointer-events: none;
    transform: translateY(20px);
    transition: opacity .4s ease, transform .3s ease;
}

#scrollToTopBtn.show {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
}

#scrollToTopBtn.flying .plane-icon {
    animation: planeFlyUp 1.2s ease-out forwards;
}

@keyframes planeFlyUp {
    0% { transform: translateY(0) scale(1); opacity: 1; }
    100% { transform: translateY(-200px) scale(.4); opacity: 0; }
}

.scroll-btn-inner {
    width: 100%;
    height: 100%;
    %;
    background-color: color-mix(
        in srgb,
        var(--color-primary) 20%,
        white 80%
    );
    border: 2px solid var(--color-primary);
    box-shadow: 0 4px 12px rgba(0,0,0,.15);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
}

.scroll-btn-inner::before {
    content: "";
    position: absolute;
    bottom: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: var(--color-secondary);
    opacity: .1;
    %;
    animation: wave-rotate 6s linear infinite;
}

@keyframes wave-rotate {
    to { transform: rotate(360deg); }
}

.plane-icon {
    color: var(--color-secondary);
    font-size: 1.5rem;
    position: relative;
    z-index: 2;
}

.scroll-btn-circle {
    position: absolute;
    inset: 0;
    transform: rotate(-90deg);
}

.scroll-btn-circle svg {
    width: 100%;
    height: 100%;
    overflow: visible;
}

.scroll-progress {
    fill: none;
    stroke: var(--color-secondary);
    stroke-width: 4;
    stroke-linecap: round;
    transition: stroke-dashoffset .2s linear;
}

.scroll-btn-particles {
    position: absolute;
    inset: 0;
    pointer-events: none;
}

.energy-ring {
    position: absolute;
    border: 2px solid var(--color-secondary);
    %;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    opacity: .8;
}

.floating-cube {
    position: absolute;
    width: 10px;
    height: 10px;
    background: var(--color-secondary);
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) rotate(45deg);
    }

/* Mobile tweaks */
@media (max-width: 425px) {
    .scroll-progress { stroke-width: 3; }
    .scroll-btn-inner { border-width: 1.5px; }
    .plane-icon { font-size: 1rem; }
}
</style>

<script>
 const btn = document.getElementById("scrollToTopBtn");
const progressCircle = document.querySelector(".scroll-progress");
const particleContainer = document.querySelector(".scroll-btn-particles");

let circumference = progressCircle.getTotalLength();
progressCircle.style.strokeDasharray = circumference;
progressCircle.style.strokeDashoffset = circumference;

function createEnergyRings() {
    for (let i = 0; i < 3; i++) {
        const ring = document.createElement("div");
        ring.className = "energy-ring";

        const size = 20 + (i * 15);

        ring.style.width = size + "px";
        ring.style.height = size + "px";

        ring.animate(
            [
                {
                    width: size + "px",
                    height: size + "px",
                    opacity: .8
                },
                {
                    width: size + 80 + "px",
                    height: size + 80 + "px",
                    opacity: 0
                }
            ],
            {
                duration: 1000,
                delay: i * 120,
                easing: "ease-out"
            }
        );

        particleContainer.appendChild(ring);

        setTimeout(() => ring.remove(), 1200);
    }
}

function createFloatingCubes() {
    for (let i = 0; i < 12; i++) {
        const cube = document.createElement("div");
        cube.className = "floating-cube";

        const angle = Math.random() * Math.PI * 2;
        const distance = 70 + Math.random() * 50;

        const x = Math.cos(angle) * distance;
        const y = Math.sin(angle) * distance;

        cube.animate(
            [
                {
                    opacity: 1,
                    transform: "translate(-50%, -50%) rotate(45deg) scale(0)"
                },
                {
                    opacity: 0,
                    transform: `translate(${x}px, ${y}px) rotate(405deg) scale(1.5)`
                }
            ],
            {
                duration: 900,
                easing: "cubic-bezier(.17,.67,.25,1)"
            }
        );

        particleContainer.appendChild(cube);

        setTimeout(() => cube.remove(), 1000);
    }
}

btn.addEventListener("click", () => {
    btn.classList.add("flying");

    createEnergyRings();
    createFloatingCubes();

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

    setTimeout(() => {
        btn.classList.remove("flying");
    }, 1200);
});

function updateProgress() {
    const scrollTop = window.scrollY;
    const height =
        document.documentElement.scrollHeight - window.innerHeight;

    const progress = Math.min(1, scrollTop / height);

    progressCircle.style.strokeDashoffset =
        circumference - progress * circumference;

    btn.classList.toggle("show", scrollTop > 300);
}

window.addEventListener("scroll", updateProgress);
window.addEventListener("resize", () => {
    circumference = progressCircle.getTotalLength();
    progressCircle.style.strokeDasharray = circumference;
    updateProgress();
});

</script>