{% set c = component %}
<section class="categories-slide" id="categories-section-{{position}}">
	<div class="categories-slide-wrapper">

		<div class="categories-slide__content">
			<salla-slider id="categories-slider-{{position}}" class="categories-slider" dir="rtl" type="carousel" show-controls="false" loop="true" slider-config='{
				"slidesPerView":1.2,
				"spaceBetween":20,
				"navigation":{
					"nextEl":".categories-next-{{position}}",
					"prevEl":".categories-prev-{{position}}"
				},
				"breakpoints":{
          "0":{
            "slidesPerView":1.5
          },
          "640":{
            "slidesPerView":1.8
          },
          "1024":{
            "slidesPerView":2
          },
          "1280":{
            "slidesPerView":2.5
          }
        }
			}'>
				<div slot="items" class="swiper-wrapper">
					{% for category in c.categories_list %}
						<div class="swiper-slide categories-slide__item">
							<a href="{{category.url}}" class="categories-slide__item-link">
								<div class="categories-slide__image-wrapper">
									<img src="{{category.image}}" class="categories-slide__item-image">
								</div>
								<div class="categories-slide__item-info">
									<div>
										<h3 class="categories-slide__item-title">{{category.name}}</h3>
									</div>
									<span class="categories-slide__arrow border border-gray-300 rounded-full p-4 flex items-center justify-center">
										<i class="sicon-arrow-up-right text-[18px]"></i>
									</span>
								</div>
							</a>
						</div>
					{% endfor %}
				</div>
			</salla-slider>
		</div>

		<div class="content_cat">
			<div class="categories-slide__header">
				{% if c.block_top_brand %}
					<h4 class="categories-slide__header-top" style="color: {{ c.block_top_brand_color }}">{{ c.block_top_brand }}</h4>
				{% endif %}
				{% if c.categories_list_title %}
					<h2 class="categories-slide__header-title" style="color: {{ c.categories_list_title_color }}">{{ c.categories_list_title }}</h2>
				{% endif %}
				{% if c.categories_list_subtitle %}
					<p class="categories-slide__header-subtitle" style="color: {{ c.categories_list_subtitle_color }}">{{ c.categories_list_subtitle }}</p>
				{% endif %}

				<div class="categories-slide__nav">
					<button class="categories-prev-{{position}} group relative overflow-hidden flex items-center justify-center border border-black p-3 rounded-full transition-all duration-300 hover:bg-black">
						<span class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/40 to-transparent group-hover:translate-x-full transition-transform duration-700"></span>

						<i class="relative z-10 sicon-caret-right ltr:-scale-x-100 transition-colors duration-300 group-hover:text-white"></i>
					</button>


					<button class="categories-next-{{position}} group relative overflow-hidden flex items-center justify-center border border-black p-3 rounded-full transition-all duration-300 hover:bg-black">
						<span class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/40 to-transparent group-hover:translate-x-full transition-transform duration-700"></span>

						<i class="relative z-10 sicon-caret-left transition-colors duration-300 group-hover:text-white"></i>
					</button>

				</div>
			</div>

	</div>
</section>

<style>
.categories-slide__nav {
	display:flex;
	gap:12px;
	justify-content:center;
	margin-top:25px;
}


.categories-slide__nav button {
	width:48px;
	height:48px;
}


.categories-slide__nav button span {
	pointer-events:none;
}


.categories-slide__nav .swiper-button-disabled {
	opacity:.35;
	cursor:not-allowed;
}
  #categories-section-{{position}} {
    width: 90%;
  }
	.categories-slide {
		padding: 40px 0;
	}
	.categories-slide-wrapper {
		display: flex;
		flex-direction: row-reverse;
		align-items: center;
		gap: 40px;
		direction: ltr;
	}
	.content_cat {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		direction: rtl;
	}
	.categories-slide__header {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.categories-slide__header-top {
		font-size: 18px;
		font-weight: 700;
	}
	.categories-slide__header-title {
		font-size: 40px;
		font-weight: 800;
		line-height: 1.5;
	}
	.categories-slide__header-subtitle {
		font-size: 18px;
		line-height: 1.65;
	}
	.categories-slide__nav {
		display: flex;
		flex-direction: row;
		gap: 10px;
		direction: ltr;
	}
	.categories-slide__nav-btn {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		border: 1.5px solid #111;
		background: transparent;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #111;
		transition: background 0.25s, color 0.25s;
	}
	.categories-slide__nav-btn:hover {
		background: #111;
		color: #fff;
	}
	.categories-slide__content {
		flex: 1;
		min-width: 0;
	}
	.categories-slide__item {
		background: #fff;
		border-radius: 18px;
		overflow: hidden;
	}
	.categories-slide__item-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.categories-slide__image-wrapper {
		height: 400px;
	}
	.categories-slide__item-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
    border-radius: 20px 20px 0 0;
	}
	.categories-slide__item-info {
		padding: 18px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		direction: rtl;
	}
	.categories-slide__item-title {
		font-size: 24px;
		font-weight: 800;
	}

	@media (min-width: 1024px) {
    .content_cat {
			max-width: 25rem;
		}
	}

@media (max-width: 1024px) {

	#categories-section-{{position}} {
		width: 100%;
		padding: 0 16px;
	}

	.categories-slide-wrapper {
		flex-direction: column !important;
		align-items: stretch;
		gap: 25px;
		direction: rtl;
	}

	.content_cat {
		width: 100%;
		flex: unset;
		order: 1;
		text-align: center;
	}

	.categories-slide__content {
		width: 100%;
		flex: unset;
		order: 2;
		overflow: visible;
	}

	.categories-slide__header {
		align-items: center;
	}

	.categories-slide__header-title {
		font-size: 26px;
	}

	.categories-slide__header-subtitle {
		max-width: 320px;
	}

	.categories-slide__image-wrapper {
		height: 320px;
	}

	.categories-slide__item {
		border-radius: 18px;
	}

	.categories-slide__item-info {
		padding: 14px;
	}

}
.categories-slide__arrow {
	position: relative;
	overflow: hidden;
	transition: all 0.3s ease;
	pointer-events: none;
}

.categories-slide__item:hover .categories-slide__arrow {
	pointer-events: auto;
	background-color: #111;
	color: #fff;
}

.categories-slide__arrow::before {
	content: "";
	position: absolute;
	top: 0;
	left: -100%;
	width: 100%;
	height: 100%;
	background: linear-gradient(
		120deg,
		transparent,
		rgba(255,255,255,0.6),
		transparent
	);
	transition: all 0.5s ease;
}

.categories-slide__item:hover .categories-slide__arrow::before {
	left: 100%;
}

.categories-slide__arrow i {
	position: relative;
	z-index: 2;
}
</style>