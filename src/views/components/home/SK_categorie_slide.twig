<section class="categories-slide">
    <div class="container">
        <div class="categories-slide__header">
            {% if block_top_brand is not empty %}
                <h3 class="categories-slide__header-top" style="color: {{ block_top_brand_color }};">{{ block_top_brand }}</h3>
            {% endif %}
            {% if categories_list_title is not empty %}
                <h2 class="categories-slide__header-title" style="color: {{ categories_list_title_color }};">{{ categories_list_title }}</h2>
            {% endif %}
            {% if categories_list_subtitle is not empty %}
                <p class="categories-slide__header-subtitle" style="color: {{ categories_list_subtitle_color }};">{{ categories_list_subtitle }}</p>
            {% endif %}
        </div>
        <div class="categories-slide__content">
            {% for category in categories_list %}
                <div class="categories-slide__item">
                    <a href="{{ category.url }}" class="categories-slide__item-link">
                        <img src="{{ category.image }}" alt="{{ category.name }}" class="categories-slide__item-image">
                        <h3 class="categories-slide__item-title">{{ category.name }}</h3>
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>

</section>