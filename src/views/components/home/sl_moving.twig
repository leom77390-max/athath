<section class="dynamic-sections dynamic-sections-{{position}} mb-10 md:mb-16 {{component.mob_show ? "hidden md:block" : ""}} {{component.lapTop_show ? "md:hidden" : ""}}" data-sal="slide-left"
    data-sal-duration="1000" data-sal-delay="100" data-sal-easing="ease-out">   
    <div class="dynamic-slider-wrapper {% include 'components.custom.component_margin.twig' %}" style="background:{{component.bar_bac}}">
        <div class="dynamic-slider-track container" 
             style="--width: 200px; --quantity: {{component.add_sectionbar|length}}; --speed: 20s; --height: 72px;">  
            <div class="dynamic-slider-container flex flex-nowrap">
                {% for bar in component.add_sectionbar %}
                    <a href="{{ bar.bar_url}}" class="dynamic-slider-image" style="--position: {{loop.index}}" >
                        <img loading="lazy" src="{{ bar.bar_img }}" alt="{{ bar.name }}" />
                        <h2 style="color:{{bar.bar_title_color}}">{{bar.bar_title}}</h2>
                    </a>
                {% endfor %}
            </div>
        </div>
    </div>
</section>