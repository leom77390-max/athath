<section class="dynamic-sections dynamic-sections-{{position}} mb-10 md:mb-16 {{component.mob_show ? "hidden md:block" : ""}} {{component.lapTop_show ? "md:hidden" : ""}}">   
    <div class="dynamic-slider-wrapper" style="background:{{component.bar_bac}}">
        <div class="dynamic-slider-track container" 
             style="--width: 200px; --quantity: {{component.add_sectionbar|length}}; --speed: 20s; --height: 72px;">  
            <div class="dynamic-slider-container flex flex-nowrap">
                {% for bar in component.add_sectionbar %}
                    <a href="{{ bar.bar_url}}" class="dynamic-slider-image pb-4" style="--position: {{loop.index}}" >
                        <img loading="lazy" src="{{ bar.bar_img }}" alt="{{ bar.name }}" />
                        <h2 style="color:{{bar.bar_title_color}}">{{bar.bar_title}}</h2>
                    </a>
                {% endfor %}
            </div>
        </div>
    </div>
</section>

<style>
  .dynamic-slider-wrapper {
      width: 100%;
      margin: auto;
      border: 1px solid #000000;
  }
  .dynamic-slider-track {
      width: 100%;
      height: var(--height);
      overflow: hidden;
  }
  .dynamic-slider-container {
      min-width: calc(var(--width) * var(--quantity));
      display: flex;
      gap: 0;
      width: 100%;
      position: relative;
  }
  .dynamic-slider-image {
      display: flex;
      justify-content: center;
      align-items: center;
      position: absolute;
      left: 100%;
      width: var(--width);
      height: var(--height);
      animation: slideLeftt var(--speed) linear infinite;
      animation-delay: calc((var(--speed) / var(--quantity)) * (var(--position) - 1) - var(--speed));
      padding: 4px 0;
      gap: 10px;  
  }
  .dynamic-slider-image img {
      width: 43px;
      height: 62px;
      object-fit: cover;
  }
  .dynamic-slider-image h2 {
      margin: 0; 
      font-weight: 380;
      font-size: 16px;
  }
  @keyframes slideLeftt {
      from {
          left: 100%;
      }
      to {
          left: calc(var(--width) * -1);
      }
  }
  .dynamic-slider-wrapper:hover .dynamic-slider-image {
      animation-play-state: paused;
  }

</style>