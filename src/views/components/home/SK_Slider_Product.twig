{% set c = component %}
{% set slides_desktop = c.desktop_slides_per_view | default(2) %}
{% set slides_tablet  = c.laptop_slides_per_view  | default(1.5) %}
{% set slides_mobile  = c.mobile_slides_per_view  | default(1.2) %}
{% set autoplay       = c.enable_autoplay is same as(true) %}
{% set loop           = c.enable_loop is not same as(false) %}
{% set controls       = c.enable_controls is not same as(false) %}
 
<section class="sk-slider-product-section s-block overflow-hidden py-10" id="sk-slider-product-section-{{ position }}">

	<div class="container mx-auto">

		{% if c.product_title %}

		<div class="flex items-center justify-between">

			<h2 class="text-[clamp(1.25rem,2vw,1.75rem)] font-bold mb-6" style="color: {{ c.product_title_color }};">
				{{ c.product_title }}
			</h2>


			{% if controls %}
			<div class="flex items-center gap-2 mb-6">

				<button 
				class="bundle-back-{{position}} group relative overflow-hidden flex items-center justify-center border border-zinc-900 p-3 rounded-full transition-all duration-300 hover:bg-zinc-900 text-zinc-900 hover:text-white">

					<span class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/40 to-transparent group-hover:translate-x-full transition-transform duration-700"></span>

					<i class="relative z-10 sicon-caret-right ltr:-scale-x-100 transition-colors duration-300"></i>

				</button>


				<button 
				class="bundle-front-{{position}} group relative overflow-hidden flex items-center justify-center border border-zinc-900 p-3 rounded-full transition-all duration-300 hover:bg-zinc-900 text-zinc-900 hover:text-white">

					<span class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/40 to-transparent group-hover:translate-x-full transition-transform duration-700"></span>

					<i class="relative z-10 sicon-caret-left ltr:-scale-x-100 transition-colors duration-300"></i>

				</button>


			</div>
			{% endif %}

		</div>

		{% endif %}

	</div>


	<salla-slider id="sk-slider-product-{{ position }}" dir="{{ user.language.code == 'ar' ? 'rtl' : 'ltr' }}" class="w-full" show-controls="false" type="carousel" loop="{{ loop ? 'true' : 'false' }}" slider-config='{
		"slidesPerView": {{ slides_mobile }},
		"spaceBetween": 16,
		"breakpoints": {
			"0": {
				"slidesPerView": {{ slides_mobile }},
				"spaceBetween": 16,
				"slidesOffsetBefore": 16,
				"slidesOffsetAfter": 16
			},
			"768": {
				"slidesPerView": {{ slides_tablet }},
				"spaceBetween": 24,
				"slidesOffsetBefore": 24,
				"slidesOffsetAfter": 24
			},
			"1024": {
				"slidesPerView": {{ slides_desktop }},
				"spaceBetween": 24,
				"slidesOffsetBefore": 0,
				"slidesOffsetAfter": 0
			}
		}
		{% if controls %},
		"navigation": {
			"nextEl": ".bundle-front-{{position}}",
			"prevEl": ".bundle-back-{{position}}"
		}
		{% endif %}
		{% if autoplay %},
		"autoplay": {
			"delay": 3000,
			"disableOnInteraction": false
		}
		{% endif %}
	}'>


		<div slot="items">

			{% for product in c.store_products %}

			<a href="{{ product.url }}" class="group flex flex-col md:flex-row rtl:md:flex-row-reverse items-stretch md:items-center bg-transparent h-full gap-4 md:gap-8 transition-all duration-300 ease-out hover:-translate-y-1">

				<div class="w-full h-[300px] md:w-[45%] md:h-[480px] rounded-2xl md:rounded-[20px] flex items-center justify-center overflow-hidden flex-shrink-0 transition-all duration-300">

					<img src="{{ product.images[0].url }}" alt="{{ product.name }}" loading="lazy" class="w-full h-full object-cover block transition-transform duration-500 group-hover:scale-105">

				</div>


				<div class="flex-1 py-1 md:py-3 px-4 md:px-0 flex flex-col justify-center gap-2 md:gap-3">


					{% if product.category %}
					<span class="text-xs md:text-sm text-zinc-500 uppercase tracking-wider font-medium">
						{{ product.category.name }}
					</span>
					{% endif %}


					<h3 class="text-lg md:text-[clamp(1.2rem,1.5vw,1.75rem)] font-bold text-zinc-900 leading-[1.35] line-clamp-2 m-0">
						{{ product.name }}
					</h3>


					<div class="text-base md:text-[1.1rem] font-bold text-zinc-900 flex items-center gap-2">

						{% if product.is_on_sale %}

						<span class="text-red-600">
							{{ product.sale_price | money }}
						</span>

						<span class="text-zinc-400 line-through text-sm font-normal">
							{{ product.regular_price | money }}
						</span>

						{% else %}

						<span>
							{{ product.price | money }}
						</span>

						{% endif %}

					</div>


					{% if product.description %}
					<p class="text-sm md:text-[0.95rem] text-zinc-600 leading-[1.6] line-clamp-2 md:line-clamp-3 m-0">
						{{ product.description | striptags }}
					</p>
					{% endif %}


					<span class="sk-product-card__btn mt-2 inline-flex self-start items-center justify-center px-[26px] py-[11px] max-md:px-[18px] max-md:py-[8px] bg-zinc-900 text-white border border-zinc-900 rounded-full text-xs md:text-sm font-semibold relative overflow-hidden z-[1] box-border">
						<span>{{ user.language.code == 'ar' ? 'اشترِ هذا المنتج' : 'Shop This Product' }}</span>
					</span>


				</div>

			</a>

			{% endfor %}


		</div>

	</salla-slider>


</section>

<style>
	@media (min-width: 1024px) {
		#sk-slider-product-{{position}} {
			width: 95% !important;
			margin: 0 auto;
		}
	}

	#sk-slider-product-{{position}}.swiper-button-disabled {
		opacity: .35 !important;
		cursor: not-allowed;
	}

	#sk-slider-product-{{position}}.swiper-button-disabled svg {
		fill: #000000 !important;
		opacity: .35 !important;
	}

	.sk-product-card__btn::before,
	.sk-product-card__btn::after {
		content: "";
		position: absolute;
		inset: 0;
		transform: scaleX(0);
		transform-origin: right;
		transition: transform .5s cubic-bezier(.7,0,.3,1);
		z-index: -1;
	}

	.sk-product-card__btn::before {
		background: #ffffff;
		opacity: .3;
		transition-delay: .1s;
	}

	.sk-product-card__btn::after {
		background: #ffffff;
		transition-delay: 0s;
	}

	.sk-product-card__btn > * {
		position: relative;
		z-index: 2;
		transition: color .5s cubic-bezier(.7,0,.3,1);
	}

	@media (hover: hover) {
		.sk-product-card__btn:hover {
			color: #18181b;
			border-color: #18181b;
			transform: translateY(-2px);
			box-shadow: 0 8px 22px rgba(0, 0, 0, 0.15);
		}

		.sk-product-card__btn:hover::before,
		.sk-product-card__btn:hover::after {
			transform: scaleX(1);
			transform-origin: left;
		}

		.sk-product-card__btn:hover::before {
			transition-delay: 0s;
		}

		.sk-product-card__btn:hover::after {
			transition-delay: .1s;
		}

		.sk-product-card__btn:hover > * {
			color: #18181b !important;
		}
	}
</style>