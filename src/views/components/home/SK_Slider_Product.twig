{% set c = component %}

<section class="sk-slider-product s-block overflow-hidden" id="sk-slider-product-{{ position }}">
	<div class="container">

		{% if c.product_title %}
			<div class="flex items-center justify-between">
				<h2 class="sk-slider-title" style="color: {{ c.product_title_color }};">
					{{ c.product_title }}
				</h2>
				<div class="bundle-arrows flex items-center gap-2 mb-6">
					<button class="bundle-back-{{position}} flex items-center justify-center border border-primary p-4 rounded-full" aria-label="Previous">
						<i class="sicon-caret-right ltr:-scale-x-100"></i>
					</button>
					<button class="bundle-front-{{position}} flex items-center justify-center border border-primary p-4 rounded-full" aria-label="Next">
						<i class="sicon-caret-left ltr:-scale-x-100"></i>
					</button>
				</div>
			</div>
		{% endif %}
	</div>

	<salla-slider id="sk-slider-product-{{ position }}" show-controls="false" type="carousel"slider-config='{
        "slidesPerView": 1.2,
        "spaceBetween": 16,
        "navigation": {
          "nextEl": "#sk-slider-product-{{position}} .bundle-front-{{position}}",
          "prevEl": "#sk-slider-product-{{position}} .bundle-back-{{position}}"
        },
        "breakpoints": {
          "0": {
            "slidesPerView": 1.2,
            "spaceBetween": 16
          },
          "768": {
            "slidesPerView": 1.5,
            "spaceBetween": 24
          },
          "1024": {
            "slidesPerView": 2,
            "spaceBetween": 24
          }
        }
      }'>
		<div slot="items">
			{% for product in c.store_products %}
				<a href="{{ product.url }}" class="sk-product-card">
					<div class="sk-product-card__img">
						<img src="{{ product.images[0].url }}" alt="{{ product.name }}" loading="lazy">
					</div>
					<div class="sk-product-card__info">
						{% if product.category %}
							<span class="sk-product-card__cat">{{ product.category.name }}</span>
						{% endif %}
						<h3 class="sk-product-card__name">{{ product.name }}</h3>
						<div class="sk-product-card__price">
							{% if product.is_on_sale %}
								<span class="sk-price-sale">{{ product.sale_price | money }}</span>
								<span class="sk-price-old">{{ product.regular_price | money }}</span>
							{% else %}
								<span class="sk-price-current">{{ product.price | money }}</span>
							{% endif %}
						</div>
						{% if product.description %}
							<p class="sk-product-card__desc">{{ product.description | striptags }}</p>
						{% endif %}
						<span class="sk-product-card__btn">
							{{ user.language.code == 'ar' ? 'اشترِ هذا المنتج' : 'Shop This Product' }}
						</span>
					</div>
				</a>
			{% endfor %}
		</div>
	</salla-slider>


</section>

<style>
	#sk-slider-{{position}}{
		width: 90%;
	}
	#sk-slider-product-{{position}}.s-slider-v-centered .s-slider-block__title-nav {
		left: 6rem !important;
		top: -2rem !important;
		width: 5% !important;
	}
	#sk-slider-product-{{position}}.s-slider-v-centered .s-slider-block__title-nav button, #sk-slider-product-{{position}}.s-slider-nav-arrow {
		border: 1px solid #000000 !important;
		background: transparent !important;
		transition: all 0.3s ease;
	}

	#sk-slider-product-{{position}}.s-slider-v-centered .s-slider-block__title-nav button svg, #sk-slider-product-{{position}}.s-slider-nav-arrow svg {
		fill: #000000 !important;
		transition: fill 0.3s ease;
	}

	#sk-slider-product-{{position}}.s-slider-v-centered .s-slider-block__title-nav button:hover,
	#sk-slider-product-{{position}}.s-slider-nav-arrow:hover {
		background: #000000 !important;
	}

	#sk-slider-product-{{position}}.s-slider-v-centered .s-slider-block__title-nav button:hover svg,
	#sk-slider-product-{{position}}.s-slider-nav-arrow:hover svg {
		fill: #ffffff !important;
	}

	#sk-slider-product-{{position}}.swiper-button-disabled {
		opacity: .35 !important;
		cursor: not-allowed;
	}

	#sk-slider-product-{{position}}.swiper-button-disabled svg {
		fill: #000000 !important;
		opacity: .35 !important;
	}

	#sk-slider-product-{{position}}{
		padding: 40px 0;
	}

	.sk-slider-title {
		font-size: clamp(1.25rem, 2vw, 1.75rem);
		font-weight: 700;
		margin-bottom: 24px;
	}

	.sk-product-card {
		display: flex !important;
		align-items: stretch;
		background: #f4f4f5;
		border-radius: 16px;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		height: 100%;
		transition: box-shadow 0.3s;
	}

	.sk-product-card:hover {
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.10);
	}

	.sk-product-card__img {
		flex: 0 0 45%;
		max-width: 45%;
		overflow: hidden;
		background: #e4e4e7;
	}

	.sk-product-card__img img {
		width: 100%;
		height: 100%;
		min-height: 500px;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}

	.sk-product-card:hover .sk-product-card__img img {
		transform: scale(1.04);
	}

	.sk-product-card__info {
		flex: 1;
		padding: 28px 24px;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 10px;
	}

	.sk-product-card__cat {
		font-size: 1.25rem;
		color: #71717a;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		font-weight: 500;
	}

	.sk-product-card__name {
		font-size: clamp(1.1rem, 1.4vw, 4rem);
		font-weight: 700;
		color: #18181b;
		line-height: 1.3;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.sk-product-card__price {
		font-size: 1.05rem;
		font-weight: 700;
		color: #18181b;
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.sk-price-sale {
		color: #18181b;
	}
	.sk-price-old {
		color: #a1a1aa;
		font-size: 0.875rem;
		font-weight: 400;
		text-decoration: line-through;
	}

	.sk-product-card__desc {
		font-size: 1.25rem;
		color: #52525b;
		line-height: 1.6;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.sk-product-card__btn {
		margin-top: 8px;
		display: inline-block;
		align-self: flex-start;
		padding: 11px 26px;
		background: #18181b;
		color: #fff;
		border-radius: 999px;
		font-size: 0.875rem;
		font-weight: 600;
		transition: opacity 0.2s;
	}

	.sk-product-card:hover .sk-product-card__btn {
		opacity: 0.8;
	}

	[dir="rtl"] .sk-product-card {
		flex-direction: row-reverse;
	}

	@media(max-width: 767px) {
		.sk-product-card__img img {
			min-height: 180px;
		}
		.sk-product-card__info {
			padding: 18px 14px;
		}
		#sk-slider-product-{{position}}{
			width: 100%;
		}
	}
</style>
