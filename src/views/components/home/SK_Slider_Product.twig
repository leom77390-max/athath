{% set c = component %}
{% set slides_desktop = c.desktop_slides_per_view | default(2) %}
{% set slides_tablet  = c.laptop_slides_per_view  | default(1.5) %}
{% set slides_mobile  = c.mobile_slides_per_view  | default(1.2) %}
{% set autoplay       = c.enable_autoplay is same as(true) %}
{% set loop           = c.enable_loop is not same as(false) %}
{% set controls       = c.enable_controls is not same as(false) %}
 
<section class="sk-slider-product s-block overflow-hidden" id="sk-slider-product-{{ position }}">

	<div class="container">

		{% if c.product_title %}

		<div class="flex items-center justify-between">

			<h2 class="sk-slider-title" style="color: {{ c.product_title_color }};">
				{{ c.product_title }}
			</h2>


			{% if controls %}
			<div class="bundle-arrows flex items-center gap-2 mb-6">

				<button 
				class="bundle-back-{{position}} group relative overflow-hidden flex items-center justify-center border border-black p-3 rounded-full transition-all duration-300 hover:bg-black">

					<span class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/40 to-transparent group-hover:translate-x-full transition-transform duration-700"></span>

					<i class="relative z-10 sicon-caret-right ltr:-scale-x-100 transition-colors duration-300 group-hover:text-white"></i>

				</button>


				<button 
				class="bundle-front-{{position}} group relative overflow-hidden flex items-center justify-center border border-black p-3 rounded-full transition-all duration-300 hover:bg-black">

					<span class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/40 to-transparent group-hover:translate-x-full transition-transform duration-700"></span>

					<i class="relative z-10 sicon-caret-left ltr:-scale-x-100 transition-colors duration-300 group-hover:text-white"></i>

				</button>


			</div>
			{% endif %}

		</div>

		{% endif %}

	</div>


	<salla-slider id="sk-slider-product-{{ position }}" show-controls="false" type="carousel" loop="{{ loop ? 'true' : 'false' }}" slider-config='{
		"slidesPerView": {{ slides_mobile }},
		"spaceBetween": 16,
		"breakpoints": {
			"0": {
				"slidesPerView": {{ slides_mobile }},
				"spaceBetween": 16
			},
			"768": {
				"slidesPerView": {{ slides_tablet }},
				"spaceBetween": 24
			},
			"1024": {
				"slidesPerView": {{ slides_desktop }},
				"spaceBetween": 24
			}
		}
		{% if controls %},
		"navigation": {
			"nextEl": ".bundle-front-{{position}}",
			"prevEl": ".bundle-back-{{position}}"
		}
		{% endif %}
		{% if autoplay %},
		"autoplay": {
			"delay": 3000,
			"disableOnInteraction": false
		}
		{% endif %}
	}'>


		<div slot="items">

			{% for product in c.store_products %}

			<a href="{{ product.url }}" class="sk-product-card">

				<div class="sk-product-card__img">

					<img src="{{ product.images[0].url }}" alt="{{ product.name }}" loading="lazy">

				</div>


				<div class="sk-product-card__info">


					{% if product.category %}
					<span class="sk-product-card__cat">
						{{ product.category.name }}
					</span>
					{% endif %}


					<h3 class="sk-product-card__name">
						{{ product.name }}
					</h3>


					<div class="sk-product-card__price">

						{% if product.is_on_sale %}

						<span class="sk-price-sale">
							{{ product.sale_price | money }}
						</span>

						<span class="sk-price-old">
							{{ product.regular_price | money }}
						</span>

						{% else %}

						<span class="sk-price-current">
							{{ product.price | money }}
						</span>

						{% endif %}

					</div>


					{% if product.description %}
					<p class="sk-product-card__desc">
						{{ product.description | striptags }}
					</p>
					{% endif %}


					<span class="sk-product-card__btn">
						<span>{{ user.language.code == 'ar' ? 'اشترِ هذا المنتج' : 'Shop This Product' }}</span>
					</span>


				</div>

			</a>

			{% endfor %}


		</div>

	</salla-slider>


</section>

<style>
	#sk-slider-product-{{position}} {
		width: 90%;
	}

	#sk-slider-product-{{position}}.s-slider-v-centered .s-slider-block__title-nav {
		left: 6rem !important;
		top: -2rem !important;
		width: 5% !important;
	}

	#sk-slider-product-{{position}}.s-slider-v-centered .s-slider-block__title-nav button,
	#sk-slider-product-{{position}}.s-slider-nav-arrow {
		border: 1px solid #000000 !important;
		background: transparent !important;
		transition: all 0.3s ease;
	}

	#sk-slider-product-{{position}}.s-slider-v-centered .s-slider-block__title-nav button svg,
	#sk-slider-product-{{position}}.s-slider-nav-arrow svg {
		fill: #000000 !important;
		transition: fill 0.3s ease;
	}

	#sk-slider-product-{{position}}.s-slider-v-centered .s-slider-block__title-nav button:hover,
	#sk-slider-product-{{position}}.s-slider-nav-arrow:hover {
		background: #000000 !important;
	}

	#sk-slider-product-{{position}}.s-slider-v-centered .s-slider-block__title-nav button:hover svg,
	#sk-slider-product-{{position}}.s-slider-nav-arrow:hover svg {
		fill: #ffffff !important;
	}

	#sk-slider-product-{{position}}.swiper-button-disabled {
		opacity: .35 !important;
		cursor: not-allowed;
	}

	#sk-slider-product-{{position}}.swiper-button-disabled svg {
		fill: #000000 !important;
		opacity: .35 !important;
	}

	#sk-slider-product-{{position}} {
		padding: 40px 0;
	}

	.sk-slider-title {
		font-size: clamp(1.25rem, 2vw, 1.75rem);
		font-weight: 700;
		margin-bottom: 24px;
	}

	.sk-product-card {
		display: flex !important;
		align-items: center;
		background: transparent;
		text-decoration: none;
		color: inherit;
		height: 100%;
		gap: 32px;
		transition: transform 0.3s ease;
	}

	.sk-product-card__img {
		flex: 0 0 45%;
		max-width: 45%;
		height: 480px;
		overflow: hidden;
		border-radius: 20px;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 32px;
		transition: box-shadow 0.3s ease, transform 0.3s ease;
	}

	.sk-product-card__img img {
		width: 100%;
		height: 480px;
		object-fit: cover;
		display: block;
		mix-blend-mode: multiply;
		transition: transform 0.4s ease;
	}
 
	.sk-product-card__info {
		flex: 1;
		padding: 12px 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 12px;
	}

	.sk-product-card__cat {
		font-size: 0.875rem;
		color: #71717a;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-weight: 500;
	}

	.sk-product-card__name {
		font-size: clamp(1.2rem, 1.5vw, 1.75rem);
		font-weight: 700;
		color: #18181b;
		line-height: 1.35;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.sk-product-card__price {
		font-size: 1.1rem;
		font-weight: 700;
		color: #18181b;
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.sk-price-sale {
		color: #dc2626;
	}

	.sk-price-old {
		color: #a1a1aa;
		font-size: 0.9rem;
		font-weight: 400;
		text-decoration: line-through;
	}

	.sk-product-card__desc {
		font-size: 0.95rem;
		color: #52525b;
		line-height: 1.6;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.sk-product-card__btn {
		margin-top: 8px;
		display: inline-flex;
		align-self: flex-start;
		align-items: center;
		justify-content: center;
		padding: 11px 26px;
		background: #18181b;
		color: #ffffff;
		border: 1px solid #18181b;
		border-radius: 999px;
		font-size: 0.875rem;
		font-weight: 600;
		position: relative;
		overflow: hidden;
		transition:
			color .45s cubic-bezier(.7,0,.3,1),
			border-color .35s ease,
			transform .25s,
			box-shadow .25s;
		z-index: 1;
		box-sizing: border-box;
	}

	.sk-product-card__btn::before,
	.sk-product-card__btn::after {
		content: "";
		position: absolute;
		inset: 0;
		transform: scaleX(0);
		transform-origin: right;
		transition: transform .5s cubic-bezier(.7,0,.3,1);
		z-index: -1;
	}

	.sk-product-card__btn::before {
		background: #ffffff;
		opacity: .3;
		transition-delay: .1s;
	}

	.sk-product-card__btn::after {
		background: #ffffff;
		transition-delay: 0s;
	}

	.sk-product-card__btn > * {
		position: relative;
		z-index: 2;
		transition: color .5s cubic-bezier(.7,0,.3,1);
	}

	@media (hover: hover) {
		.sk-product-card__btn:hover {
			color: #18181b;
			border-color: #18181b;
			transform: translateY(-2px);
			box-shadow: 0 8px 22px rgba(0, 0, 0, 0.15);
		}

		.sk-product-card__btn:hover::before,
		.sk-product-card__btn:hover::after {
			transform: scaleX(1);
			transform-origin: left;
		}

		.sk-product-card__btn:hover::before {
			transition-delay: 0s;
		}

		.sk-product-card__btn:hover::after {
			transition-delay: .1s;
		}

		.sk-product-card__btn:hover > * {
			color: #18181b !important;
		}
	}

	[dir="rtl"] .sk-product-card {
		flex-direction: row-reverse;
	}

	@media(max-width: 1024px) {
		#sk-slider-product-{{position}} {
			width: 100%;
		}

		.sk-product-card__img {
			height: 400px;
		}
	}

	@media(max-width: 767px) {
		.sk-product-card {
			flex-direction: column !important;
			align-items: stretch;
			gap: 16px;
		}

		.sk-product-card__img {
			flex: 0 0 100%;
			max-width: 100%;
			height: 300px;
			background: #f4f4f5;
			padding: 24px;
			border-radius: 16px;
		}

		.sk-product-card__img img {
			min-height: auto;
		}

		.sk-product-card__info {
			padding: 4px 0;
			gap: 8px;
		}

		.sk-product-card__cat {
			font-size: 0.75rem;
		}

		.sk-product-card__name {
			font-size: 1.1rem;
		}

		.sk-product-card__price {
			font-size: 1rem;
		}

		.sk-product-card__desc {
			font-size: 0.875rem;
			-webkit-line-clamp: 2;
		}

		.sk-product-card__btn {
			padding: 8px 18px;
			font-size: 0.75rem;
		}
	}
</style>