{% set c = component %}

<section class="sk-slider-product s-block" id="sk-slider-product-{{ position }}">
  <div class="container">

    {% if c.product_title %}
      <h2 class="sk-slider-title" style="color: {{ c.product_title_color }};">
        {{ c.product_title }}
      </h2>
    {% endif %}

    <salla-products-slider
      source="categories"
      source-value="{{ c.store_products|json_encode }}"
      slider-id="sk-slider-{{ position }}"
      limit="12"
    ></salla-products-slider>

  </div>
</section>

<style>
#sk-slider-product-{{ position }} {
  padding: 40px 0;
}

.sk-slider-title {
  font-size: clamp(1.25rem, 2vw, 1.75rem);
  font-weight: 700;
  margin-bottom: 24px;
}
</style>
