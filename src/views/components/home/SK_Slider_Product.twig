{% set c = component %}

<section class="sk-slider-product s-block" id="sk-slider-product-{{ position }}">
  <div class="container">

    <!-- Header -->
    <div class="sk-slider-product__header">
      {% if c.product_title %}
        <h2 class="sk-slider-product__title" style="color: {{ c.product_title_color }};">
          {{ c.product_title }}
        </h2>
      {% endif %}

      <!-- Navigation Arrows -->
      <div class="sk-slider-product__nav">
        <button class="sk-nav-btn sk-nav-btn--prev" id="sk-prev-{{ position }}" aria-label="Previous">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>
        <button class="sk-nav-btn sk-nav-btn--next" id="sk-next-{{ position }}" aria-label="Next">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Slider Wrapper -->
    <div class="sk-slider-product__wrapper">
      <div class="sk-slider-product__track" id="sk-track-{{ position }}">

        {% for cat in c.store_products %}
          <!-- Ø³ÙŠØªÙ… ØªØ­Ù…ÙŠÙ„ Ø§Ù„Ù…Ù†ØªØ¬Ø§Øª Ø¯ÙŠÙ†Ø§Ù…ÙŠÙƒÙŠÙ‹Ø§ Ø¨Ø§Ù„Ø¬Ø§ÙØ§Ø³ÙƒØ±ÙŠØ¨Øª -->
          <div class="sk-slide-placeholder" data-category-id="{{ cat }}" data-position="{{ position }}"></div>
        {% endfor %}

      </div>
    </div>

  </div>
</section>

<style>
/* ===== SECTION ===== */
#sk-slider-product-{{ position }} {
  padding: 40px 0;
}

/* ===== HEADER ===== */
.sk-slider-product__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32px;
}

.sk-slider-product__title {
  font-size: clamp(1.25rem, 2vw, 1.75rem);
  font-weight: 700;
  margin: 0;
}

/* ===== NAV BUTTONS ===== */
.sk-slider-product__nav {
  display: flex;
  gap: 8px;
}

.sk-nav-btn {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1.5px solid #e4e4e7;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: #18181b;
  transition: background 0.2s, border-color 0.2s;
}

.sk-nav-btn:hover {
  background: #f4f4f5;
  border-color: #a1a1aa;
}

/* ===== SLIDER TRACK ===== */
.sk-slider-product__wrapper {
  overflow: hidden;
}

.sk-slider-product__track {
  display: flex;
  gap: 24px;
  transition: transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1);
  will-change: transform;
}

/* ===== SLIDE / CARD ===== */
.sk-product-card {
  flex: 0 0 calc(50% - 12px);
  min-width: calc(50% - 12px);
  background: #f4f4f5;
  border-radius: 16px;
  overflow: hidden;
  display: flex;
  align-items: stretch;
  gap: 0;
  text-decoration: none;
  color: inherit;
  transition: box-shadow 0.3s;
}

.sk-product-card:hover {
  box-shadow: 0 8px 32px rgba(0,0,0,0.10);
}

/* Image Side */
.sk-product-card__img-wrap {
  flex: 0 0 45%;
  max-width: 45%;
  background: #ececec;
  border-radius: 16px;
  overflow: hidden;
  position: relative;
}

.sk-product-card__img-wrap img {
  width: 100%;
  height: 100%;
  min-height: 260px;
  object-fit: cover;
  display: block;
  transition: transform 0.4s ease;
}

.sk-product-card:hover .sk-product-card__img-wrap img {
  transform: scale(1.04);
}

/* Info Side */
.sk-product-card__info {
  flex: 1;
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12px;
}

.sk-product-card__category {
  font-size: 0.78rem;
  color: #71717a;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 500;
}

.sk-product-card__name {
  font-size: clamp(1.1rem, 1.5vw, 1.45rem);
  font-weight: 700;
  color: #18181b;
  line-height: 1.3;
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.sk-product-card__price {
  font-size: 1.1rem;
  font-weight: 700;
  color: #18181b;
}

.sk-product-card__desc {
  font-size: 0.875rem;
  color: #52525b;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin: 0;
}

.sk-product-card__btn {
  display: inline-block;
  margin-top: 8px;
  padding: 12px 28px;
  background: #18181b;
  color: #fff;
  border-radius: 999px;
  font-size: 0.875rem;
  font-weight: 600;
  text-align: center;
  border: none;
  cursor: pointer;
  transition: opacity 0.2s;
  text-decoration: none;
  align-self: flex-start;
}

.sk-product-card__btn:hover {
  opacity: 0.82;
}

/* ===== SKELETON LOADER ===== */
.sk-skeleton {
  flex: 0 0 calc(50% - 12px);
  min-width: calc(50% - 12px);
  background: #f4f4f5;
  border-radius: 16px;
  height: 260px;
  overflow: hidden;
  position: relative;
}

.sk-skeleton::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.6) 50%, transparent 100%);
  animation: sk-shimmer 1.4s infinite;
  background-size: 200% 100%;
}

@keyframes sk-shimmer {
  0%   { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

/* ===== RESPONSIVE ===== */
@media (max-width: 767px) {
  .sk-product-card {
    flex: 0 0 calc(100% - 0px);
    min-width: calc(100% - 0px);
  }
  .sk-skeleton {
    flex: 0 0 100%;
    min-width: 100%;
  }
  .sk-product-card__img-wrap img {
    min-height: 200px;
  }
  .sk-product-card__info {
    padding: 20px 16px;
  }
}

/* ===== RTL support ===== */
[dir="rtl"] .sk-product-card {
  flex-direction: row-reverse;
}
</style>

<script defer>
(() => {

  const POSITION = "{{ position }}";
  const LANG     = "{{ user.language.code }}";
  const LABELS   = {
    shop: LANG === 'ar' ? 'ØªØ³ÙˆÙ‚ Ø§Ù„Ø¢Ù†' : 'Shop This Product',
  };

  /* ---- helpers ---- */
  function money(val) {
    try { return salla.money(val); } catch { return val; }
  }

  function buildCard(product) {
    const categoryName = product.category?.name || '';
    const imgUrl       = product.image?.url || '';
    const desc         = product.description
      ? product.description.replace(/<[^>]*>/g, '')
      : '';

    return `
      <a href="${product.url}" class="sk-product-card">
        <div class="sk-product-card__img-wrap">
          <img src="${imgUrl}" alt="${product.name}" loading="lazy">
        </div>
        <div class="sk-product-card__info">
          ${categoryName ? `<span class="sk-product-card__category">${categoryName}</span>` : ''}
          <h3 class="sk-product-card__name">${product.name}</h3>
          <div class="sk-product-card__price">${money(product.price)}</div>
          ${desc ? `<p class="sk-product-card__desc">${desc}</p>` : ''}
          <span class="sk-product-card__btn">${LABELS.shop}</span>
        </div>
      </a>
    `;
  }

  function buildSkeleton(n) {
    return Array.from({ length: n }, () => `<div class="sk-skeleton"></div>`).join('');
  }

  /* ---- slider logic ---- */
  function initSlider(section) {
    const track    = section.querySelector(`#sk-track-${POSITION}`);
    const prevBtn  = section.querySelector(`#sk-prev-${POSITION}`);
    const nextBtn  = section.querySelector(`#sk-next-${POSITION}`);

    if (!track) return;

    let currentIndex = 0;

    function getVisible() {
      return window.innerWidth < 768 ? 1 : 2;
    }

    function getCards() {
      return [...track.querySelectorAll('.sk-product-card')];
    }

    function go(dir) {
      const cards   = getCards();
      const visible = getVisible();
      const max     = Math.max(0, cards.length - visible);
      currentIndex  = Math.min(Math.max(currentIndex + dir, 0), max);
      const cardW   = cards[0]?.offsetWidth || 0;
      const gap     = 24;
      track.style.transform = `translateX(${LANG === 'ar' ? '' : '-'}${currentIndex * (cardW + gap)}px)`;
      prevBtn && (prevBtn.disabled = currentIndex === 0);
      nextBtn && (nextBtn.disabled = currentIndex >= max);
    }

    prevBtn?.addEventListener('click', () => go(-1));
    nextBtn?.addEventListener('click', () => go(1));
    window.addEventListener('resize', () => go(0));
    go(0);
  }

  /* ---- fetch products by category ---- */
  async function loadProducts(section) {
    const placeholders = [...section.querySelectorAll('.sk-slide-placeholder')];
    const track        = section.querySelector(`#sk-track-${POSITION}`);

    if (!placeholders.length || !track) return;

    // show skeletons while loading
    track.innerHTML = buildSkeleton(4);

    const allCards = [];

    await Promise.all(placeholders.map(async (ph) => {
      const catId = ph.dataset.categoryId;
      if (!catId) return;

      try {
        const res = await salla.api.get(`/api/products?source=categories&source_value=[${catId}]&limit=12`);
        const products = res?.data?.products || res?.data || [];

        products.forEach(product => {
          allCards.push(buildCard(product));
        });
      } catch (err) {
        console.error('SK Slider: failed to load category', catId, err);
      }
    }));

    track.innerHTML = allCards.length
      ? allCards.join('')
      : `<p style="color:#71717a;padding:16px;">{{ user.language.code == 'ar' ? 'Ù„Ø§ ØªÙˆØ¬Ø¯ Ù…Ù†ØªØ¬Ø§Øª' : 'No products found' }}</p>`;

    initSlider(section);
  }

  /* ---- boot ---- */
  salla.onReady(async () => {
    const section = document.querySelector(`#sk-slider-product-${POSITION}`);
    if (!section) return;
    await loadProducts(section);
  });

})();
</script>
