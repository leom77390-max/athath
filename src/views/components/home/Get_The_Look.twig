{% set gl = component %}
{% set section_id = 'gtl-' ~ component.id %}

<section class="get-the-look-section w-full relative" id="{{ section_id }}">
    {#
        Layout: 2 columns CSS Grid
        Left  → text list (sets the height naturally)
        Right → image panel (absolute, fills 100% of section height)
    #}
    <div class="relative w-full flex flex-col lg:grid lg:grid-cols-2 lg:min-h-[600px]">

        {# ── LEFT: Text List ──────────────────────────────── #}
        <div class="relative z-10 w-full flex flex-col justify-center py-16 px-8 md:px-16 lg:px-20 xl:px-28"
             style="background-color: {{ gl.right_bg_color|default('#f9f6f0') }};">

            {% if gl.subheading %}
                <span class="block font-sans text-xs md:text-sm uppercase tracking-[0.25em] mb-10 md:mb-16 opacity-60">
                    {{ gl.subheading }}
                </span>
            {% endif %}

            {% if gl.looks %}
                <ul class="flex flex-col divide-y divide-black/10">
                    {% for look in gl.looks %}
                        <li>
                            <button
                                type="button"
                                class="gtl-trigger group w-full text-start flex items-start gap-2 md:gap-3 relative py-6 md:py-8 {% if loop.first %}is-active{% endif %}"
                                data-index="{{ loop.index0 }}"
                                data-section="{{ section_id }}"
                            >
                                <span class="font-serif text-4xl md:text-5xl lg:text-6xl xl:text-[4.5rem] leading-none transition-all duration-300
                                             group-[.is-active]:opacity-100 group-[.is-active]:translate-x-2
                                             opacity-30 translate-x-0 group-hover:opacity-100 group-hover:translate-x-2
                                             rtl:translate-x-0 rtl:group-[.is-active]:-translate-x-2 rtl:group-hover:-translate-x-2">
                                    {{ look.list_title }}
                                </span>
                                {% if look.list_number %}
                                    <sup class="font-sans text-[0.65rem] mt-2 lg:mt-3 transition-opacity duration-300
                                                group-[.is-active]:opacity-100 opacity-30 group-hover:opacity-100">
                                        {{ look.list_number }}
                                    </sup>
                                {% endif %}

                                {# Underline animation #}
                                <span class="absolute bottom-0 start-0 h-px bg-black transition-all duration-500
                                             w-0 group-[.is-active]:w-full group-hover:w-full"></span>
                            </button>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        {# ── RIGHT: Image Panel (full height of section) ──── #}
        <div class="relative w-full h-[55vw] lg:h-auto lg:absolute lg:inset-y-0 lg:end-0 lg:w-1/2 overflow-hidden">
            {% if gl.looks %}
                {% for look in gl.looks %}
                    <div class="gtl-image-panel absolute inset-0 w-full h-full transition-opacity duration-700 {% if loop.first %}opacity-100{% else %}opacity-0{% endif %}"
                         data-panel-index="{{ loop.index0 }}"
                         data-section="{{ section_id }}">

                        {# Image #}
                        {% if look.slider_image %}
                            <img src="{{ look.slider_image }}"
                                 alt="{{ look.overlay_title|striptags }}"
                                 class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] scale-100 gtl-img-zoom"
                                 loading="lazy">
                        {% endif %}

                        {# Gradient overlay for text readability #}
                        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent z-10"></div>

                        {# Overlay text at the bottom #}
                        <div class="absolute bottom-10 start-10 end-10 z-20 text-white transition-all duration-700
                                    {% if loop.first %}opacity-100 translate-y-0{% else %}opacity-0 translate-y-4{% endif %} gtl-overlay-text">
                            {% if look.overlay_title %}
                                <h3 class="font-serif text-3xl md:text-4xl lg:text-5xl uppercase mb-4 leading-tight">
                                    {{ look.overlay_title }}
                                </h3>
                            {% endif %}
                            {% if look.button_text %}
                                <a href="{{ look.button_url|default('#') }}"
                                   class="inline-flex items-center gap-2 font-sans text-xs uppercase tracking-widest pb-1 border-b border-white/50 hover:border-white transition-colors">
                                    {{ look.button_text }}
                                    <i class="sicon-arrow-top-right rtl:-scale-x-100"></i>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>

    </div>
</section>

<style>
    .gtl-img-zoom {
        transition: transform 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .gtl-image-panel.is-active .gtl-img-zoom {
        transform: scale(1.06);
    }
    .gtl-image-panel.is-active .gtl-overlay-text {
        opacity: 1;
        transform: translateY(0);
    }
    .gtl-image-panel:not(.is-active) .gtl-overlay-text {
        opacity: 0;
        transform: translateY(1rem);
    }
</style>

<script defer>
document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('.get-the-look-section');

    sections.forEach(section => {
        const sectionId = section.id;
        const triggers = section.querySelectorAll(`.gtl-trigger[data-section="${sectionId}"]`);
        const panels   = section.querySelectorAll(`.gtl-image-panel[data-section="${sectionId}"]`);

        // Set first panel as active visually
        if (panels[0]) panels[0].classList.add('is-active');

        triggers.forEach(trigger => {
            trigger.addEventListener('mouseenter', function () {
                const index = parseInt(this.dataset.index);

                // Update trigger active state
                triggers.forEach(t => t.classList.remove('is-active'));
                this.classList.add('is-active');

                // Crossfade image panels
                panels.forEach((panel, i) => {
                    if (i === index) {
                        panel.classList.add('is-active');
                        panel.style.opacity = '1';
                        panel.style.zIndex  = '1';
                    } else {
                        panel.classList.remove('is-active');
                        panel.style.opacity = '0';
                        panel.style.zIndex  = '0';
                    }
                });
            });
        });
    });
});
</script>
