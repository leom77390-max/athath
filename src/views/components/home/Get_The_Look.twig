{% set gl = component %}
{% set section_id = 'gtl-' ~ component.id %}

{#
    gtl_source_mode: dropdown-list → "manual" or "auto"
    If "auto", categories come from component.gtl_categories_list (Salla source: categories)
    Each manual look can also have extra_images for image pagination.
#}
{% set _mode_raw   = gl.gtl_source_mode %}
{% set source_mode = _mode_raw is iterable ? _mode_raw | first : _mode_raw %}
{% set source_mode = source_mode | default('manual') %}

<section class="get-the-look-section w-full" id="{{ section_id }}">

    <div class="gtl-wrapper" id="{{ section_id }}-wrapper">

        {# ── LEFT: Text List ─────────────────────────────── #}
        <div class="gtl-left" style="background-color: {{ gl.right_bg_color|default('#f9f6f0') }};">

            {% if gl.subheading %}
                <span class="gtl-subheading">{{ gl.subheading }}</span>
            {% endif %}

            {# ── MANUAL MODE ── #}
            {% if source_mode == 'manual' and gl.looks %}
                <ul class="gtl-list">
                    {% for look in gl.looks %}
                        <li class="gtl-list-item">
                            <button
                                type="button"
                                class="gtl-trigger {% if loop.first %}is-active{% endif %}"
                                data-index="{{ loop.index0 }}"
                                data-section="{{ section_id }}"
                            >
                                <span class="gtl-title-text">{{ look.list_title }}</span>
                                {% if look.list_number %}
                                    <sup class="gtl-number">{{ look.list_number }}</sup>
                                {% endif %}
                                <span class="gtl-underline"></span>
                            </button>
                        </li>
                    {% endfor %}
                </ul>

            {# ── AUTO MODE ── #}
            {% elseif source_mode == 'auto' and gl.gtl_categories_list %}
                <ul class="gtl-list">
                    {% for cat in gl.gtl_categories_list %}
                        <li class="gtl-list-item">
                            <button
                                type="button"
                                class="gtl-trigger {% if loop.first %}is-active{% endif %}"
                                data-index="{{ loop.index0 }}"
                                data-section="{{ section_id }}"
                            >
                                <span class="gtl-title-text">{{ cat.name }}</span>
                                <sup class="gtl-number">{{ '%02d'|format(loop.index) }}</sup>
                                <span class="gtl-underline"></span>
                            </button>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}

        </div>

        {# ── RIGHT: Image Panel ───────────────────────────── #}
        <div class="gtl-right">

            {# ── MANUAL MODE PANELS ── #}
            {% if source_mode == 'manual' and gl.looks %}
                {% for look in gl.looks %}
                    {# Build full image list: main + up to 4 extra flat image fields #}
                    {% set all_images = [] %}
                    {% if look.slider_image %}
                        {% set all_images = all_images | merge([look.slider_image]) %}
                    {% endif %}
                    {% if look.image_2 %}{% set all_images = all_images | merge([look.image_2]) %}{% endif %}
                    {% if look.image_3 %}{% set all_images = all_images | merge([look.image_3]) %}{% endif %}
                    {% if look.image_4 %}{% set all_images = all_images | merge([look.image_4]) %}{% endif %}
                    {% if look.image_5 %}{% set all_images = all_images | merge([look.image_5]) %}{% endif %}

                    <div class="gtl-panel {% if loop.first %}is-active{% endif %}"
                         data-panel-index="{{ loop.index0 }}"
                         data-section="{{ section_id }}">

                        {# Pagination image slides #}
                        {% if all_images | length > 0 %}
                            <div class="gtl-slides" data-slide-current="0">
                                {% for img in all_images %}
                                    <div class="gtl-slide {% if loop.first %}is-active{% endif %}" data-slide-index="{{ loop.index0 }}">
                                        <img src="{{ img }}"
                                             alt="{{ look.overlay_title|striptags }}"
                                             class="gtl-panel-img"
                                             loading="lazy">
                                    </div>
                                {% endfor %}
                            </div>

                            {# Pagination dots — only if more than 1 image #}
                            {% if all_images | length > 1 %}
                                <div class="gtl-pagination">
                                    {% for img in all_images %}
                                        <button
                                            type="button"
                                            class="gtl-dot {% if loop.first %}is-active{% endif %}"
                                            aria-label="Slide {{ loop.index }}"
                                            data-dot="{{ loop.index0 }}"
                                        ></button>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        {% endif %}

                        <div class="gtl-panel-gradient"></div>

                        <div class="gtl-panel-content">
                            {% if look.overlay_title %}
                                <h3 class="gtl-panel-title">{{ look.overlay_title }}</h3>
                            {% endif %}
                            {% if look.button_text %}
                                {% include 'components.custom.special_button' with {
                                    text: look.button_text,
                                    url: look.button_url|default('#'),
                                    color: '#ffffff',
                                    class: 'gtl-panel-btn'
                                } %}
                            {% endif %}
                        </div>

                    </div>
                {% endfor %}

            {# ── AUTO MODE PANELS ── #}
            {% elseif source_mode == 'auto' and gl.gtl_categories_list %}
                {% for cat in gl.gtl_categories_list %}
                    <div class="gtl-panel {% if loop.first %}is-active{% endif %}"
                         data-panel-index="{{ loop.index0 }}"
                         data-section="{{ section_id }}">

                        {% if cat.image %}
                            <div class="gtl-slides" data-slide-current="0">
                                <div class="gtl-slide is-active" data-slide-index="0">
                                    <img src="{{ cat.image }}"
                                         alt="{{ cat.name }}"
                                         class="gtl-panel-img"
                                         loading="lazy">
                                </div>
                            </div>
                        {% endif %}

                        <div class="gtl-panel-gradient"></div>

                        <div class="gtl-panel-content">
                            <h3 class="gtl-panel-title">{{ cat.name }}</h3>
                            <a href="{{ cat.url | default('#') }}" class="gtl-panel-btn special-btn">
                                {{ gl.subheading ? gl.subheading : 'SHOP COLLECTION' }}
                            </a>
                        </div>

                    </div>
                {% endfor %}
            {% endif %}

        </div>

    </div>
</section>

<style>
/* ── Wrapper ────────────────────────────────────────── */
.get-the-look-section #{{ section_id }}-wrapper {
    display: flex;
    width: 100%;
    min-height: 500px;
    flex-direction: column;
}

@media (min-width: 1024px) {
    .get-the-look-section #{{ section_id }}-wrapper {
        flex-direction: row;
        min-height: 600px;
    }
}

/* ── LEFT column ───────────────────────────────────── */
.get-the-look-section .gtl-left {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 2rem;
    width: 100%;
}

@media (min-width: 768px) { .get-the-look-section .gtl-left { padding: 5rem 4rem; } }
@media (min-width: 1024px) { .get-the-look-section .gtl-left { width: 50%; padding: 5rem 5rem; } }
@media (min-width: 1280px) { .get-the-look-section .gtl-left { padding: 6rem 6rem; } }

/* ── RIGHT column ──────────────────────────────────── */
.get-the-look-section .gtl-right {
    position: relative;
    width: 100%;
    height: 60vw;
    overflow: hidden;
    flex-shrink: 0;
}

@media (min-width: 1024px) {
    .get-the-look-section .gtl-right {
        width: 50%;
        height: auto;
        align-self: stretch;
    }
}

/* ── Image panels ──────────────────────────────────── */
.get-the-look-section .gtl-panel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.7s ease;
    z-index: 0;
}
.get-the-look-section .gtl-panel.is-active {
    opacity: 1;
    z-index: 1;
}

/* ── Slides (image pagination inside each panel) ──── */
.get-the-look-section .gtl-slides {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
}
.get-the-look-section .gtl-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.6s ease;
}
.get-the-look-section .gtl-slide.is-active {
    opacity: 1;
}

.get-the-look-section .gtl-panel-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform: scale(1);
}
.get-the-look-section .gtl-panel.is-active .gtl-slide.is-active .gtl-panel-img {
    transform: scale(1.06);
}
.get-the-look-section .gtl-panel-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.1) 50%, transparent 100%);
    z-index: 2;
}
.get-the-look-section .gtl-panel-content {
    position: absolute;
    bottom: 2.5rem;
    left: 2.5rem;
    right: 2.5rem;
    z-index: 3;
    color: #fff;
    transition: opacity 0.7s ease, transform 0.7s ease;
    opacity: 0;
    transform: translateY(1.25rem);
}
.get-the-look-section .gtl-panel.is-active .gtl-panel-content {
    opacity: 1;
    transform: translateY(0);
}
.get-the-look-section .gtl-panel-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(1.8rem, 3.5vw, 3.5rem);
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 1rem;
    color: #fff;
}
.get-the-look-section .gtl-panel-btn {
    color: #ffffff !important;
    border-color: rgba(255,255,255,0.5) !important;
}

/* ── Pagination dots ───────────────────────────────── */
.get-the-look-section .gtl-pagination {
    position: absolute;
    bottom: 1.25rem;
    right: 1.5rem;
    z-index: 4;
    display: flex;
    gap: 0.45rem;
    align-items: center;
}
html[dir="rtl"] .get-the-look-section .gtl-pagination {
    right: auto;
    left: 1.5rem;
}
.get-the-look-section .gtl-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(255,255,255,0.45);
    border: 1.5px solid rgba(255,255,255,0.6);
    cursor: pointer;
    padding: 0;
    transition: background 0.3s, transform 0.3s, width 0.3s;
    flex-shrink: 0;
}
.get-the-look-section .gtl-dot.is-active {
    background: #fff;
    width: 20px;
    border-radius: 4px;
}

/* ── Subheading ────────────────────────────────────── */
.get-the-look-section .gtl-subheading {
    display: block;
    font-family: var(--font-sans, sans-serif);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    opacity: 0.55;
    margin-bottom: 3rem;
    color: {{ gl.gtl_subheading_color | default('#111111') }};
}

/* ── List ──────────────────────────────────────────── */
.get-the-look-section .gtl-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid {{ gl.gtl_border_color | default('#111111') }}1a;
}
.get-the-look-section .gtl-list-item {
    border-bottom: 1px solid {{ gl.gtl_border_color | default('#111111') }}1a;
}

/* ── Trigger button ────────────────────────────────── */
.get-the-look-section .gtl-trigger {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 1.5rem 0 1.75rem;
    width: 100%;
    text-align: start;
    background: none;
    border: none;
    cursor: pointer;
}

.get-the-look-section .gtl-title-text {
    font-family: var(--font-serif, Georgia, serif);
    font-size: clamp(2.2rem, 4.5vw, 4.5rem);
    line-height: 1;
    color: {{ gl.gtl_title_color | default('#111111') }};
    opacity: 0.28;
    transition: opacity 0.3s ease, transform 0.3s ease;
    transform: translateX(0);
}
html[dir="rtl"] .get-the-look-section .gtl-title-text { transform: translateX(0); }

.get-the-look-section .gtl-trigger:hover .gtl-title-text,
.get-the-look-section .gtl-trigger.is-active .gtl-title-text {
    opacity: 1;
    color: {{ gl.gtl_title_active_color | default('#111111') }};
    transform: translateX(0.5rem);
}
html[dir="rtl"] .get-the-look-section .gtl-trigger:hover .gtl-title-text,
html[dir="rtl"] .get-the-look-section .gtl-trigger.is-active .gtl-title-text {
    transform: translateX(-0.5rem);
}

.get-the-look-section .gtl-number {
    font-family: var(--font-sans, sans-serif);
    font-size: 0.6rem;
    margin-top: 0.6rem;
    opacity: 0.28;
    transition: opacity 0.3s ease;
}
.get-the-look-section .gtl-trigger:hover .gtl-number,
.get-the-look-section .gtl-trigger.is-active .gtl-number {
    opacity: 1;
}

/* Underline */
.get-the-look-section .gtl-underline {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 0;
    background: {{ gl.gtl_border_color | default('#111111') }};
    transition: width 0.5s ease;
}
html[dir="rtl"] .get-the-look-section .gtl-underline {
    left: auto;
    right: 0;
}
.get-the-look-section .gtl-trigger:hover .gtl-underline,
.get-the-look-section .gtl-trigger.is-active .gtl-underline {
    width: 100%;
}
</style>

<script defer>
document.addEventListener('DOMContentLoaded', function () {
    var sections = document.querySelectorAll('.get-the-look-section');

    sections.forEach(function (section) {
        var sectionId = section.id;
        var triggers  = section.querySelectorAll('.gtl-trigger[data-section="' + sectionId + '"]');
        var panels    = section.querySelectorAll('.gtl-panel[data-section="' + sectionId + '"]');

        /* ── Trigger hover → switch panel ── */
        triggers.forEach(function (trigger) {
            trigger.addEventListener('mouseenter', function () {
                var index = parseInt(this.dataset.index, 10);

                triggers.forEach(function (t) { t.classList.remove('is-active'); });
                this.classList.add('is-active');

                panels.forEach(function (panel, i) {
                    if (i === index) {
                        panel.classList.add('is-active');
                    } else {
                        panel.classList.remove('is-active');
                    }
                });
            });
        });

        /* ── Pagination dots inside each panel ── */
        panels.forEach(function (panel) {
            var dots   = panel.querySelectorAll('.gtl-dot');
            var slides = panel.querySelectorAll('.gtl-slide');

            if (!dots.length || !slides.length) return;

            function goToSlide(idx) {
                slides.forEach(function (s, i) {
                    s.classList.toggle('is-active', i === idx);
                });
                dots.forEach(function (d, i) {
                    d.classList.toggle('is-active', i === idx);
                });
            }

            dots.forEach(function (dot) {
                dot.addEventListener('click', function (e) {
                    e.stopPropagation();
                    goToSlide(parseInt(this.dataset.dot, 10));
                });
            });

            /* Auto-play slides every 4 seconds when panel is active */
            var timer = null;

            function startAutoPlay() {
                if (slides.length <= 1) return;
                timer = setInterval(function () {
                    var current = 0;
                    slides.forEach(function (s, i) { if (s.classList.contains('is-active')) current = i; });
                    goToSlide((current + 1) % slides.length);
                }, 4000);
            }

            function stopAutoPlay() {
                if (timer) { clearInterval(timer); timer = null; }
            }

            /* Watch active class changes on panel to start/stop auto-play */
            var observer = new MutationObserver(function () {
                if (panel.classList.contains('is-active')) {
                    startAutoPlay();
                } else {
                    stopAutoPlay();
                    goToSlide(0); /* reset to first slide when leaving */
                }
            });
            observer.observe(panel, { attributes: true, attributeFilter: ['class'] });

            /* Start immediately if first panel */
            if (panel.classList.contains('is-active')) startAutoPlay();
        });
    });
});
</script>
