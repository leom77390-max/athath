<section data-products-banner-position="{{position}}" class="SK-products-banner SK-products-banner-{{position}} s-block">
	<div class="wrapper">
		<div class="container flex items-center md:flex-row flex-col gap-6 h-[872px] md:h-[clamp(25rem,12.0188rem+27.0442vw,39.063rem)]">

			<!-- IMAGE -->
			<div class="img-wrapper flex-1 w-full md:w-1/2 h-full relative rounded-3xl overflow-hidden md:order-2">

				{% for item in component.collection %}
				<button
					data-index="{{loop.index}}"
					class="hotspot absolute z-20"
					style="
						top:{{item.vertical_position}}%;
						left:{{item.horizontal_position}}%;
					">

					<span></span>
					<small>{{loop.index}}</small>

				</button>
				{% endfor %}

				<img
					class="h-full w-full object-cover"
					src="{{component.side_img}}"
					alt=""
				>

			</div>

			<!-- PRODUCTS -->
            <div class="flex w-full flex-col gap-6 flex-1">
                <div class="section-header text-center">

                    {% if component.block_title %}
                        <h2
                            class="text-[clamp(.725rem,1.1939rem+1.3061vw,1.5rem)] font-bold"
                            style="color: {{ component.blocktitle_color }};"
                        >
                            {{ component.block_title }}
                        </h2>
                    {% endif %}

                    {% if component.subtext %}
                        <p
                            class="mt-3 text-xs md:text-base"
                            style="color: {{ component.subtext_color }};"
                        >
                            {{ component.subtext }}
                        </p>
                    {% endif %}

                </div>
                <div class="product-wrapper  flex-1 flex flex-col
                [&>.product-details:not(:last-child)]:border-b
                [&>.product-details:not(:last-child)]:pb-5
                [&>.product-details:not(:last-child)]:mb-5">
                    
                    {% for item in component.collection %}
                    <div
                        data-index="{{loop.index}}"
                        data-product-id="{{item.products.value[0]}}"
                        class="product-details transition-all duration-500"
                    >
                    </div>
                    {% endfor %}
    
                    <!-- ADD ALL BUTTON -->
    
                    <button
                        class="bundle-add-cart-btn mt-6 bg-primary text-white px-6 py-3 rounded-xl transition hover:opacity-80"
                        data-label-default="{{ user.language.code == 'ar' ? 'إضافة الجميع' : 'Add all to cart' }}"
                        data-label-success="{{ user.language.code == 'ar' ? 'تمت إضافة المنتجات' : 'Added Successfully' }}"
                        data-label-error="{{ user.language.code == 'ar' ? 'حدث خطأ' : 'Something went wrong' }}"
                    >
                        {{ user.language.code == 'ar' ? 'إضافة الجميع' : 'Add all to cart' }}
                    </button>
    
                </div>
            </div>
		</div>
	</div>
</section>
<style>

@keyframes salla-spin {
	from{
		transform:rotate(0deg)
	}
	to{
		transform:rotate(360deg)
	}
}

.bundle-add-cart-btn .sicon-spinner{
	display:inline-block;
	animation:salla-spin .8s linear infinite;
}

.bundle-add-cart-btn:disabled{
	opacity:.7;
	cursor:not-allowed;
}

{% for item in component.collection %}

.SK-products-banner-{{position}} .hotspot:nth-child({{loop.index}}){
	top:{{item.vertical_position}}%;
	left:{{item.horizontal_position}}%;
}

{% endfor %}


/* ---------- HOTSPOTS ---------- */

.hotspot{
	transform:translate(-50%,-50%);
	transition:.4s;
}

.hotspot span{
	width:16px;
	height:16px;
	display:block;
	border-radius:999px;
	background:#fff;
	border:2px solid #000;
	transition:.35s;
}

.hotspot small{
	position:absolute;
	top:50%;
	left:50%;
	transform:translate(-50%,-50%);
	font-size:11px;
	font-weight:bold;
	opacity:0;
	transition:.3s;
}

.hotspot.active span{
	width:42px;
	height:42px;
}

.hotspot.active small{
	opacity:1;
}

.hotspot.dim{
	opacity:.3;
}


/* ---------- PRODUCTS ---------- */

.product-details{
	opacity:1;
	transform:scale(.97);
}

.product-details.active{
	opacity:1;
	transform:scale(1);
}

.product-details.dim{
	opacity:.35;
}

.product-details,
.hotspot{
	transition:all .4s ease;
}



</style>
<script defer>

(() => {

	const productCache = new Map();

	async function renderProduct(el){

		const id = el.dataset.productId;

		if(!id) return;

		if(productCache.has(id)){
			el.innerHTML=productCache.get(id);
			return;
		}

		try{

			const {data:product}=await salla.api.product.getDetails(id);

			const html=`

			<a href="${product.url}" class="block bg-background product-card group">

				<div class="flex items-center gap-4">

					<div class="w-20 h-20 rounded-xl overflow-hidden bg-gray-100 flex-shrink-0">

						<img
							src="${product.image?.url || ''}"
							class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
							alt="${product.name}"
						>

					</div>

					<div class="flex-1">

						<h3 class="font-semibold text-lg transition-colors group-hover:text-secondary line-clamp-2">
							${product.name}
						</h3>

						<div class="mt-2 text-secondary font-bold">
							${salla.money(product.price)}
						</div>

					</div>

				</div>

			</a>

			`;

			productCache.set(id,html);

			el.innerHTML=html;

		}catch(error){

			console.error(
				'Product render error:',
				error
			);

		}
	}


	salla.onReady(async()=>{

		const section=document.querySelector(
			'.SK-products-banner'
		);

		if(!section) return;


		const productContainers=[
			...section.querySelectorAll(
				'.product-details'
			)
		];

		await Promise.all(
			productContainers.map(renderProduct)
		);

		initHover(section);
		initBundle(section);

	});


	function initBundle(section){

		const btn=section.querySelector(
			'.bundle-add-cart-btn'
		);

		if(!btn) return;

		btn.addEventListener(
			'click',
			async ()=>{

				if(btn.disabled) return;

				const labelDefault=
				btn.dataset.labelDefault;

				const labelSuccess=
				btn.dataset.labelSuccess;

				const labelError=
				btn.dataset.labelError;

				const ids=[
					...section.querySelectorAll(
						'.product-details'
					)
				]
				.map(el=>el.dataset.productId)
				.filter(Boolean);

				if(!ids.length) return;

				btn.disabled=true;
				btn.innerHTML=
				'<i class="sicon-spinner"></i>';

				try{

					await Promise.all(

						ids.map(id=>
							salla.cart.addItem(
								id,
								1
							)
						)

					);

					btn.innerHTML=
					labelSuccess;

					setTimeout(()=>{

						btn.innerHTML=
						labelDefault;

						btn.disabled=
						false;

					},2000);

				}catch(error){

					console.error(
						'Bundle error:',
						error
					);

					btn.innerHTML=
					labelError;

					setTimeout(()=>{

						btn.innerHTML=
						labelDefault;

						btn.disabled=
						false;

					},2000);

				}

			}
		);

	}



	function initHover(section){

		const hotspots=[
			...section.querySelectorAll(
				'.hotspot'
			)
		];

		const products=[
			...section.querySelectorAll(
				'.product-details'
			)
		];


		function activate(index){

			hotspots.forEach(item=>{

				const active=
				item.dataset.index===index;

				item.classList.toggle(
					'active',
					active
				);

				item.classList.toggle(
					'dim',
					!active
				);

			});


			products.forEach(item=>{

				const active=
				item.dataset.index===index;

				item.classList.toggle(
					'active',
					active
				);

				item.classList.toggle(
					'dim',
					!active
				);

			});

		}


		function reset(){

			hotspots.forEach(item=>{

				item.classList.remove(
					'active',
					'dim'
				);

			});

			products.forEach(item=>{

				item.classList.remove(
					'active',
					'dim'
				);

			});

			hotspots[0]?.classList.add(
				'active'
			);

			products[0]?.classList.add(
				'active'
			);

		}

		reset();

		hotspots.forEach(item=>{

			item.addEventListener(
				'mouseenter',
				()=>activate(
					item.dataset.index
				)
			);

			item.addEventListener(
				'mouseleave',
				reset
			);

		});

		products.forEach(item=>{

			item.addEventListener(
				'mouseenter',
				()=>activate(
					item.dataset.index
				)
			);

			item.addEventListener(
				'mouseleave',
				reset
			);

		});

	}

})();

</script>