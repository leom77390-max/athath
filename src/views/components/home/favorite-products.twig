{#
| Variable                          | Type       | Description                                              |
|-----------------------------------|------------|----------------------------------------------------------|
| component                         | object     | Component configuration from twilight.json               |
| component.title                   | string     | Main fixed section title                                 |
| component.slides                  | array      | Array of slides in the collection                        |
| component.slides[].lifestyle_image| string     | Large lifestyle scene image                              |
| component.slides[].quote          | string     | Quote / review text above product                        |
| component.slides[].author_name    | string     | Author / reviewer name                                   |
| component.slides[].author_sub     | string     | Author location or subtitle                              |
| component.slides[].products       | array/int  | Salla store product dropdown (source: "products")        |
| position                          | int        | Block position index                                     |
#}

{% set c = component %}
{% set section_id = 'fav-products-' ~ (position|default(random(1000, 9999))) %}
{% set slides = c.slides|default([]) %}
{% set is_ar = user.language.code == 'ar' %}

{# صور تجريبية بديلة في حال لم يرفع التاجر صور بعد #}
{% set default_scenes = [
    'images/fav_scene_dining.jpg' | asset,
    'images/fav_scene_kitchen.jpg' | asset
] %}

<section
    class="fav-products-section py-12 md:py-20 overflow-hidden relative"
    id="{{ section_id }}"
    style="background-color: {{ c.bg_color|default('#FAF8F5') }}; color: {{ c.text_color|default('#18181B') }};"
>
    <div class="{% if c.apply_container is not defined or c.apply_container %} container mx-auto px-4 sm:px-6 lg:px-8 {% else %} w-full px-4 sm:px-8 {% endif %}">
        
        {# ================== FIXED SECTION HEADER (DESKTOP & MOBILE) ================== #}
        <div class="flex items-center justify-between mb-8 md:mb-12">
            {# Main Fixed Title #}
            <h2
                class="font-serif text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-normal tracking-tight"
                style="color: {{ c.title_color|default('#18181B') }};"
            >
                {{ c.title|default(is_ar ? 'منتجاتنا المفضلة' : 'Our favorite products') }}
            </h2>

            {# Top Navigation Controls (Visible on Both Desktop & Mobile) #}
            <div class="flex items-center gap-2.5">
                <button
                    type="button"
                    class="fav-nav-prev w-9 h-9 rounded-full border border-zinc-300 flex items-center justify-center text-zinc-700 bg-white shadow-sm hover:border-zinc-900 hover:text-black transition-all duration-200 active:scale-95 disabled:opacity-30 disabled:pointer-events-none"
                    aria-label="{{ is_ar ? 'السابق' : 'Previous slide' }}"
                >
                    <i class="sicon-keyboard_arrow_left rtl:rotate-180 text-sm"></i>
                </button>
                <button
                    type="button"
                    class="fav-nav-next w-9 h-9 rounded-full border border-zinc-300 flex items-center justify-center text-zinc-700 bg-white shadow-sm hover:border-zinc-900 hover:text-black transition-all duration-200 active:scale-95 disabled:opacity-30 disabled:pointer-events-none"
                    aria-label="{{ is_ar ? 'التالي' : 'Next slide' }}"
                >
                    <i class="sicon-keyboard_arrow_right rtl:rotate-180 text-sm"></i>
                </button>
            </div>
        </div>

        {# ================== SLIDER WRAPPER ================== #}
        {% if slides|length > 0 %}
            <div class="fav-slider-container relative overflow-hidden">
                <div class="fav-slider-track flex transition-transform duration-500 ease-out">
                    
                    {% for slide in slides %}
                        {% set scene_img = slide.lifestyle_image|default(slide['slides.lifestyle_image']) %}
                        {% if not scene_img or ('fav_scene_' in scene_img) %}
                            {% set scene_img = default_scenes[loop.index0 % 2] %}
                        {% endif %}

                        {% set quote_text = slide.quote|default(slide['slides.quote']) %}
                        {% set author_name = slide.author_name|default(slide['slides.author_name']) %}
                        {% set author_sub = slide.author_sub|default(slide['slides.author_sub']) %}

                        {# Extract Store Product IDs chosen by merchant #}
                        {% set slide_raw_prod = slide.products|default(slide['slides.products']) %}
                        {% set slide_prod_ids = [] %}

                        {% if slide_raw_prod is iterable %}
                            {% for p in slide_raw_prod %}
                                {% if p.id is defined %}
                                    {% set slide_prod_ids = slide_prod_ids|merge([p.id]) %}
                                {% elseif p is not empty %}
                                    {% set slide_prod_ids = slide_prod_ids|merge([p]) %}
                                {% endif %}
                            {% endfor %}
                        {% elseif slide_raw_prod.value is defined and slide_raw_prod.value is iterable %}
                            {% for p in slide_raw_prod.value %}
                                {% set slide_prod_ids = slide_prod_ids|merge([p]) %}
                            {% endfor %}
                        {% elseif slide_raw_prod is not empty %}
                            {% set slide_prod_ids = [slide_raw_prod] %}
                        {% endif %}

                        <div
                            class="fav-slide w-full shrink-0"
                            data-slide-index="{{ loop.index0 }}"
                        >
                            <div class="flex flex-col lg:grid lg:grid-cols-12 lg:gap-12 xl:gap-16 lg:items-center">
                                
                                {# ================= LIFESTYLE IMAGE ================= #}
                                {# Mobile: order-1 (on top) | Desktop: lg:order-2 (on right) #}
                                <div class="w-full order-1 lg:order-2 lg:col-span-7 mb-8 lg:mb-0">
                                    <div class="lifestyle-image-frame w-full aspect-[4/5] sm:aspect-[3/4] lg:aspect-[4/5] max-h-[460px] sm:max-h-[520px] lg:max-h-[620px] overflow-hidden rounded-t-[120px] sm:rounded-t-[160px] lg:rounded-t-[220px] bg-zinc-100 shadow-sm mx-auto">
                                        <img
                                            src="{{ scene_img }}"
                                            alt="{{ author_name|default(c.title) }}"
                                            loading="lazy"
                                            class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                                        >
                                    </div>
                                </div>

                                {# ================= CONTENT COLUMN ================= #}
                                {# Mobile: order-2 (below image) | Desktop: lg:order-1 (on left) #}
                                <div class="w-full order-2 lg:order-1 lg:col-span-5 flex flex-col justify-between py-2">
                                    
                                    {# Content Upper of Product: Quote + Author (Dynamic per slide) #}
                                    <div class="fav-quote-block mb-6 lg:mb-8">
                                        {% if quote_text %}
                                            <blockquote class="font-serif text-xl sm:text-2xl lg:text-3xl font-normal leading-snug text-zinc-900 tracking-normal mb-4 lg:mb-6">
                                                “{{ quote_text }}”
                                            </blockquote>
                                        {% endif %}

                                        {% if author_name or author_sub %}
                                            <div class="fav-author-meta">
                                                {% if author_name %}
                                                    <p class="text-sm font-semibold text-zinc-900 tracking-wide">
                                                        {{ author_name }}
                                                    </p>
                                                {% endif %}
                                                {% if author_sub %}
                                                    <p class="text-[11px] uppercase tracking-widest text-zinc-500 mt-1 font-medium">
                                                        {{ author_sub }}
                                                    </p>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    </div>

                                    {# Store Product Fetched Directly via Salla Products Slider #}
                                    <div class="fav-product-slider-wrapper w-full max-w-full sm:max-w-[340px] lg:max-w-[300px] xl:max-w-[320px]">
                                        {% if slide_prod_ids|length > 0 %}
                                            <salla-products-slider
                                                source="selected"
                                                source-value="[{{ slide_prod_ids|join(',') }}]"
                                                slider-id="fav-prod-slider-{{ position|default(1) }}-{{ loop.index }}"
                                                block-title=" "
                                                slider-config='{
                                                    "slidesPerView": 1,
                                                    "spaceBetween": 16,
                                                    "speed": 600
                                                }'
                                            ></salla-products-slider>
                                        {% else %}
                                            <salla-products-slider
                                                source="latest"
                                                limit="1"
                                                slider-id="fav-prod-slider-{{ position|default(1) }}-{{ loop.index }}"
                                                block-title=" "
                                                slider-config='{
                                                    "slidesPerView": 1,
                                                    "spaceBetween": 16,
                                                    "speed": 600
                                                }'
                                            ></salla-products-slider>
                                        {% endif %}
                                    </div>

                                </div>

                            </div>
                        </div>
                    {% endfor %}

                </div>
            </div>

            {# Slide Dots Pagination (Subtle Indicator) #}
            {% if slides|length > 1 %}
                <div class="fav-slider-dots flex items-center justify-center gap-2 mt-8 md:mt-10">
                    {% for slide in slides %}
                        <button
                            type="button"
                            class="fav-dot w-2 h-2 rounded-full transition-all duration-300 {{ loop.first ? 'bg-zinc-900 w-6' : 'bg-zinc-300 hover:bg-zinc-500' }}"
                            data-dot-index="{{ loop.index0 }}"
                            aria-label="Go to slide {{ loop.index }}"
                        ></button>
                    {% endfor %}
                </div>
            {% endif %}

        {% else %}
            <div class="py-12 text-center text-zinc-400">
                <i class="sicon-store text-4xl mb-3 block opacity-50"></i>
                <p>{{ is_ar ? 'يرجى إضافة شرائح من لوحة التحكم لعرض المنتجات المفضلة' : 'Please add slides from theme editor to display favorite products.' }}</p>
            </div>
        {% endif %}

    </div>
</section>

{# ============================== COMPONENT STYLES ============================== #}
<style>
    /* Styling for the Lifestyle Arched Image */
    #{{ section_id }} .lifestyle-image-frame {
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(0, 0, 0, 0.04);
    }

    /* Keep Salla product slider container neat & properly bounded */
    #{{ section_id }} .fav-product-slider-wrapper {
        min-height: 200px;
    }

    #{{ section_id }} .fav-product-slider-wrapper salla-products-slider {
        display: block;
        width: 100%;
    }

    /* Suppress unnecessary headers inside the inner product slider */
    #{{ section_id }} .fav-product-slider-wrapper .s-block__title,
    #{{ section_id }} .fav-product-slider-wrapper .s-block__header {
        display: none !important;
    }

    /* Responsive typography & serif font */
    #{{ section_id }} blockquote {
        font-family: ui-serif, Georgia, Cambria, "Times New Roman", Times, serif;
    }
</style>

{# ============================== JAVASCRIPT CONTROLLER ============================== #}
<script defer>
    document.addEventListener("DOMContentLoaded", function () {
        const section = document.getElementById("{{ section_id }}");
        if (!section) return;

        const track = section.querySelector(".fav-slider-track");
        const slides = section.querySelectorAll(".fav-slide");
        const prevBtn = section.querySelector(".fav-nav-prev");
        const nextBtn = section.querySelector(".fav-nav-next");
        const dots = section.querySelectorAll(".fav-dot");
        const totalSlides = slides.length;

        if (totalSlides <= 1) {
            if (prevBtn) prevBtn.style.display = "none";
            if (nextBtn) nextBtn.style.display = "none";
            return;
        }

        let currentIndex = 0;
        const isRtl = document.documentElement.getAttribute("dir") === "rtl" || document.dir === "rtl";

        function updateSlide(index) {
            if (index < 0) {
                currentIndex = totalSlides - 1;
            } else if (index >= totalSlides) {
                currentIndex = 0;
            } else {
                currentIndex = index;
            }

            const offset = currentIndex * 100;
            const translateVal = isRtl ? offset : -offset;
            track.style.transform = `translateX(${translateVal}%)`;

            // Update dots
            dots.forEach((dot, idx) => {
                if (idx === currentIndex) {
                    dot.classList.add("bg-zinc-900", "w-6");
                    dot.classList.remove("bg-zinc-300", "w-2");
                } else {
                    dot.classList.remove("bg-zinc-900", "w-6");
                    dot.classList.add("bg-zinc-300", "w-2");
                }
            });

            // Update Swiper inside Salla products slider if needed
            setTimeout(() => {
                window.dispatchEvent(new Event("resize"));
                const currentSlide = slides[currentIndex];
                if (currentSlide) {
                    const sliderEl = currentSlide.querySelector("salla-products-slider");
                    if (sliderEl && sliderEl.swiper) {
                        sliderEl.swiper.update();
                    } else if (sliderEl && sliderEl.shadowRoot) {
                        const innerSwiper = sliderEl.shadowRoot.querySelector(".swiper") || sliderEl.shadowRoot.querySelector("salla-slider");
                        if (innerSwiper && innerSwiper.swiper) {
                            innerSwiper.swiper.update();
                        }
                    }
                }
            }, 300);
        }

        if (nextBtn) {
            nextBtn.addEventListener("click", () => updateSlide(currentIndex + 1));
        }

        if (prevBtn) {
            prevBtn.addEventListener("click", () => updateSlide(currentIndex - 1));
        }

        dots.forEach((dot) => {
            dot.addEventListener("click", () => {
                const idx = parseInt(dot.getAttribute("data-dot-index"), 10);
                updateSlide(idx);
            });
        });

        // Touch swipe support for mobile
        let touchStartX = 0;
        let touchEndX = 0;
        track.addEventListener("touchstart", (e) => {
            touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        track.addEventListener("touchend", (e) => {
            touchEndX = e.changedTouches[0].screenX;
            const diff = touchEndX - touchStartX;
            if (Math.abs(diff) > 40) {
                if (diff > 0) {
                    // Swipe right
                    isRtl ? updateSlide(currentIndex + 1) : updateSlide(currentIndex - 1);
                } else {
                    // Swipe left
                    isRtl ? updateSlide(currentIndex - 1) : updateSlide(currentIndex + 1);
                }
            }
        }, { passive: true });

        // Autoplay if enabled
        {% if c.autoplay %}
            const autoplayInterval = {{ (c.autoplay_speed|default(5)) * 1000 }};
            setInterval(() => {
                updateSlide(currentIndex + 1);
            }, autoplayInterval);
        {% endif %}
    });
</script>
