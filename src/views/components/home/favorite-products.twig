{#
| Variable                          | Type       | Description                                              |
|-----------------------------------|------------|----------------------------------------------------------|
| component                         | object     | Component configuration from twilight.json               |
| component.title                   | string     | Main fixed section title                                 |
| component.slides                  | array      | Array of slides in the collection                        |
| component.slides[].lifestyle_image| string     | Large lifestyle scene image                              |
| component.slides[].quote          | string     | Quote / review text above product                        |
| component.slides[].author_name    | string     | Author / reviewer name                                   |
| component.slides[].author_sub     | string     | Author location or subtitle                              |
| component.slides[].products       | array/int  | Salla store product dropdown (source: "products")        |
| position                          | int        | Block position index                                     |
#}

{% set c = component %}
{% set section_id = 'fav-products-' ~ (position|default(random(1000, 9999))) %}
{% set is_ar = user.language.code == 'ar' %}

{# Resolve Section Title #}
{% set title_val = c.title|default('منتجاتنا المفضلة') %}
{% if c.title is iterable %}
    {% set title_val = c.title[user.language.code]|default(c.title.ar|default(c.title.en|default('منتجاتنا المفضلة'))) %}
{% endif %}

{# Default Slides Data (Arabic first, perfectly matching the design) #}
{% set default_slides = [
    {
        'lifestyle_image': 'images/fav_scene_dining.jpg' | asset,
        'quote': 'طاولة وكرسي بتصميم خشبي عصري ومتقن. نظراً لطبيعة المواد المستخدمة، فإن درجات الخشب الطبيعي تضفي دفئاً وسحراً استثنائياً على المكان...',
        'author_name': 'جيني ويلسون',
        'author_sub': 'نيو مكسيكو',
        'product_img': 'images/fav_prod_chair1.jpg' | asset,
        'product_cat': 'كنب ومقاعد',
        'product_title': 'كرسي استرخاء هيجي',
        'product_price': '999 ر.س'
    },
    {
        'lifestyle_image': 'images/fav_scene_kitchen.jpg' | asset,
        'quote': 'التصميم الأنيق ينسجم بشكل رائع مع ديكور المنزل العصري. جودة التصنيع فائقة والتفاصيل متقنة لأبعد حد، مساحته مريحة وواسعة جداً لستة أشخاص.',
        'author_name': 'ديفيد ر.',
        'author_sub': 'لوس أنجلوس',
        'product_img': 'images/fav_prod_chair2.jpg' | asset,
        'product_cat': 'كنب ومقاعد',
        'product_title': 'كرسي بارلور كلوب',
        'product_price': '1,250 ر.س'
    }
] %}

{% set slides = c.slides|default([]) %}
{% if slides|length == 0 %}
    {% set slides = default_slides %}
{% endif %}

{# Google Fonts for high-end luxury editorial serif typography (Arabic & English) #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

<section
    class="fav-products-section py-16 md:py-24 overflow-hidden relative"
    id="{{ section_id }}"
    style="background-color: {{ c.bg_color|default('#FAF8F5') }}; color: {{ c.text_color|default('#18181B') }};"
>
    <div class="{% if c.apply_container is not defined or c.apply_container %} container mx-auto px-5 sm:px-8 lg:px-12 xl:px-16 {% else %} w-full px-5 sm:px-8 {% endif %}">
        
        {# ================== TOP HEADER ROW ================== #}
        <div class="flex items-center justify-between mb-8 sm:mb-12 lg:mb-14">
            {# Main Fixed Title #}
            <h2 class="fav-section-title text-2xl sm:text-3xl md:text-4xl lg:text-[42px] font-normal tracking-tight text-[#18181B]">
                {{ title_val }}
            </h2>

            {# Top Navigation Controls: Prev / Next buttons matching screenshot #}
            <div class="fav-nav-arrows flex items-center gap-3">
                <button
                    type="button"
                    class="fav-nav-prev w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-[#D1CDC7] hover:border-[#18181B] bg-transparent hover:bg-white text-[#18181B] flex items-center justify-center transition-all duration-200 active:scale-95 disabled:opacity-30 disabled:pointer-events-none"
                    aria-label="{{ is_ar ? 'السابق' : 'Previous slide' }}"
                >
                    <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
                    </svg>
                </button>
                <button
                    type="button"
                    class="fav-nav-next w-9 h-9 sm:w-10 sm:h-10 rounded-full border border-[#D1CDC7] hover:border-[#18181B] bg-transparent hover:bg-white text-[#18181B] flex items-center justify-center transition-all duration-200 active:scale-95 disabled:opacity-30 disabled:pointer-events-none"
                    aria-label="{{ is_ar ? 'التالي' : 'Next slide' }}"
                >
                    <svg class="w-4 h-4 rtl:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7" />
                    </svg>
                </button>
            </div>
        </div>

        {# ================== SLIDER VIEWPORT ================== #}
        <div class="fav-slider-viewport relative overflow-hidden">
            <div class="fav-slider-track flex transition-transform duration-500 ease-out">
                
                {% for slide in slides %}
                    {% set default_data = default_slides[loop.index0 % default_slides|length] %}

                    {# Resolve Lifestyle Scene Image #}
                    {% set scene_img = slide.lifestyle_image|default(slide['slides.lifestyle_image']) %}
                    {% if not scene_img or ('fav_scene_' in scene_img) %}
                        {% set scene_img = default_data.lifestyle_image %}
                    {% endif %}

                    {# Resolve Quote (Multilanguage support with Arabic default) #}
                    {% set slide_quote = slide.quote|default(slide['slides.quote']) %}
                    {% if slide_quote is iterable %}
                        {% set slide_quote = slide_quote[user.language.code]|default(slide_quote.ar|default(slide_quote.en)) %}
                    {% endif %}
                    {% if not slide_quote %}
                        {% set slide_quote = default_data.quote %}
                    {% endif %}

                    {# Resolve Author Name #}
                    {% set slide_author = slide.author_name|default(slide['slides.author_name']) %}
                    {% if slide_author is iterable %}
                        {% set slide_author = slide_author[user.language.code]|default(slide_author.ar|default(slide_author.en)) %}
                    {% endif %}
                    {% if not slide_author %}
                        {% set slide_author = default_data.author_name %}
                    {% endif %}

                    {# Resolve Subtitle / Location #}
                    {% set slide_sub = slide.author_sub|default(slide['slides.author_sub']) %}
                    {% if slide_sub is iterable %}
                        {% set slide_sub = slide_sub[user.language.code]|default(slide_sub.ar|default(slide_sub.en)) %}
                    {% endif %}
                    {% if not slide_sub %}
                        {% set slide_sub = default_data.author_sub %}
                    {% endif %}

                    {# Extract Selected Store Product IDs #}
                    {% set slide_raw_prod = slide.products|default(slide['slides.products']) %}
                    {% set slide_prod_ids = [] %}

                    {% if slide_raw_prod is iterable %}
                        {% for p in slide_raw_prod %}
                            {% if p.id is defined %}
                                {% set slide_prod_ids = slide_prod_ids|merge([p.id]) %}
                            {% elseif p is not empty %}
                                {% set slide_prod_ids = slide_prod_ids|merge([p]) %}
                            {% endif %}
                        {% endfor %}
                    {% elseif slide_raw_prod.value is defined and slide_raw_prod.value is iterable %}
                        {% for p in slide_raw_prod.value %}
                            {% set slide_prod_ids = slide_prod_ids|merge([p]) %}
                        {% endfor %}
                    {% elseif slide_raw_prod is not empty %}
                        {% set slide_prod_ids = [slide_raw_prod] %}
                    {% endif %}

                    <div
                        class="fav-slide w-full shrink-0"
                        data-slide-index="{{ loop.index0 }}"
                    >
                        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-14 xl:gap-20 items-stretch">
                            
                            {# ================= LEFT COLUMN (DESKTOP: col-span-5 | MOBILE: order-2) ================= #}
                            <div class="order-2 lg:order-1 lg:col-span-5 flex flex-col justify-between py-1 lg:py-2">
                                
                                {# Top: Quote + Author Meta #}
                                <div class="fav-quote-group mb-8 sm:mb-12 lg:mb-16">
                                    <blockquote class="fav-quote-text text-xl sm:text-2xl lg:text-[28px] xl:text-[30px] font-normal leading-[1.38] text-[#18181B] mb-5 sm:mb-6">
                                        “{{ slide_quote }}”
                                    </blockquote>

                                    <div class="fav-author-meta">
                                        <p class="fav-author-name text-sm font-medium text-[#18181B] tracking-wide">
                                            {{ slide_author }}
                                        </p>
                                        {% if slide_sub %}
                                            <p class="fav-author-sub text-[11px] uppercase tracking-[0.2em] text-[#71717A] font-medium mt-1">
                                                {{ slide_sub }}
                                            </p>
                                        {% endif %}
                                    </div>
                                </div>

                                {# Bottom: Product Card (Minimal, matching screenshot) #}
                                <div class="fav-product-card-wrap w-full max-w-[260px] sm:max-w-[280px] lg:max-w-[270px] xl:max-w-[290px]">
                                    
                                    {% if slide_prod_ids|length > 0 %}
                                        {# Store product fetched via Salla products slider with clean minimal styling #}
                                        <div class="fav-salla-slider-box">
                                            <salla-products-slider
                                                source="selected"
                                                source-value="[{{ slide_prod_ids|join(',') }}]"
                                                slider-id="fav-prod-slider-{{ position|default(1) }}-{{ loop.index }}"
                                                block-title=" "
                                                slider-config='{
                                                    "slidesPerView": 1,
                                                    "spaceBetween": 16,
                                                    "speed": 600
                                                }'
                                            ></salla-products-slider>
                                        </div>
                                    {% else %}
                                        {# Default Product Card matching screenshot with Arabic content #}
                                        <div class="fav-product-item group block">
                                            <div class="fav-prod-media-box relative bg-[#F5F3EF] aspect-[4/5] sm:aspect-square overflow-hidden mb-3">
                                                <img
                                                    src="{{ default_data.product_img }}"
                                                    alt="{{ default_data.product_title }}"
                                                    loading="lazy"
                                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                                >
                                            </div>
                                            <div class="fav-prod-info flex flex-col">
                                                <span class="fav-prod-category text-[10px] sm:text-[11px] uppercase font-bold tracking-wider text-[#A1A1AA] mb-0.5">
                                                    {{ default_data.product_cat }}
                                                </span>
                                                <h3 class="fav-prod-title text-sm sm:text-base font-medium text-[#18181B] line-clamp-1 hover:text-[#52525B] transition-colors">
                                                    {{ default_data.product_title }}
                                                </h3>
                                                <span class="fav-prod-price text-sm sm:text-base font-semibold text-[#18181B] mt-0.5">
                                                    {{ default_data.product_price }}
                                                </span>
                                            </div>
                                        </div>
                                    {% endif %}

                                </div>

                            </div>

                            {# ================= RIGHT COLUMN (DESKTOP: col-span-7 | MOBILE: order-1) ================= #}
                            {# Large Lifestyle Scene Image - CLEAN RECTANGLE MATCHING SCREENSHOT #}
                            <div class="order-1 lg:order-2 lg:col-span-7">
                                <div class="fav-lifestyle-frame w-full h-[360px] sm:h-[480px] lg:h-full min-h-[420px] lg:min-h-[560px] xl:min-h-[640px] overflow-hidden bg-[#ECE8E1]">
                                    <img
                                        src="{{ scene_img }}"
                                        alt="{{ slide_author }}"
                                        loading="lazy"
                                        class="w-full h-full object-cover"
                                    >
                                </div>
                            </div>

                        </div>
                    </div>
                {% endfor %}

            </div>
        </div>

    </div>
</section>

{# ============================== COMPONENT STYLES ============================== #}
<style>
    /* Typography matching editorial serif aesthetic in screenshot */
    #{{ section_id }} .fav-section-title {
        font-family: 'Playfair Display', 'Amiri', Georgia, 'Times New Roman', serif;
    }

    #{{ section_id }} .fav-quote-text {
        font-family: 'Playfair Display', 'Amiri', Georgia, 'Times New Roman', serif;
    }

    /* Clean lifestyle frame rectangle - no arched top cutoffs */
    #{{ section_id }} .fav-lifestyle-frame {
        border-radius: 0;
    }

    /* Product card image wrapper */
    #{{ section_id }} .fav-prod-media-box {
        border-radius: 0;
    }

    /* Strip all intrusive UI from Salla Products Slider to match minimal editorial card */
    #{{ section_id }} salla-products-slider {
        display: block;
        width: 100%;
    }

    #{{ section_id }} salla-products-slider .s-block,
    #{{ section_id }} salla-products-slider .s-block__header,
    #{{ section_id }} salla-products-slider .s-block__title,
    #{{ section_id }} salla-products-slider .s-block__display-all,
    #{{ section_id }} salla-products-slider .swiper-button-prev,
    #{{ section_id }} salla-products-slider .swiper-button-next,
    #{{ section_id }} salla-products-slider .swiper-pagination {
        display: none !important;
    }

    #{{ section_id }} salla-products-slider custom-salla-product-card {
        display: block !important;
        border: none !important;
        box-shadow: none !important;
        background: transparent !important;
        padding: 0 !important;
        border-radius: 0 !important;
    }

    #{{ section_id }} salla-products-slider custom-salla-product-card .top_action,
    #{{ section_id }} salla-products-slider custom-salla-product-card .s-product-card-actions,
    #{{ section_id }} salla-products-slider custom-salla-product-card .s-product-card-promotion-title,
    #{{ section_id }} salla-products-slider custom-salla-product-card .s-product-card-rating,
    #{{ section_id }} salla-products-slider custom-salla-product-card .s-product-card-wishlist-btn,
    #{{ section_id }} salla-products-slider custom-salla-product-card .quick-view-button {
        display: none !important;
    }

    #{{ section_id }} salla-products-slider custom-salla-product-card .product-image-wrapper {
        background-color: #F5F3EF !important;
        aspect-ratio: 4 / 5 !important;
        border-radius: 0 !important;
        overflow: hidden !important;
        width: 100% !important;
    }

    #{{ section_id }} salla-products-slider custom-salla-product-card .product-img {
        object-fit: cover !important;
        width: 100% !important;
        height: 100% !important;
        border-radius: 0 !important;
    }

    #{{ section_id }} salla-products-slider custom-salla-product-card .s-product-card-content {
        padding: 10px 0 0 0 !important;
        background: transparent !important;
    }

    #{{ section_id }} salla-products-slider custom-salla-product-card .s-product-card-content-title a {
        font-size: 14px !important;
        font-weight: 500 !important;
        color: #18181B !important;
    }

    #{{ section_id }} salla-products-slider custom-salla-product-card .s-product-card-price {
        font-size: 14px !important;
        font-weight: 600 !important;
        color: #18181B !important;
    }
</style>

{# ============================== JAVASCRIPT CONTROLLER ============================== #}
<script defer>
    document.addEventListener("DOMContentLoaded", function () {
        const section = document.getElementById("{{ section_id }}");
        if (!section) return;

        const track = section.querySelector(".fav-slider-track");
        const slides = section.querySelectorAll(".fav-slide");
        const prevBtn = section.querySelector(".fav-nav-prev");
        const nextBtn = section.querySelector(".fav-nav-next");
        const totalSlides = slides.length;

        if (totalSlides <= 1) {
            if (prevBtn) prevBtn.style.display = "none";
            if (nextBtn) nextBtn.style.display = "none";
            return;
        }

        let currentIndex = 0;
        const isRtl = document.documentElement.getAttribute("dir") === "rtl" || document.dir === "rtl";

        function updateSlide(index) {
            if (index < 0) {
                currentIndex = totalSlides - 1;
            } else if (index >= totalSlides) {
                currentIndex = 0;
            } else {
                currentIndex = index;
            }

            const offset = currentIndex * 100;
            const translateVal = isRtl ? offset : -offset;
            track.style.transform = `translateX(${translateVal}%)`;

            // Refresh inner Swiper if needed
            setTimeout(() => {
                window.dispatchEvent(new Event("resize"));
                const currentSlide = slides[currentIndex];
                if (currentSlide) {
                    const sliderEl = currentSlide.querySelector("salla-products-slider");
                    if (sliderEl && sliderEl.swiper) {
                        sliderEl.swiper.update();
                    } else if (sliderEl && sliderEl.shadowRoot) {
                        const innerSwiper = sliderEl.shadowRoot.querySelector(".swiper") || sliderEl.shadowRoot.querySelector("salla-slider");
                        if (innerSwiper && innerSwiper.swiper) {
                            innerSwiper.swiper.update();
                        }
                    }
                }
            }, 300);
        }

        if (nextBtn) {
            nextBtn.addEventListener("click", () => updateSlide(currentIndex + 1));
        }

        if (prevBtn) {
            prevBtn.addEventListener("click", () => updateSlide(currentIndex - 1));
        }

        // Mobile touch swipe gestures
        let touchStartX = 0;
        let touchEndX = 0;
        track.addEventListener("touchstart", (e) => {
            touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        track.addEventListener("touchend", (e) => {
            touchEndX = e.changedTouches[0].screenX;
            const diff = touchEndX - touchStartX;
            if (Math.abs(diff) > 40) {
                if (diff > 0) {
                    // Swipe right
                    isRtl ? updateSlide(currentIndex + 1) : updateSlide(currentIndex - 1);
                } else {
                    // Swipe left
                    isRtl ? updateSlide(currentIndex - 1) : updateSlide(currentIndex + 1);
                }
            }
        }, { passive: true });

        // Autoplay if enabled
        {% if c.autoplay %}
            const autoplayInterval = {{ (c.autoplay_speed|default(5)) * 1000 }};
            setInterval(() => {
                updateSlide(currentIndex + 1);
            }, autoplayInterval);
        {% endif %}
    });
</script>
