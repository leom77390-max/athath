{# ================================================
   SK Cards Section — matches design in screenshots
   Desktop: 3-column grid of tall image cards
   Mobile:  horizontal slider, 1.2 cards visible
   Card:    full-height bg image + title + pill CTA
   ================================================ #}

{% set bg_style = component.background_is_image and component.background_image
    ? 'background-image:url(' ~ component.background_image ~ ');background-size:cover;background-position:center;'
    : 'background-color:' ~ component.background_color|default('#ffffff') ~ ';' %}

<section
    class="SK-cards-section overflow-hidden SK-cards-section-{{position}} {{ component.add_inside_container ? 'container' : '' }} {{ component.rm_margin ? '!mb-0' : '' }}"
    style="{{ bg_style }}">

    {# ── Section Header ── #}
    {% if component.main_title or component.cta_text %}
    <div class="SK-cards-section__header">

        {% if component.main_title %}
        <h2 class="SK-cards-section__title"
            style="color:{{ component.customize_colors ? component.main_title_color|default('#18181b') : '#18181b' }};">
            {{ component.main_title }}
        </h2>
        {% endif %}

        {% if component.cta_text %}
        <a href="{{ component.cta_url|default('#') }}"
           class="SK-cards-section__cta-link"
           style="color:{{ component.customize_colors ? component.cta_color|default('#18181b') : '#18181b' }};">
            {{ component.cta_text }}
        </a>
        {% endif %}

    </div>
    {% endif %}

    {# ── Cards ── #}
    {% if component.enable_slider %}

        {# Slider mode #}
        {% set ds = component.desktop_slides_per_view|default(3) %}
        {% set ls = component.laptop_slides_per_view|default(3) %}
        {% set ms = component.mobile_slides_per_view|default(1) %}
        {% set mob_peek = ms ~ '.3' %}

    <salla-slider
    id="sk-cards-{{ component.id }}"
    type="carousel"
    class="SK-cards-section__slider"
    {% if component.enable_autoplay %}auto-play{% endif %}
    {% if component.enable_controls is same as(false) %}show-controls="false"{% else %}controls-outer{% endif %}
    {% if component.enable_loop is not same as(false) %}loop="true"{% endif %}
    {% if component.enable_pagination is not same as(false) %}pagination{% endif %}
    slider-config='{
    "slidesPerView": {{ mob_peek }},
    "spaceBetween": 16,
    "speed": 600,
    "grabCursor": true,
    "simulateTouch": true,
    "allowTouchMove": true,
    "followFinger": true,
    "touchRatio": 1.8,
    "threshold": 5,
    "resistance": true,
    "resistanceRatio": 0.85,
    "breakpoints": {
        "640": { "slidesPerView": 2.1, "spaceBetween": 20 },
        "1024": { "slidesPerView": {{ ls }}, "spaceBetween": 24 },
        "1280": { "slidesPerView": {{ ds }}, "spaceBetween": 24 }
    }
    {% if component.enable_autoplay %},
    "autoplay": {
        "delay": 3000,
        "disableOnInteraction": false,
        "pauseOnMouseEnter": false
    }
    {% endif %}
    {% if component.enable_loop is not same as(false) %},
    "loop": true
    {% endif %}
}'
>
            <div slot="items">
                {% for card in component.card %}
                <div class="swiper-slide h-auto">
                    <div class="SK-card"
                         style="border-radius:{{ card.corner_rounded|default(card['card.corner_rounded']|default(16)) }}px; overflow:hidden;">

                        {# Full-bleed background #}
                        {% set card_bg_is_image = card.background_is_image is defined ? card.background_is_image : card['card.background_is_image']|default(false) %}
                        {% set card_bg_image = card.bg_image|default(card['card.bg_image']|default('')) %}
                        {% set card_bg_color = card.bg_color|default(card['card.bg_color']|default('#f5f0eb')) %}
                        <div class="SK-card__bg"
                             style="
                             {% if card_bg_is_image and card_bg_image %}
                                 background-image:url('{{ card_bg_image }}');
                                 background-size:cover;
                                 background-position:center top;
                             {% else %}
                                 background-color:{{ card_bg_color }};
                             {% endif %}
                             "></div>

                        {# Bottom gradient overlay so text is always readable #}
                        {% if component.overlay_is_true %}
                            <div class="SK-card__overlay"></div>
                        {% endif %}

                        {# Card content — sits above the overlay #}
                        {% set card_title = card.title|default(card['card.title']|default('')) %}
                        {% set card_title_color = card.title_color|default(card['card.title_color']|default('#18181b')) %}
                        {% set card_btn_text = card.button_text|default(card['card.button_text']|default('')) %}
                        {% set card_btn_bg = card.button_bg_color|default(card['card.button_bg_color']|default('#18181b')) %}
                        {% set card_btn_color = card.button_text_color|default(card['card.button_text_color']|default('#ffffff')) %}
                        {% set card_btn_url = card.btn_url|default(card['card.btn_url']|default('#')) %}

                        <div class="SK-card__body">
                            {% if card_title %}
                            <h3 class="SK-card__title"
                                style="color:{{ card_title_color }};">
                                {{ card_title }}
                            </h3>
                            {% endif %}

                            {% if card_btn_text %}
                            <a href="{{ card_btn_url }}"
                               class="SK-card__btn"
                               style="--btn-bg: {{ card_btn_bg }}; --btn-color: {{ card_btn_color }}; background-color: var(--btn-bg); color: var(--btn-color);">
                                <span class="SK-card__btn-text">{{ card_btn_text }}</span>
                            </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </salla-slider>

    {% else %}

        {# Grid mode #}
        <div class="SK-cards-section__grid">
            {% for card in component.card %}
                <div class="SK-card"
                     style="border-radius:{{ card.corner_rounded|default(16) }}px; overflow:hidden;">

                    {# Full-bleed background #}
                    <div class="SK-card__bg"
                         style="
                         {% if card.background_is_image and card.bg_image %}
                             background-image:url('{{ card.bg_image }}');
                             background-size:cover;
                             background-position:center top;
                         {% else %}
                             background-color:{{ card.bg_color|default('#f5f0eb') }};
                         {% endif %}
                         "></div>

                    {# Bottom gradient overlay so text is always readable #}
                      {% if component.overlay_is_true %}
                            <div class="SK-card__overlay"></div>
                        {% endif %}

                    {# Card content — sits above the overlay #}
                    <div class="SK-card__body">

                        {% if card.title %}
                        <h3 class="SK-card__title"
                            style="color:{{ card.title_color|default('#18181b') }};">
                            {{ card.title }}
                        </h3>
                        {% endif %}

                        {% if card.button_text %}
                        <a href="{{ card.btn_url|default('#') }}"
                           class="SK-card__btn"
                           style="--btn-bg: {{ card.button_bg_color|default('#18181b') }}; --btn-color: {{ card.button_text_color|default('#ffffff') }}; background-color: var(--btn-bg); color: var(--btn-color);">
                            <span class="SK-card__btn-text">{{ card.button_text }}</span>
                        </a>
                        {% endif %}

                    </div>
                </div>
            {% endfor %}
        </div>

    {% endif %}

    {% if component.customize_colors %}
    <style>
    #sk-cards-{{ component.id }} {
        --swiper-pagination-color: {{ component.pagination_color | default('#18181b') }};
        --swiper-pagination-bullet-inactive-color: {{ component.pagination_color | default('#18181b') }};
        --swiper-navigation-color: {{ component.arrows_color | default('#18181b') }};
    }
    #sk-cards-{{ component.id }}::part(nav-btn) {
        color: {{ component.arrows_color | default('#18181b') }};
        background-color: {{ component.arrows_bg_color | default('#ffffff') }};
        border: 1px solid {{ component.arrows_color | default('#18181b') }};
    }
    #sk-cards-{{ component.id }} .s-slider-nav-arrow {
        background-color: {{ component.arrows_bg_color | default('#ffffff') }} !important;
        color: {{ component.arrows_color | default('#18181b') }} !important;
        border: 1px solid {{ component.arrows_color | default('#18181b') }} !important;
    }
    #sk-cards-{{ component.id }} .s-slider-nav-arrow svg {
        fill: {{ component.arrows_color | default('#18181b') }} !important;
    }
    #sk-cards-{{ component.id }} .swiper-pagination-bullet {
        background-color: {{ component.pagination_color | default('#18181b') }} !important;
        opacity: 0.5;
    }
    #sk-cards-{{ component.id }} .swiper-pagination-bullet-active {
        opacity: 1 !important;
    }
    </style>
    {% endif %}

</section>

<style>
/* ═══════════════════════════════════════════
   SK Cards Section
═══════════════════════════════════════════ */

.SK-cards-section {
    padding: 4rem 1.5rem;
}

/* ── Header ── */
.SK-cards-section__header {
    max-width: 680px;
    margin: 0 auto 3rem;
    text-align: center;
}

.SK-cards-section__title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin-bottom: 1.25rem;
}

.SK-cards-section__cta-link {
    display: inline-block;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    padding-bottom: 3px;
    position: relative;
    transition: opacity 0.2s;
}
.SK-cards-section__cta-link::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 1.5px;
    bottom: 0;
    left: 0;
    background-color: currentColor;
    transform-origin: right;
}
@media (hover: hover) {
    .SK-cards-section__cta-link:hover { opacity: 0.65; }
    .SK-cards-section__cta-link:hover::after {
        animation: cta-link-slide 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
}
@keyframes cta-link-slide {
    0% {
        transform-origin: right;
        transform: scaleX(1);
    }
    50% {
        transform-origin: right;
        transform: scaleX(0);
    }
    51% {
        transform-origin: left;
        transform: scaleX(0);
    }
    100% {
        transform-origin: left;
        transform: scaleX(1);
    }
}

/* ── Grid (when slider disabled) ── */
.SK-cards-section__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.25rem;
}
@media (min-width: 640px) {
    .SK-cards-section__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 1024px) {
    .SK-cards-section__grid { grid-template-columns: repeat(3, 1fr); }
}
@media (min-width: 1280px) {
    .SK-cards-section__grid { grid-template-columns: repeat(3, 1fr); }
}

/* ── Card ── */
.SK-card {
    position: relative;
    width: 100%;
    /* Tall portrait ratio matching the screenshot */
    aspect-ratio: 9 / 14;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    cursor: pointer;
}

/* Background layer */
.SK-card__bg {
   position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    will-change: transform;
    backface-visibility: hidden;
    transform: translateZ(0);
    transition: transform .35s ease;
}
@media (hover: hover) {
    .SK-card:hover .SK-card__bg {
        transform: scale(1.04);
    }
}

/* Gradient overlay — fades image into a readable bottom zone */
.SK-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        transparent 40%,
        rgba(255,255,255,0.55) 70%,
        rgba(255,255,255,0.92) 100%
    );
    pointer-events: none;
}

/* Content block */
.SK-card__body {
    position: relative;
    z-index: 2;
    padding: 1.5rem 1.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
}

.SK-card__title {
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
}

.SK-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 2rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.25s, box-shadow 0.25s;
    white-space: nowrap;
    position: relative;
    overflow: hidden;
}

.SK-card__btn::before,
.SK-card__btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s cubic-bezier(0.7, 0, 0.3, 1);
    z-index: 1;
}

.SK-card__btn::before {
    background-color: var(--btn-color, #ffffff);
    opacity: 0.3;
    transition-delay: 0.1s;
}

.SK-card__btn::after {
    background-color: var(--btn-color, #ffffff);
    transition-delay: 0s;
}

.SK-card__btn-text {
    position: relative;
    z-index: 2;
    transition: color 0.5s cubic-bezier(0.7, 0, 0.3, 1);
    transition-delay: 0s;
}

@media (hover: hover) {
    .SK-card__btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.18);
    }

    .SK-card__btn:hover::before,
    .SK-card__btn:hover::after {
        transform: scaleX(1);
        transform-origin: left;
    }

    .SK-card__btn:hover::before {
        transition-delay: 0s;
    }

    .SK-card__btn:hover::after {
        transition-delay: 0.1s;
    }

    .SK-card__btn:hover .SK-card__btn-text {
        color: var(--btn-bg, #18181b);
        transition-delay: 0.1s;
    }
}

/* ── Slider overrides ── */
.SK-cards-section__slider {
    --salla-slider-padding: 0;
    overflow: visible; /* let peek card show */
    padding-bottom: 2.5rem; /* space for pagination */
}
.SK-cards-section__slider .swiper-pagination {
    bottom: 0 !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    width: auto !important;
    display: flex;
    justify-content: center;
}
.SK-cards-section__slider .swiper {
    overflow: visible;
    cursor: grab;
}
.SK-cards-section__slider .swiper:active {
    cursor: grabbing;
}
.SK-cards-section__slider .swiper-wrapper {
    
}
.SK-cards-section__slider .swiper-slide {
    height: auto;
}

/* ── Mobile ── */
@media (max-width: 639px) {
    .SK-cards-section {
        padding: 2.5rem 1rem;
    }
    .SK-card__title { font-size: 1.05rem; }
    .SK-card__btn   { padding: 0.6rem 1.5rem; font-size: 0.85rem; }
}
</style>