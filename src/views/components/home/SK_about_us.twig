{# ================================================
   SK Cards Section — matches design in screenshot
   Header: big title (center) + underlined CTA link
   Body:   responsive grid of image-bg cards
           each card: image top + title + pill button
   ================================================ #}

{% set bg_style = component.background_is_image and component.background_image
    ? 'background-image:url(' ~ component.background_image ~ ');background-size:cover;background-position:center;'
    : 'background-color:' ~ component.background_color|default('#ffffff') ~ ';' %}

<section class="SK-cards-section {{ component.add_inside_container ? 'container' : '' }} {{ component.rm_margin ? 'mb-0' : 'mb-12' }}"
         style="{{ bg_style }}">

    {# ── Section Header ── #}
    {% if component.main_title or component.cta_text %}
    <div class="SK-cards-section__header text-center mb-12">

        {% if component.main_title %}
        <h2 class="SK-cards-section__title"
            style="color: {{ component.customize_colors ? component.main_title_color|default('#18181b') : '#18181b' }};">
            {{ component.main_title }}
        </h2>
        {% endif %}

        {% if component.cta_text %}
        <a href="{{ component.cta_url|default('#') }}"
           class="SK-cards-section__cta-link"
           style="color: {{ component.customize_colors ? component.cta_color|default('#18181b') : '#18181b' }};">
            {{ component.cta_text }}
        </a>
        {% endif %}

    </div>
    {% endif %}

    {% if component.enable_slider|default(true) %}
        {# ── Cards Slider ── #}
        {% set ds = component.desktop_slides_per_view|default(4) %}
        {% set ls = component.laptop_slides_per_view|default(3) %}
        {% set ms = component.mobile_slides_per_view|default(1.1) %}
        {% set controls = component.enable_controls|default(true) ? 'outer' : 'none' %}
        {% set loop = component.enable_loop|default(false) ? 'true' : 'false' %}

        <salla-slider
            type="carousel"
            controls="{{ controls }}"
            pagination="none"
            id="cards-slider-{{ component.id }}"
            slider-config='{
                {% if component.enable_autoplay %}"autoplay": {"delay": 3000, "disableOnInteraction": false},{% endif %}
                "loop": {{ loop }},
                "slidesPerView": {{ ms }},
                "spaceBetween": 16,
                "breakpoints": {
                    "640": { "slidesPerView": 2.2, "spaceBetween": 20 },
                    "1024": { "slidesPerView": {{ ls }}, "spaceBetween": 24 },
                    "1280": { "slidesPerView": {{ ds }}, "spaceBetween": 24 }
                }
            }'
            class="SK-cards-section__slider">
            <div slot="items">
            {% for card in component.card %}
            <div class="swiper-slide h-auto">
                <div class="SK-card relative w-full h-[450px] md:h-[550px] flex flex-col justify-end overflow-hidden group"
                     style="border-radius: {{ card.corner_rounded|default(16) }}px;">
                     
                    {# Background Layer #}
                    <div class="absolute inset-0 w-full h-full transition-transform duration-700 ease-out group-hover:scale-105"
                         style="
                         {% if card.background_is_image and card.bg_image %}
                             background-image: url('{{ card.bg_image }}'); background-size: cover; background-position: center;
                         {% else %}
                             background-color: {{ card.bg_color|default('#f5f0eb') }};
                         {% endif %}
                         "></div>

                    {# Card body — positioned at bottom #}
                    <div class="relative z-10 w-full p-6 md:p-8 flex flex-col items-center text-center">

                        {% if card.title %}
                        <h3 class="text-xl md:text-2xl font-semibold mb-6 line-clamp-2"
                            style="color: {{ card.title_color|default('#18181b') }};">
                            {{ card.title }}
                        </h3>
                        {% endif %}

                        {% if card.button_text %}
                        <a href="{{ card.btn_url|default('#') }}"
                           class="inline-flex items-center justify-center px-8 py-3 rounded-full text-sm font-medium transition-all duration-300 hover:-translate-y-1 hover:shadow-lg active:scale-95"
                           style="background-color: {{ card.button_bg_color|default('#18181b') }};
                                  color: {{ card.button_text_color|default('#ffffff') }};">
                            {{ card.button_text }}
                        </a>
                        {% endif %}

                    </div>
                </div>
            </div>
            {% endfor %}
            </div>
        </salla-slider>
    {% else %}
        {# ── Cards Grid ── #}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {% for card in component.card %}
            <div class="h-auto">
                <div class="SK-card relative w-full h-[450px] md:h-[550px] flex flex-col justify-end overflow-hidden group"
                     style="border-radius: {{ card.corner_rounded|default(16) }}px;">
                     
                    {# Background Layer #}
                    <div class="absolute inset-0 w-full h-full transition-transform duration-700 ease-out group-hover:scale-105"
                         style="
                         {% if card.background_is_image and card.bg_image %}
                             background-image: url('{{ card.bg_image }}'); background-size: cover; background-position: center;
                         {% else %}
                             background-color: {{ card.bg_color|default('#f5f0eb') }};
                         {% endif %}
                         "></div>

                    {# Card body — positioned at bottom #}
                    <div class="relative z-10 w-full p-6 md:p-8 flex flex-col items-center text-center">

                        {% if card.title %}
                        <h3 class="text-xl md:text-2xl font-semibold mb-6 line-clamp-2"
                            style="color: {{ card.title_color|default('#18181b') }};">
                            {{ card.title }}
                        </h3>
                        {% endif %}

                        {% if card.button_text %}
                        <a href="{{ card.btn_url|default('#') }}"
                           class="inline-flex items-center justify-center px-8 py-3 rounded-full text-sm font-medium transition-all duration-300 hover:-translate-y-1 hover:shadow-lg active:scale-95"
                           style="background-color: {{ card.button_bg_color|default('#18181b') }};
                                  color: {{ card.button_text_color|default('#ffffff') }};">
                            {{ card.button_text }}
                        </a>
                        {% endif %}

                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    {% endif %}

</section>

<style>
/* ── Section ── */
.SK-cards-section {
    padding: 4rem 1.5rem;
}

/* ── Header ── */
.SK-cards-section__header {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
}

.SK-cards-section__title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
}

.SK-cards-section__cta-link {
    display: inline-block;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1.5px solid currentColor;
    transition: opacity 0.2s;
}
.SK-cards-section__cta-link:hover {
    opacity: 0.7;
}

/* ── Responsive ── */
@media (max-width: 640px) {
    .SK-cards-section {
        padding: 2.5rem 1rem;
    }
}
</style>