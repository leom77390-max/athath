{# ================================================
   SK Cards Section — matches design in screenshot
   Header: big title (center) + underlined CTA link
   Body:   responsive grid of image-bg cards
           each card: image top + title + pill button
   ================================================ #}

{% set bg_style = component.background_is_image and component.background_image
    ? 'background-image:url(' ~ component.background_image ~ ');background-size:cover;background-position:center;'
    : 'background-color:' ~ component.background_color|default('#ffffff') ~ ';' %}

<section class="SK-cards-section {{ component.add_inside_container ? 'container' : '' }} {{ component.rm_margin ? 'mb-0' : 'mb-12' }}"
         style="{{ bg_style }}">

    {# ── Section Header ── #}
    {% if component.main_title or component.cta_text %}
    <div class="SK-cards-section__header text-center mb-12">

        {% if component.main_title %}
        <h2 class="SK-cards-section__title"
            style="color: {{ component.customize_colors ? component.main_title_color|default('#18181b') : '#18181b' }};">
            {{ component.main_title }}
        </h2>
        {% endif %}

        {% if component.cta_text %}
        <a href="{{ component.cta_url|default('#') }}"
           class="SK-cards-section__cta-link"
           style="color: {{ component.customize_colors ? component.cta_color|default('#18181b') : '#18181b' }};">
            {{ component.cta_text }}
        </a>
        {% endif %}

    </div>
    {% endif %}

    {# ── Cards Grid ── #}
    <div class="SK-cards-section__grid">
        {% for card in component.card %}
        <div class="SK-card"
             style="background-color: {{ card.bg_color|default('#f5f0eb') }};
                    border-radius: {{ card.corner_rounded|default(16) }}px;">

            {# Card image — top portion #}
            {% if card.bg_image %}
            <div class="SK-card__image-wrap"
                 style="border-radius: {{ card.corner_rounded|default(16) }}px {{ card.corner_rounded|default(16) }}px 0 0;">
                <img src="{{ card.bg_image }}"
                     alt="{{ card.title|default('') }}"
                     class="SK-card__image" />
            </div>
            {% else %}
            <div class="SK-card__image-wrap SK-card__image-wrap--empty"
                 style="border-radius: {{ card.corner_rounded|default(16) }}px {{ card.corner_rounded|default(16) }}px 0 0;
                        background-color: {{ card.bg_color|default('#f5f0eb') }};"></div>
            {% endif %}

            {# Card body — title + button #}
            <div class="SK-card__body">

                {% if card.title %}
                <h3 class="SK-card__title"
                    style="color: {{ card.title_color|default('#18181b') }};">
                    {{ card.title }}
                </h3>
                {% endif %}

                {% if card.button_text %}
                <a href="{{ card.btn_url|default('#') }}"
                   class="SK-card__btn"
                   style="background-color: {{ card.button_bg_color|default('#18181b') }};
                          color: {{ card.button_text_color|default('#ffffff') }};">
                    {{ card.button_text }}
                </a>
                {% endif %}

            </div>
        </div>
        {% endfor %}
    </div>

</section>

<style>
/* ── Section ── */
.SK-cards-section {
    padding: 4rem 1.5rem;
}

/* ── Header ── */
.SK-cards-section__header {
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
}

.SK-cards-section__title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
}

.SK-cards-section__cta-link {
    display: inline-block;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 1.5px solid currentColor;
    transition: opacity 0.2s;
}
.SK-cards-section__cta-link:hover {
    opacity: 0.7;
}

/* ── Grid ── */
.SK-cards-section__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
}

/* ── Card ── */
.SK-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

/* Image area — fixed aspect ratio */
.SK-card__image-wrap {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    flex-shrink: 0;
}
.SK-card__image-wrap--empty {
    aspect-ratio: 4 / 5;
}
.SK-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
}
.SK-card:hover .SK-card__image {
    transform: scale(1.03);
}

/* Body — title + button */
.SK-card__body {
    padding: 1.25rem 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
}

.SK-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
}

/* Pill button */
.SK-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.75rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s, transform 0.15s;
}
.SK-card__btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
}

/* ── Responsive ── */
@media (max-width: 640px) {
    .SK-cards-section {
        padding: 2.5rem 1rem;
    }
    .SK-cards-section__grid {
        grid-template-columns: 1fr;
    }
}
</style>