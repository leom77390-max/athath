{% set slides = component.hero_slideshow_slides|default([]) %}
{% set effect_v = component.hs_transition_effect.value|default(component.hs_transition_effect|default('fade')) %}
{% set effect = effect_v is iterable ? effect_v|first : effect_v %}
{% set pag_style_v = component.hs_pagination_style.value|default(component.hs_pagination_style|default('bullets')) %}
{% set pag_style = pag_style_v is iterable ? pag_style_v|first : pag_style_v %}
{% set pag_pos_v = component.hs_pagination_position.value|default(component.hs_pagination_position|default('bottom-center')) %}
{% set pag_pos = pag_pos_v is iterable ? pag_pos_v|first : pag_pos_v %}
{% set arrows_vis_v = component.hs_arrows_visibility.value|default(component.hs_arrows_visibility|default('desktop')) %}
{% set arrows_vis = arrows_vis_v is iterable ? arrows_vis_v|first : arrows_vis_v %}
{% set autoplay_speed = component.hs_autoplay_speed|default(4000) %}
{% set transition_speed = component.hs_transition_speed|default(700) %}

<style>
	.hero-slideshow-{{ component.id }} {
		height: {{ component.hs_mobile_height | default('620px') }};
	}
	@media(min-width: 768px) {
		.hero-slideshow-{{ component.id }} {
			height: {{ component.hs_tablet_height | default('500px') }};
		}
	}
	@media(min-width: 1024px) {
		.hero-slideshow-{{ component.id }} {
			height: {{ component.hs_desktop_height | default('620px') }};
		}
	}

	.hero-slideshow-{{ component.id }} .swiper-slide {
		position: relative;
		overflow: hidden;
	}

	.hero-slideshow-{{ component.id }} .hs-slide-bg-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		{% if component.hs_enable_zoom_animation %}
			transform: scale(1);
			transition: transform {{ (autoplay_speed + transition_speed) }}ms ease-out;
		{% endif %}
	}

	{% if component.hs_enable_zoom_animation %}
		.hero-slideshow-{{ component.id }} .swiper-slide-active .hs-slide-bg-img {
			transform: scale(1.12);
		}
	{% endif %}

	.hero-slideshow-{{ component.id }} .hs-overlay {
		position: absolute;
		inset: 0;
		background-color: #000000;
	}

	.hero-slideshow-{{ component.id }} .hs-content {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		padding: 24px;
		z-index: 10;
	}

	@media(min-width: 768px) {
		.hero-slideshow-{{ component.id }} .hs-content {
			padding: 64px;
		}
	}

	.hero-slideshow-{{ component.id }} .hs-text-box {
		max-width: 640px;
	}

	.hero-slideshow-{{ component.id }} .hs-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 12px 28px;
		font-size: 13px;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		font-weight: 600;
		transition: all .25s ease;
	}
	.hero-slideshow-{{ component.id }} .hs-btn--underline {
		padding: 0 0 4px 0;
		border-bottom: 1px solid currentColor;
	}
	.hero-slideshow-{{ component.id }} .hs-btn--solid.hs-scheme-light {
		background-color: #ffffff;
		color: #000000;
	}
	.hero-slideshow-{{ component.id }} .hs-btn--solid.hs-scheme-dark {
		background-color: #000000;
		color: #ffffff;
	}
	.hero-slideshow-{{ component.id }} .hs-btn--outline {
		border: 1px solid currentColor;
		background: transparent;
	}

	.hero-slideshow-{{ component.id }} .swiper-pagination-bullet {
		background: #ffffff;
		opacity: .6;
	}
	.hero-slideshow-{{ component.id }} .swiper-pagination-bullet-active {
		opacity: 1;
	}

	{% if not component.hs_show_arrows or arrows_vis == 'desktop' %}
		.hero-slideshow-{{ component.id }} .hs-nav-btn {
			display: none;
		}
		@media(min-width: 1024px) {
			.hero-slideshow-{{ component.id }} .hs-nav-btn {
				display: {{ component.hs_show_arrows ? 'flex' : 'none' }};
			}
		}
	{% endif %}

	{% if component.hs_hide_on_desktop %}
		@media(min-width: 1024px) { .hero-slideshow-{{ component.id }} { display: none !important; } }
	{% endif %}
	{% if component.hs_hide_on_tablet %}
		@media(min-width: 768px) and (max-width: 1023px) { .hero-slideshow-{{ component.id }} { display: none !important; } }
	{% endif %}
	{% if component.hs_hide_on_mobile %}
		@media(max-width: 767px) { .hero-slideshow-{{ component.id }} { display: none !important; } }
	{% endif %}
</style>

<section id="{{ component.hs_section_id }}" class="hero-slideshow-wrap-{{ component.id }} relative w-full {{ component.hs_custom_css_class }}">
	<div class="swiper hero-slideshow-{{ component.id }} w-full h-full relative">
		<div class="swiper-wrapper">
			{% for slide in slides %}
				{% set _desk_img = slide.desktop_image|default('')|trim %}
				{% set _desk_img = _desk_img is iterable ? _desk_img|first : _desk_img %}
				{% set _mob_img = slide.mobile_image|default(_desk_img)|trim %}
				{% set _mob_img = _mob_img is iterable ? _mob_img|first : _mob_img %}

				{% set scheme_v = slide.text_scheme.value|default(slide.text_scheme|default('light')) %}
				{% set scheme = scheme_v is iterable ? scheme_v|first : scheme_v %}
				{% set text_color = (scheme == 'dark') ? '#18181b' : '#ffffff' %}

				{% set h_pos_v = slide.horizontal_position.value|default(slide.horizontal_position|default('start')) %}
				{% set h_pos = h_pos_v is iterable ? h_pos_v|first : h_pos_v %}
				{% set v_pos_v = slide.vertical_position.value|default(slide.vertical_position|default('end')) %}
				{% set v_pos = v_pos_v is iterable ? v_pos_v|first : v_pos_v %}
				{% set align_v = slide.text_alignment.value|default(slide.text_alignment|default('start')) %}
				{% set align = align_v is iterable ? align_v|first : align_v %}

				{% set justify_class = (v_pos == 'start') ? 'justify-start' : (v_pos == 'center' ? 'justify-center' : 'justify-end') %}
				{% set items_class = (h_pos == 'start') ? 'items-start' : (h_pos == 'center' ? 'items-center' : 'items-end') %}
				{% set text_align_class = (align == 'center') ? 'text-center' : (align == 'end' ? 'text-end' : 'text-start') %}

				{% set _btn_val = slide.btn_url is iterable ? slide.btn_url|first : slide.btn_url %}
				{% set _slide_btn_url = _btn_val.url|default(_btn_val|default('#')) %}

				{% set btn_style_v = slide.btn_style.value|default(slide.btn_style|default('underline')) %}
				{% set btn_style = btn_style_v is iterable ? btn_style_v|first : btn_style_v %}

				{% set overlay_opacity = slide.overlay_opacity|default(10) %}

				<div class="swiper-slide" data-slide-index="{{ loop.index0 }}">
					<picture class="absolute inset-0 w-full h-full block">
						{% if _mob_img %}
							<source media="(max-width: 767px)" srcset="{{ _mob_img }}">
						{% endif %}
						<img class="hs-slide-bg-img" src="{{ _desk_img }}" alt="{{ slide.alt_text|default('') }}" loading="{{ loop.first ? 'eager' : 'lazy' }}">
					</picture>

					<div class="hs-overlay" style="opacity: {{ overlay_opacity / 100 }};"></div>

					<div class="hs-content flex {{ justify_class }} {{ items_class }}">
						<div class="hs-text-box {{ text_align_class }}" style="color: {{ text_color }};">
							{% if slide.heading %}
								<h2 class="text-3xl md:text-6xl font-serif mb-4 leading-tight">{{ slide.heading }}</h2>
							{% endif %}
							{% if slide.description %}
								<p class="text-base md:text-lg mb-6 opacity-90">{{ slide.description }}</p>
							{% endif %}
							{% if slide.btn_text %}
								<a href="{{ _slide_btn_url }}" class="hs-btn hs-btn--{{ btn_style }} hs-scheme-{{ scheme }}" style="{{ btn_style == 'underline' or btn_style == 'outline' ? 'color:' ~ text_color ~ ';' : '' }}">
									{{ slide.btn_text }}
								</a>
							{% endif %}
						</div>
					</div>
				</div>
			{% endfor %}
		</div>

		{% if component.hs_show_pagination %}
			<div class="swiper-pagination hs-pagination-{{ component.id }} absolute z-20 flex gap-2
				{{ pag_pos == 'bottom-start' ? 'justify-start ltr:left-8 rtl:right-8' : (pag_pos == 'bottom-end' ? 'justify-end ltr:right-8 rtl:left-8' : 'justify-center left-0 right-0') }}"
				style="bottom: 24px;"></div>
		{% endif %}

		{% if component.hs_show_arrows %}
			<button type="button" class="hs-nav-btn hs-prev-{{ component.id }} absolute z-20 top-1/2 -translate-y-1/2 ltr:left-4 rtl:right-4 items-center justify-center w-10 h-10 rounded-full bg-white/80">
				<span class="sicon-arrow-{{ component.direction == 'rtl' ? 'right' : 'left' }}"></span>
			</button>
			<button type="button" class="hs-nav-btn hs-next-{{ component.id }} absolute z-20 top-1/2 -translate-y-1/2 ltr:right-4 rtl:left-4 items-center justify-center w-10 h-10 rounded-full bg-white/80">
				<span class="sicon-arrow-{{ component.direction == 'rtl' ? 'left' : 'right' }}"></span>
			</button>
		{% endif %}
	</div>
</section>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		if (typeof Swiper === 'undefined') {
			console.warn('Swiper library not found — hero-slideshow-{{ component.id }} cannot initialize.');
			return;
		}

		new Swiper('.hero-slideshow-{{ component.id }}', {
			effect: '{{ effect }}',
			fadeEffect: { crossFade: true },
			speed: {{ transition_speed }},
			loop: {{ component.hs_enable_loop ? 'true' : 'false' }},
			autoplay: {{ component.hs_enable_autoplay ? ('{ delay: ' ~ autoplay_speed ~ ', disableOnInteraction: false }') : 'false' }},
			{% if component.hs_show_pagination %}
			pagination: {
				el: '.hs-pagination-{{ component.id }}',
				clickable: true,
				type: '{{ pag_style }}'
			},
			{% endif %}
			{% if component.hs_show_arrows %}
			navigation: {
				nextEl: '.hs-next-{{ component.id }}',
				prevEl: '.hs-prev-{{ component.id }}'
			},
			{% endif %}
			on: {
				init: function () {
					this.el.querySelectorAll('.swiper-slide')[this.activeIndex]?.classList.add('swiper-slide-active');
				}
			}
		});
	});
</script>
