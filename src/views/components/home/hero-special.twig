{% set slides = component.hero_slideshow_slides|default([]) %}

{# ── Safe iterable helpers ── #}
{% set effect_v      = component.hs_transition_effect.value|default(component.hs_transition_effect|default('fade')) %}
{% set effect        = effect_v is iterable ? effect_v|first : effect_v %}

{% set pag_style_v   = component.hs_pagination_style.value|default(component.hs_pagination_style|default('bullets')) %}
{% set pag_style     = pag_style_v is iterable ? pag_style_v|first : pag_style_v %}

{% set pag_pos_v = component.hs_pagination_position %}
{% set pag_pos   = pag_pos_v.value ?? (pag_pos_v is iterable ? pag_pos_v|first : pag_pos_v) %}
{% set pag_pos   = pag_pos.value ?? pag_pos %}
{% set pag_pos   = pag_pos ?: 'bottom-center' %}

{% set arr_vis_v     = component.hs_arrows_visibility.value|default(component.hs_arrows_visibility|default('desktop')) %}
{% set arr_vis       = arr_vis_v is iterable ? arr_vis_v|first : arr_vis_v %}

{% set autoplay_speed    = component.hs_autoplay_speed|default(4000) %}
{% set transition_speed  = component.hs_transition_speed|default(700) %}


{% set anim_enable = component.hs_content_anim_enable|default(true) %}
{% set anim_dir_v = component.hs_content_anim_direction.value|default(component.hs_content_anim_direction|default('right')) %}
{% set anim_dir = anim_dir_v is iterable ? anim_dir_v|first : anim_dir_v %}

<style>
	/* ─── Wrapper heights ─── */
	.hs-wrap-{{ component.id }} {
		height: {{ component.hs_mobile_height | default('620px') }};
	}
	@media(min-width: 768px) {
		.hs-wrap-{{ component.id }} {
			height: {{ component.hs_tablet_height | default('500px') }};
		}
	}
	@media(min-width: 1024px) {
		.hs-wrap-{{ component.id }} {
			height: {{ component.hs_desktop_height | default('620px') }};
		}
	}

	.hs-wrap-{{ component.id }} salla-slider,
	.hs-wrap-{{ component.id }} .swiper,
	.hs-wrap-{{ component.id }} .swiper-wrapper {
		height: 100%;
	}

	.hs-wrap-{{ component.id }} .swiper-slide {
		position: relative;
		overflow: hidden;
	}

	/* ─── Background image + Ken Burns ─── */
	.hs-wrap-{{ component.id }} .hs-slide-bg-img {
		position: absolute;
		inset: 0;
		width: 120%;
		height: 110%;
		top: -5%;
		left: -10%;
		object-fit: cover;
		object-position: center;
		will-change: transform;
		{% if component.hs_enable_zoom_animation %}
			transform: scale(1);
			transition: transform {{ (autoplay_speed + transition_speed) }}ms ease-out;
		{% endif %}
	}
	{% if component.hs_enable_zoom_animation %}
		.hs-wrap-{{ component.id }} .swiper-slide-active .hs-slide-bg-img {
			transform: scale(1.08);
		}
	{% endif %}

	/* ─── Overlay ─── */
	.hs-wrap-{{ component.id }} .hs-overlay {
		position: absolute;
		inset: 0;
		background-color: #000000;
		pointer-events: none;
		z-index: 1;
	}

	/* ─── Content wrapper ─── */
	.hs-wrap-{{ component.id }} .hs-content {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		padding: 24px;
		z-index: 2;
		{% if enable_parallax %}
			perspective: 1000px;
		{% endif %}
	}
	@media(min-width: 768px) {
		.hs-wrap-{{ component.id }} .hs-content {
			padding: 64px;
		}
	}

	/* ─── Text box (parallax target) ─── */
	.hs-wrap-{{ component.id }} .hs-text-box {
		max-width: 640px;
	}

	/* ─── Content Animation ─── */
	{% if anim_enable %}
		.hs-wrap-{{ component.id }} .hs-text-box.hs-anim-active {
			opacity: 0;
			transition: opacity 0.8s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
		}
		{% if anim_dir == 'right' %}
			.hs-wrap-{{ component.id }} .hs-text-box.hs-anim-active { transform: translateX(50px); }
		{% elseif anim_dir == 'left' %}
			.hs-wrap-{{ component.id }} .hs-text-box.hs-anim-active { transform: translateX(-50px); }
		{% elseif anim_dir == 'top' %}
			.hs-wrap-{{ component.id }} .hs-text-box.hs-anim-active { transform: translateY(-50px); }
		{% elseif anim_dir == 'bottom' %}
			.hs-wrap-{{ component.id }} .hs-text-box.hs-anim-active { transform: translateY(50px); }
		{% endif %}

		/* When slide is active, animate in */
		.hs-wrap-{{ component.id }} .swiper-slide-active .hs-text-box.hs-anim-active {
			opacity: 1;
			transform: translate(0, 0);
		}
	{% endif %}

	/* ─── Heading ─── */
	.hs-wrap-{{ component.id }} .hs-heading {
		font-family: var(--font-serif, Georgia, serif);
		font-size: clamp(2rem, 6vw, 5rem);
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: -0.01em;
		margin-bottom: 1rem;
	}

	/* ─── Description ─── */
	.hs-wrap-{{ component.id }} .hs-desc {
		font-size: clamp(0.9rem, 1.5vw, 1.125rem);
		line-height: 1.65;
		opacity: 0.88;
		margin-bottom: 1.75rem;
		max-width: 480px;
	}

	/* ─── Buttons ─── */
	.hs-wrap-{{ component.id }} .hs-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 13px;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		font-weight: 600;
		text-decoration: none;
		transition: opacity .25s ease;
	}
	.hs-wrap-{{ component.id }} .hs-btn--underline {
		position: relative;
		padding-bottom: 4px;
	}
	.hs-wrap-{{ component.id }} .hs-btn--underline::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 1.5px;
		background: currentColor;
	}
	.hs-wrap-{{ component.id }} .hs-btn--underline:hover { opacity: 0.65; }
	.hs-wrap-{{ component.id }} .hs-btn--underline:hover::after {
		animation: hsBorderSlide-{{ component.id }} 0.65s cubic-bezier(0.77, 0, 0.175, 1) forwards;
	}
	@keyframes hsBorderSlide-{{ component.id }} {
		0%   { transform-origin: right; transform: scaleX(1); }
		49%  { transform-origin: right; transform: scaleX(0); }
		50%  { transform-origin: left;  transform: scaleX(0); }
		100% { transform-origin: left;  transform: scaleX(1); }
	}
	.hs-wrap-{{ component.id }} .hs-btn--solid { padding: 12px 28px; }
	.hs-wrap-{{ component.id }} .hs-btn--solid.hs-scheme-light { background-color: #fff; color: #000; }
	.hs-wrap-{{ component.id }} .hs-btn--solid.hs-scheme-dark  { background-color: #000; color: #fff; }
	.hs-wrap-{{ component.id }} .hs-btn--outline {
		padding: 12px 28px;
		border: 1px solid currentColor;
		background: transparent;
	}

	/* ─── Pagination ─── */
	.hs-wrap-{{ component.id }} salla-slider::part(pagination) { display: none !important; }

	.hs-wrap-{{ component.id }} .hs-pagination-wrap {
		position: absolute;
		z-index: 10;
		bottom: 20px;
		left: 0;
		right: 0;
		display: flex;
		gap: 6px;
		pointer-events: none;
		{% if pag_pos == 'bottom-start' %}
			{% if store.dir == 'rtl' %}
				justify-content: flex-end;
			{% else %}
				justify-content: flex-start;
			{% endif %}
			padding: 0 2rem;
		{% elseif pag_pos == 'bottom-end' %}
			{% if store.dir == 'rtl' %}
				justify-content: flex-start;
			{% else %}
				justify-content: flex-end;
			{% endif %}
			padding: 0 2rem;
		{% else %}
			justify-content: center;
		{% endif %}
	}

	{% if pag_style == 'bullets' %}
	.hs-wrap-{{ component.id }} .hs-pagination-wrap .swiper-pagination-bullet {
		pointer-events: all;
		width: 8px;
		height: 8px;
		background: rgba(255,255,255,0.55);
		border-radius: 99px;
		cursor: pointer;
		transition: background .3s, width .3s;
		display: inline-block;
	}
	.hs-wrap-{{ component.id }} .hs-pagination-wrap .swiper-pagination-bullet-active {
		background: #fff;
		width: 24px;
	}
	{% endif %}

	{% if pag_style == 'fraction' %}
	.hs-wrap-{{ component.id }} .hs-pagination-wrap {
		font-size: 13px;
		font-weight: 600;
		color: #fff;
		letter-spacing: 0.1em;
	}
	{% endif %}

	{% if pag_style == 'progressbar' %}
	.hs-wrap-{{ component.id }} .hs-pagination-wrap {
		bottom: 0;
		height: 3px;
		gap: 0;
		padding: 0;
	}
	.hs-wrap-{{ component.id }} .hs-pagination-wrap .swiper-pagination-progressbar-fill {
		background: #fff;
		height: 100%;
		display: block;
	}
	{% endif %}

	/* ─── Nav arrows ─── */
	.hs-wrap-{{ component.id }} .hs-prev,
	.hs-wrap-{{ component.id }} .hs-next {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		background: rgba(255,255,255,.8);
		border: none;
		cursor: pointer;
	}
	.hs-wrap-{{ component.id }} .hs-prev { inset-inline-start: 1rem; }
	.hs-wrap-{{ component.id }} .hs-next { inset-inline-end: 1rem; }

	{% if component.hs_show_arrows %}
		{% if arr_vis == 'desktop' %}
			@media(max-width: 1023px) {
				.hs-wrap-{{ component.id }} .hs-prev,
				.hs-wrap-{{ component.id }} .hs-next { display: none !important; }
			}
		{% endif %}
	{% else %}
		.hs-wrap-{{ component.id }} .hs-prev,
		.hs-wrap-{{ component.id }} .hs-next { display: none !important; }
	{% endif %}

	/* ─── Visibility overrides ─── */
	{% if component.hs_hide_on_desktop %}
		@media(min-width: 1024px) { .hs-wrap-{{ component.id }} { display: none !important; } }
	{% endif %}
	{% if component.hs_hide_on_tablet %}
		@media(min-width: 768px) and (max-width: 1023px) { .hs-wrap-{{ component.id }} { display: none !important; } }
	{% endif %}
	{% if component.hs_hide_on_mobile %}
		@media(max-width: 767px) { .hs-wrap-{{ component.id }} { display: none !important; } }
	{% endif %}
</style>

<section
	id="{{ component.hs_section_id }}"
	class="hs-wrap-{{ component.id }} relative w-full {{ component.hs_custom_css_class }}"
>
	<salla-slider
		id="hs-slider-{{ component.id }}"
		type="carousel"
		auto-play="{{ component.hs_enable_autoplay ? 'true' : 'false' }}"
		show-controls="false"
		pagination="false"
		slides-per-view="1"
		speed="{{ transition_speed }}"
		class="w-full h-full"
		slider-config='{
			"slidesPerView": 1,
			"effect": "{{ effect }}",
			"fadeEffect": { "crossFade": true },
			"speed": {{ transition_speed }},
			"loop": {{ component.hs_enable_loop ? "true" : "false" }},
			"parallax": true,
			{% if component.hs_enable_autoplay %}
			"autoplay": {
				"delay": {{ autoplay_speed }},
				"disableOnInteraction": false,
				"pauseOnMouseEnter": true
			},
			{% endif %}
			{% if component.hs_show_pagination %}
			"pagination": {
				"el": ".hs-pagination-wrap-{{ component.id }}",
				"clickable": true,
				"type": "{{ pag_style }}"
			},
			{% endif %}
			{% if component.hs_show_arrows %}
			"navigation": {
				"nextEl": ".hs-next-{{ component.id }}",
				"prevEl": ".hs-prev-{{ component.id }}"
			},
			{% endif %}
			"on": {}
		}'
	>
		<div slot="items">
			{% for slide in slides %}

				{# ── images ── #}
				{% set _desk_img = slide.desktop_image|default('')|trim %}
				{% set _desk_img = _desk_img is iterable ? _desk_img|first : _desk_img %}
				{% set _mob_img  = slide.mobile_image|default(_desk_img)|trim %}
				{% set _mob_img  = _mob_img is iterable ? _mob_img|first : _mob_img %}

				{# ── multilang text ── #}
				{% set _heading = slide.heading %}
				{% set _heading = _heading is iterable ? (_heading[store.locale]|default(_heading['ar']|default(_heading|first))) : _heading %}

				{% set _desc = slide.description %}
				{% set _desc = _desc is iterable ? (_desc[store.locale]|default(_desc['ar']|default(_desc|first))) : _desc %}

				{% set _btn_text = slide.btn_text %}
				{% set _btn_text = _btn_text is iterable ? (_btn_text[store.locale]|default(_btn_text['ar']|default(_btn_text|first))) : _btn_text %}

				{# ── scheme / colors ── #}
				{% set scheme_v   = slide.text_scheme.value|default(slide.text_scheme|default('light')) %}
				{% set scheme     = scheme_v is iterable ? scheme_v|first : scheme_v %}
				{% set text_color = (scheme == 'dark') ? '#18181b' : '#ffffff' %}

				{# ── positioning ── #}
				{% set h_pos_v = slide.horizontal_position.value|default(slide.horizontal_position|default('start')) %}
				{% set h_pos   = h_pos_v is iterable ? h_pos_v|first : h_pos_v %}
				{% set v_pos_v = slide.vertical_position.value|default(slide.vertical_position|default('end')) %}
				{% set v_pos   = v_pos_v is iterable ? v_pos_v|first : v_pos_v %}
				{% set align_v = slide.text_alignment.value|default(slide.text_alignment|default('start')) %}
				{% set align   = align_v is iterable ? align_v|first : align_v %}

				{% set justify_class  = (v_pos == 'start') ? 'justify-start' : (v_pos == 'center' ? 'justify-center' : 'justify-end') %}
				{% set items_class    = (h_pos == 'start') ? 'items-start' : (h_pos == 'center' ? 'items-center' : 'items-end') %}
				{% set text_align_cls = (align == 'center') ? 'text-center' : (align == 'end' ? 'text-end' : 'text-start') %}

				{# ── button ── #}
				{% set _btn_val       = slide.btn_url is iterable ? slide.btn_url|first : slide.btn_url %}
				{% set _slide_btn_url = _btn_val.url|default(_btn_val|default('#')) %}

				{% set btn_style_v = slide.btn_style.value|default(slide.btn_style|default('underline')) %}
				{% set btn_style   = btn_style_v is iterable ? btn_style_v|first : btn_style_v %}

				{% set overlay_opacity = slide.overlay_opacity|default(10) %}

				<div class="swiper-slide">
					<picture class="absolute inset-0 w-full h-full block" data-swiper-parallax="20%">
						{% if _mob_img %}
							<source media="(max-width: 767px)" srcset="{{ _mob_img }}">
						{% endif %}
						<img
							class="hs-slide-bg-img"
							src="{{ _desk_img }}"
							alt="{{ slide.alt_text|default('') }}"
							loading="{{ loop.first ? 'eager' : 'lazy' }}"
						>
					</picture>

					<div class="hs-overlay" style="opacity: {{ overlay_opacity / 100 }};"></div>

					<div class="hs-content flex {{ justify_class }} {{ items_class }}" data-swiper-parallax="{% if store.dir == 'rtl' %}-300{% else %}300{% endif %}" data-swiper-parallax-opacity="0">
						<div
							class="hs-text-box {{ text_align_cls }}{% if anim_enable %} hs-anim-active{% endif %}"
							style="color: {{ text_color }};"
						>
							{% if _heading %}
								<h2 class="hs-heading">{{ _heading }}</h2>
							{% endif %}
							{% if _desc %}
								<p class="hs-desc">{{ _desc }}</p>
							{% endif %}
							{% if _btn_text %}
								<a href="{{ _slide_btn_url }}"
								   class="hs-btn hs-btn--{{ btn_style }} hs-scheme-{{ scheme }}"
								   style="{{ btn_style == 'underline' or btn_style == 'outline' ? 'color:' ~ text_color ~ ';' : '' }}">
									{{ _btn_text }}
								</a>
							{% endif %}
						</div>
					</div>
				</div>

			{% endfor %}
		</div>
	</salla-slider>

	{# ── Pagination ── #}
	{% if component.hs_show_pagination %}
		<div class="hs-pagination-wrap hs-pagination-wrap-{{ component.id }}"></div>
	{% endif %}

	{# ── Arrows ── #}
	{% if component.hs_show_arrows %}
		<button type="button" class="hs-prev hs-prev-{{ component.id }}" aria-label="Previous">
			<span class="sicon-arrow-{% if store.dir == 'rtl' %}right{% else %}left{% endif %}"></span>
		</button>
		<button type="button" class="hs-next hs-next-{{ component.id }}" aria-label="Next">
			<span class="sicon-arrow-{% if store.dir == 'rtl' %}left{% else %}right{% endif %}"></span>
		</button>
	{% endif %}

</section>


