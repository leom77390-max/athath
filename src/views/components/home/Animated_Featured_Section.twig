{% set hm = component %}
{% set width_val = hm.section_width[0].value ?? hm.section_width %}
{% set height_val = hm.section_height[0].value ?? hm.section_height %}
{% set is_container = width_val == 'container' %}
{% set color_style = hm.special_colors_condition ? 'background-color: ' ~ hm.bg_color ~ '; color: ' ~ hm.text_color ~ ';' : '' %}
{% set text_class = hm.special_colors_condition ? 'text-current' : 'text-white' %}
{% set border_class = hm.special_colors_condition ? 'border-current' : 'border-white/70' %}
{% set border_hover_class = hm.special_colors_condition ? 'hover:border-current' : 'hover:border-white' %}

{% if hm.background_image %}
<section class="w-full relative {% if is_container %}py-8 lg:py-16{% endif %}" style="{{ color_style }}">
    <div class="{{ is_container ? 'container mx-auto px-4' : 'w-full' }}">
        <div
            class="hero-marquee relative w-full overflow-hidden flex flex-col {{ is_container ? 'rounded-2xl' : '' }}"
            style="height: {{ height_val|default('650') }}px;"
            aria-label="{{ hm.subheading|default('Hero banner') }}"
        >
            {# ============ Background ============ #}
            <img
                src="{{ hm.background_image }}"
                alt="{{ hm.subheading|default('') }}"
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover object-center -z-20"
            >
            <span
                class="absolute inset-0 bg-black -z-10"
                style="opacity: {{ (hm.overlay_opacity|default('35') / 100) }};"
            ></span>

            {# ============ Marquee ============ #}
            {% if hm.marquee_text %}
                <div class="hero-marquee__track relative w-full overflow-hidden py-4 md:py-6 border-b {{ hm.special_colors_condition ? 'border-current/20' : 'border-white/20' }}">
                    <div
                        class="hero-marquee__inner flex whitespace-nowrap will-change-transform"
                        style="animation-duration: {{ hm.marquee_speed|default('25') }}s;"
                    >
                        {% for i in 1..2 %}
                            <div class="flex items-center shrink-0">
                                {% for j in 1..6 %}
                                    <span class="hero-marquee__item font-serif text-3xl md:text-5xl {{ text_class }} uppercase mx-6 md:mx-10">
                                        {{ hm.marquee_text }}
                                    </span>
                                {% endfor %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {# ============ Centered content ============ #}
            <div class="relative flex-1 flex flex-col items-center justify-center text-center px-4 gap-5">
                {% if hm.subheading %}
                    <p class="{{ text_class }} text-base md:text-lg max-w-xl">
                        {{ hm.subheading }}
                    </p>
                {% endif %}

                {% if hm.button_text and hm.button_url %}
                    {% include 'components.custom.special_button' with {
                        text: hm.button_text,
                        url: hm.button_url,
                        class: text_class ~ ' text-xs md:text-sm tracking-[2px]'
                    } %}
                {% endif %}
            </div>
        </div>
    </div>
</section>

{% endif %}

<style>
    .hero-marquee__inner {
        animation-name: hero-marquee-scroll;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    .hero-marquee:hover .hero-marquee__inner {
        animation-play-state: paused;
    }

    @keyframes hero-marquee-scroll {
        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
    }

    .hero-marquee__item {
        letter-spacing: 1px;
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-marquee__inner {
            animation: none;
        }
    }
</style>