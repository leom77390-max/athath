{% set ig = component %}
{% set anim_class = ig.enable_floating_animation ? 'ig-float-animation' : '' %}
{% set delays = [0, 1.5, 0.7, 2, 1] %}
{% set align_class = ig.title_alignment == 'start' ? 'text-start items-start' : (ig.title_alignment == 'end' ? 'text-end items-end' : 'text-center items-center') %}

{% if ig.images|length %}
<section
    class="ig-collage relative w-full overflow-hidden py-16 lg:py-24"
    style="background-color: {{ ig.bg_color|default('#f3efe9') }}; color: {{ ig.text_color|default('#18181b') }};"
    aria-label="{{ ig.heading }}"
>
    <div class="{{ ig.section_width == 'wide' ? 'w-full px-4 md:px-8' : 'container mx-auto px-4' }}">

        {# ============ DESKTOP — scattered collage ============ #}
        <div class="ig-collage__desktop hidden md:block relative mx-auto max-w-[1500px] h-[760px]">

            {% for item in ig.images %}
                {% if loop.index == 1 %}
                    <figure class="absolute top-[5%] left-[5%] w-[22%] max-w-[320px] shadow-sm z-0 {{ anim_class }}" {{ ig.enable_floating_animation ? 'style="animation-delay: ' ~ delays[loop.index0 % 5] ~ 's;"' : ''|raw }}>
                        <img src="{{ item.image }}" alt="{{ item.alt|default(ig.heading) }}" loading="lazy" class="w-full h-auto object-cover aspect-[4/5]">
                    </figure>
                {% elseif loop.index == 2 %}
                    <figure class="absolute top-[34%] left-[1%] w-[14%] max-w-[190px] shadow-sm z-10 {{ anim_class }}" {{ ig.enable_floating_animation ? 'style="animation-delay: ' ~ delays[loop.index0 % 5] ~ 's;"' : ''|raw }}>
                        <img src="{{ item.image }}" alt="{{ item.alt|default(ig.heading) }}" loading="lazy" class="w-full h-auto object-cover aspect-square">
                    </figure>
                {% elseif loop.index == 3 %}
                    <figure class="absolute bottom-[5%] left-[15%] w-[16%] max-w-[220px] shadow-sm z-0 {{ anim_class }}" {{ ig.enable_floating_animation ? 'style="animation-delay: ' ~ delays[loop.index0 % 5] ~ 's;"' : ''|raw }}>
                        <img src="{{ item.image }}" alt="{{ item.alt|default(ig.heading) }}" loading="lazy" class="w-full h-auto object-cover aspect-[4/5]">
                    </figure>
                {% elseif loop.index == 4 %}
                    <figure class="absolute top-[12%] right-[5%] w-[24%] max-w-[340px] shadow-sm z-0 {{ anim_class }}" {{ ig.enable_floating_animation ? 'style="animation-delay: ' ~ delays[loop.index0 % 5] ~ 's;"' : ''|raw }}>
                        <img src="{{ item.image }}" alt="{{ item.alt|default(ig.heading) }}" loading="lazy" class="w-full h-auto object-cover aspect-[4/5]">
                    </figure>
                {% elseif loop.index == 5 %}
                    <figure class="absolute bottom-[15%] right-[22%] w-[18%] max-w-[240px] shadow-sm z-10 {{ anim_class }}" {{ ig.enable_floating_animation ? 'style="animation-delay: ' ~ delays[loop.index0 % 5] ~ 's;"' : ''|raw }}>
                        <img src="{{ item.image }}" alt="{{ item.alt|default(ig.heading) }}" loading="lazy" class="w-full h-auto object-cover aspect-square">
                    </figure>
                {% endif %}
            {% endfor %}

            <div class="ig-collage__text absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-[420px] flex flex-col gap-5 z-10 {{ align_class }}">
                {% if ig.subheading %}
                    <p class="text-xs tracking-[3px] uppercase text-current/80 m-0">{{ ig.subheading }}</p>
                {% endif %}

                <h2 class="ig-collage__heading font-serif text-5xl lg:text-6xl leading-[1.05] text-current m-0">
                    {{ ig.heading }}
                </h2>

                {% if ig.button_text and ig.button_url %}
                    <a href="{{ ig.button_url }}"
                       {% if ig.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                       class="inline-block mt-2 px-8 py-3 border border-current text-xs tracking-[2px] uppercase hover:bg-black hover:text-white transition-colors duration-300">
                        {{ ig.button_text }}
                    </a>
                {% endif %}
            </div>
        </div>

        {# ============ MOBILE — scattered collage ============ #}
        <div class="ig-collage__mobile md:hidden flex flex-col w-full">
            
            <!-- Top Images -->
            <div class="relative w-full h-[320px] max-w-[420px] mx-auto mt-4">
                {% for item in ig.images %}
                    {% if loop.index == 1 %}
                        <figure class="absolute top-0 left-[25%] w-[45%] shadow-sm z-0 {{ anim_class }}" {{ ig.enable_floating_animation ? 'style="animation-delay: ' ~ delays[loop.index0 % 5] ~ 's;"' : ''|raw }}>
                            <img src="{{ item.image }}" alt="{{ item.alt|default(ig.heading) }}" loading="lazy" class="w-full h-auto object-cover aspect-[4/5]">
                        </figure>
                    {% elseif loop.index == 2 %}
                        <figure class="absolute top-[35%] left-[5%] w-[42%] shadow-sm z-10 {{ anim_class }}" {{ ig.enable_floating_animation ? 'style="animation-delay: ' ~ delays[loop.index0 % 5] ~ 's;"' : ''|raw }}>
                            <img src="{{ item.image }}" alt="{{ item.alt|default(ig.heading) }}" loading="lazy" class="w-full h-auto object-cover aspect-square">
                        </figure>
                    {% elseif loop.index == 3 %}
                        <figure class="absolute top-[25%] right-[5%] w-[35%] shadow-sm z-0 {{ anim_class }}" {{ ig.enable_floating_animation ? 'style="animation-delay: ' ~ delays[loop.index0 % 5] ~ 's;"' : ''|raw }}>
                            <img src="{{ item.image }}" alt="{{ item.alt|default(ig.heading) }}" loading="lazy" class="w-full h-auto object-cover aspect-[4/5]">
                        </figure>
                    {% endif %}
                {% endfor %}
            </div>

            <!-- Text Content -->
            <div class="flex flex-col gap-4 py-12 px-4 w-full {{ align_class }}">
                {% if ig.subheading %}
                    <p class="text-xs tracking-[3px] uppercase text-current/80 m-0">{{ ig.subheading }}</p>
                {% endif %}

                <h2 class="ig-collage__heading font-serif text-4xl leading-tight text-current m-0">
                    {{ ig.heading }}
                </h2>

                {% if ig.button_text and ig.button_url %}
                    <a href="{{ ig.button_url }}"
                       {% if ig.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                       class="inline-block mt-1 px-7 py-2.5 border border-current text-xs tracking-[2px] uppercase">
                        {{ ig.button_text }}
                    </a>
                {% endif %}
            </div>

            <!-- Bottom Images -->
            <div class="relative w-full h-[280px] max-w-[420px] mx-auto mb-4">
                {% for item in ig.images %}
                    {% if loop.index == 4 %}
                        <figure class="absolute bottom-0 left-[10%] w-[45%] shadow-sm z-0 {{ anim_class }}" {{ ig.enable_floating_animation ? 'style="animation-delay: ' ~ delays[loop.index0 % 5] ~ 's;"' : ''|raw }}>
                            <img src="{{ item.image }}" alt="{{ item.alt|default(ig.heading) }}" loading="lazy" class="w-full h-auto object-cover aspect-[4/5]">
                        </figure>
                    {% elseif loop.index == 5 %}
                        <figure class="absolute top-[10%] right-[10%] w-[42%] shadow-sm z-10 {{ anim_class }}" {{ ig.enable_floating_animation ? 'style="animation-delay: ' ~ delays[loop.index0 % 5] ~ 's;"' : ''|raw }}>
                            <img src="{{ item.image }}" alt="{{ item.alt|default(ig.heading) }}" loading="lazy" class="w-full h-auto object-cover aspect-square">
                        </figure>
                    {% endif %}
                {% endfor %}
            </div>
        </div>

    </div>
</section>

{% endif %}

<style>
    .ig-collage__heading { letter-spacing: 0.5px; }
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    @keyframes igFloatUpAndDown {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-12px); }
    }
    .ig-float-animation {
        animation: igFloatUpAndDown 4s ease-in-out infinite;
    }
</style>