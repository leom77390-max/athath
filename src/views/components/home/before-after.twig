<style>
    @keyframes marquee-scroll {
        0% {
            transform: translateX(50%);
        }
        100% {
            transform: translateX(0);
        }
    }
    .animate-marquee {
        display: flex;
        width: max-content;
        animation: marquee-scroll linear infinite;
    }
    .rtl .animate-marquee {
        animation-direction: reverse;
    }

    .animate-marquee,
    .animate-marquee span,
    .animate-marquee i {
        color: {{ component.marquee_color|default(marquee_color)|default('#EFEFEF') }} !important;
    }

    /* مظهر أداة السحب */
    .ba-handle {
        touch-action: none;
    }
    .ba-handle-btn {
        background-color: #ffffff !important;
        border-radius: 999px !important;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.22);
    }
</style>

<section class="py-12 md:py-20 overflow-hidden" style="background-color: {{ component.bg_color|default('#7B3F2A') }};">
    
    {# الشريط المتحرك العلوي #}
    {% if component.show_marquee %}
        {% set marquee_text_color = component.marquee_color|default(marquee_color)|default('#EFEFEF') %}
        <div
            class="mb-10 md:mb-16 py-3 overflow-hidden flex items-center pointer-events-none"
            style="color: {{ marquee_text_color }} !important; {% if component.marquee_opacity is defined and component.marquee_opacity != '' %}opacity: {{ (component.marquee_opacity / 100) }};{% else %}opacity: 1;{% endif %}"
        >
            <div
                class="animate-marquee flex items-center whitespace-nowrap"
                style="color: {{ marquee_text_color }} !important; animation-duration: {{ component.marquee_speed|default(30) }}s;"
            >
                {% for i in 1..2 %}
                    <div class="flex items-center shrink-0">
                        {% for j in 1..4 %}
                            {% for item in component.marquee_items %}
                                <div class="flex items-center gap-8 md:gap-12 px-4 md:px-6">
                                    <span class="text-3xl md:text-5xl lg:text-6xl font-serif tracking-widest uppercase" style="color: {{ marquee_text_color }} !important;">{{ item.text }}</span>
                                    {% if item.icon %}
                                        <i class="{{ item.icon }} text-2xl md:text-3xl" style="color: {{ marquee_text_color }} !important;"></i>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <div class="{% if component.apply_container %} container mx-auto px-4 {% else %} w-full px-6 {% endif %}">
        
        {# أداة مقارنة الصور #}
        <div
            class="relative w-full max-w-5xl mx-auto aspect-[4/3] md:aspect-video bg-black overflow-hidden shadow-2xl select-none"
            id="ba-slider-{{ component.id }}"
            dir="ltr"
        > {# استخدمنا dir=ltr لضمان صحة حسابات الماوس دائماً #}
            
            {# الصورة الخلفية (بعد) #}
            <img src="{{ component.image_after }}" class="absolute inset-0 w-full h-full object-cover pointer-events-none" alt="After">
            
            {% if component.label_after %}
                <span
                    class="absolute top-4 right-4 px-3 py-1 text-xs md:text-sm font-bold shadow-sm z-10"
                    style="background-color: {{ component.label_bg_color|default('#FFFFFF') }}; color: {{ component.label_text_color|default('#000000') }};"
                >
                    {{ component.label_after }}
                </span>
            {% endif %}

            {# الطبقة العلوية المقطوعة (قبل) #}
            <div
                class="ba-before-panel absolute inset-y-0 left-0 w-1/2 overflow-hidden border-r-2 z-20"
                style="border-color: {{ component.slider_color|default('#FFFFFF') }};"
            >
                <img src="{{ component.image_before }}" class="ba-before-img absolute inset-0 h-full object-cover pointer-events-none" alt="Before" style="max-width: none;">
                
                {% if component.label_before %}
                    <span
                        class="absolute top-4 left-4 px-3 py-1 text-xs md:text-sm font-bold shadow-sm z-30"
                        style="background-color: {{ component.label_bg_color|default('#FFFFFF') }}; color: {{ component.label_text_color|default('#000000') }};"
                    >
                        {{ component.label_before }}
                    </span>
                {% endif %}
            </div>

            {# مقبض السحب #}
            <div class="ba-handle absolute inset-y-0 left-1/2 w-0 z-30 cursor-ew-resize pointer-events-none">
                <div
                    class="ba-handle-btn absolute top-1/2 left-0 -translate-x-1/2 -translate-y-1/2 w-10 h-10 md:w-11 md:h-11 flex items-center justify-center select-none pointer-events-auto transition-transform active:scale-95"
                    style="background-color: #ffffff; border-radius: 999px;"
                    aria-label="Drag slider handle"
                >
                    <svg width="12" height="16" viewBox="0 0 12 16" fill="none" xmlns="http://www.w3.org/2000/svg" class="pointer-events-none select-none">
                        <rect x="0" y="0" width="2" height="16" rx="0.75" fill="{{ component.slider_icon_color|default('#222222') }}"/>
                        <rect x="5" y="0" width="2" height="16" rx="0.75" fill="{{ component.slider_icon_color|default('#222222') }}"/>
                        <rect x="10" y="0" width="2" height="16" rx="0.75" fill="{{ component.slider_icon_color|default('#222222') }}"/>
                    </svg>
                </div>
            </div>
            
        </div>

        {# النصوص السفلية #}
        <div class="text-center mt-12 md:mt-16 flex flex-col items-center">
            {% if component.bottom_title %}
                <h2 class="text-2xl md:text-4xl font-serif leading-snug md:leading-normal mb-6" style="color: {{ component.bottom_title_color|default('#FFFFFF') }};">
                    {{ component.bottom_title|nl2br }}
                </h2>
            {% endif %}

            {% if component.bottom_link_text %}
                <a href="{{ component.bottom_link_url }}" class="special-btn text-xs md:text-sm font-bold tracking-widest uppercase transition-opacity hover:opacity-75" style="color: {{ component.bottom_link_color|default('#EFEFEF') }};">
                    {{ component.bottom_link_text }}
                </a>
            {% endif %}
        </div>

    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const container = document.getElementById("ba-slider-{{ component.id }}");
        if (!container) return;

        const beforePanel = container.querySelector(".ba-before-panel");
        const beforeImg = container.querySelector(".ba-before-img");
        const handle = container.querySelector(".ba-handle");
        let isDragging = false;

        // مطابقة عرض الصورة العلوية مع عرض الحاوية الأصلية
        function updateImgWidth() {
            beforeImg.style.width = container.offsetWidth + "px";
        }
        updateImgWidth();
        window.addEventListener("resize", updateImgWidth);

        // وظيفة حساب وتحديث مكان الفاصل
        function moveSlider(pageX) {
            const rect = container.getBoundingClientRect();
            let x = pageX - rect.left;
            x = Math.max(0, Math.min(x, rect.width)); // التأكد من عدم الخروج عن حدود الصورة
            let percent = (x / rect.width) * 100;

            beforePanel.style.width = percent + "%";
            handle.style.left = percent + "%";
        }

        // أحداث الماوس واللمس
        const startDrag = (e) => {
            isDragging = true;
            container.classList.add("cursor-ew-resize");
            let pageX = e.type.includes("mouse") ? e.pageX : e.touches[0].clientX;
            moveSlider(pageX);
        };
        const endDrag = (e) => {
            isDragging = false;
            container.classList.remove("cursor-ew-resize");
        };
        const onDrag = (e) => {
            if (!isDragging) return;
            e.preventDefault(); // منع تحديد النصوص أثناء السحب
            let pageX = e.type.includes("mouse") ? e.pageX : e.touches[0].clientX;
            moveSlider(pageX);
        };

        container.addEventListener("mousedown", startDrag);
        container.addEventListener("touchstart", startDrag, { passive: true });

        window.addEventListener("mouseup", endDrag);
        window.addEventListener("touchend", endDrag);

        window.addEventListener("mousemove", onDrag);
        window.addEventListener("touchmove", onDrag, { passive: false });
    });
</script>
