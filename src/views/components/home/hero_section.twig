{# ============================================================ #}
{# Peek/Coverflow Hero Slider — يطابق تصميم الفيديو             #}
{# ============================================================ #}
{% set width_class = '' %}
{% set width_style = '' %}

	{% if component.banner_width == 'container' %}
	{% set width_class = 'container' %}
{% elseif component.banner_width == 'percentage' %}
	{% set width_class = 'shopify-hero-percentage-' ~ position %}
{% else %}
	{% set width_class = 'w-full' %}
{% endif %}

<section class="{{ width_class }} mt-6 shopify-hero-{{ position }} mb-10 md:mb-20" style="
		    {{ width_style }}
		    --desktop-height: {{ component.desktop_height | default(90) }}vh;
		    --mobile-height: {{ component.mobile_height | default(70) }}vh;
		  ">
	<div class="inner-content flex flex-col {{ component.block_title or component.subtext ? 'pb-6' : '' }} container
			    {% if component.items_alignment_horizontal|default('center') == 'start' %}
			      items-start text-start
			    {% elseif component.items_alignment_horizontal|default('center') == 'center' %}
			      items-center text-center
			    {% else %}
			      items-end text-end
			    {% endif %}">
		{% if  component.block_title %}
			<h2 class="component-title" style="color: {{ component.blocktitle_color }}">
				{{ component.block_title }}
			</h2>
		{% endif %}
		{% if  component.subtext %}
			<p class="component-subtext" style="color: {{ component.subtext_color }}">
				{{ component.subtext }}
			</p>
		{% endif %}
	</div>
	<salla-slider id="shopify-hero-{{ position }}" type="carousel" auto-play="{{ component.enable_autoplay ? 'true' : 'false' }}" auto-height="{{ component.auto_height ? 'true' : 'false' }}" show-controls="false" pagination="{{ component.show_pagination ? 'true' : 'false' }}" slides-per-view="auto" centered="true" space-between="10" speed="700" class="custom-shopify-style-slider" data-delay="{{ component.delay_time | default(3) }}000" slider-config='{
			          "slidesPerView": "auto",
			          "centeredSlides": true,
			          "spaceBetween": 10,
			          "speed": 700,
			          "loop": true,
			          "navigation": {
			            "nextEl": ".hero-next-{{ position }}",
			            "prevEl": ".hero-prev-{{ position }}"
			          },
			          "pagination": {
			            "el": ".hero-pagination-{{ position }}",
			            "clickable": true
			          }
			          {% if component.enable_autoplay %},
			          "autoplay": {
			            "delay": {{ component.delay_time | default(3) }}000,
			            "disableOnInteraction": false,
			            "pauseOnMouseEnter": true
			          }
			          {% endif %}
			        }'>
		<div slot="items">

			{% for slide in component.banner %}

				{% set v_align = slide.items_alignment_vertical[0] | default('center') %}
				{% set h_align = slide.items_alignment_horizontal[0] | default('start') %}
				{% set mobile_v_align = slide.mobile_items_alignment_vertical[0] | default(v_align) %}
				{% set mobile_h_align = slide.mobile_items_alignment_horizontal[0] | default(h_align) %}

				<div class="custom-slide-item slideshow__item-wrap">

					{% if slide.vid and slide.vid_url %}

						<div class="slide-bg-media slideshow__bg bg-image overflow-hidden">
							<div class="slideshow__slide-bg absolute inset-full">
								<div class="w-full h-full block{% if component.text_animation %} is-animated{% endif %}" data-motion="zoom-out">
									<video class="slide-bg-video{% if slide.blur %} blur-effect{% endif %}" autoplay muted loop playsinline preload="metadata" poster="{{ slide.desktop_bg }}">
										<source src="{{ slide.vid_url }}" type="video/mp4">
									</video>
								</div>
							</div>
						</div>

					{% else %}

						<div class="slide-bg-media slideshow__bg bg-image overflow-hidden">
							<div class="slideshow__slide-bg absolute inset-full">
								<div class="w-full h-full block{% if component.text_animation %} is-animated{% endif %}" data-motion="zoom-out">
									<picture class="slide-bg-picture media media--height media-wrapper block w-full h-full relative overflow-hidden{% if slide.blur %} blur-effect{% endif %} ltr:scale-x-[-1]">
										<source media="(max-width: 767px)" srcset="{{ slide.mobile_bg }}">
										<img src="{{ slide.desktop_bg }}" alt="{{ slide.block_title }}" loading="{{ loop.first ? 'eager' : 'lazy' }}" fetchpriority="{{ loop.first ? 'high' : 'auto' }}">
									</picture>
								</div>
							</div>
						</div>

					{% endif %}

					{% if slide.overlay > 0 %}
						<div class="slide-overlay slideshow__overlay bg-overlay" style="opacity: {{ slide.overlay / 10 }}"></div>
					{% endif %}

					<div class="slide-content-wrapper slideshow__content flex flex-col focus-none color-scheme-inverse
							                      v-align-{{ v_align }}
							                      h-align-{{ h_align }}
							                      mobile-v-align-{{ mobile_v_align }}
							                      mobile-h-align-{{ mobile_h_align }}" tabindex="-1">
						<div class="inner-content slideshow__text rich-text text-center md:text-left">

							{% if slide.block_title %}
								<h2 class="slide-title slideshow__title hd1 rich-text__heading my-3" style="color: {{ slide.blocktitle_color }}">
									<div class="block{% if component.text_animation %} is-animated{% endif %}" data-motion="fade-up" data-motion-delay="250">
										{{ slide.block_title }}
									</div>
								</h2>
							{% endif %}

							{% if slide.subtext %}
								<div class="block slideshow__description text-lg rich-text__text rte{% if component.text_animation %} is-animated{% endif %}" data-motion="fade-up" data-motion-delay="350">
									<p class="slide-subtext" style="color: {{ slide.subtext_color }}">
										{{ slide.subtext }}
									</p>
								</div>
							{% endif %}

							{% if slide.button_text %}
								<div class="slideshow__buttons rich-text__button mt-4">
									<div class="block{% if component.text_animation %} is-animated{% endif %}" data-motion="fade-up" data-motion-delay="450">
										{% set btn_class = 'btn slide-btn slide-btn-' ~ loop.index %}
										{% if slide.button_style[0] == 'outline' %}
											{% set btn_class = btn_class ~ ' btn-outline' %}
										{% elseif slide.button_style[0] == 'underline' %}
											{% set btn_class = btn_class ~ ' btn--underline' %}
										{% else %}
											{% set btn_class = btn_class ~ (slide.transparent_button ? ' btn-transparent' : '') %}
										{% endif %}
										{% include 'components.custom.button_customize.twig' with {
											href: slide.url,
											text: slide.button_text,
											selector:'slide-btn-' ~ loop.index,
											class: btn_class,
											bg: slide.button_bg,
											color: slide.button_text_color,
										} %}
									</div>
								</div>
							{% endif %}

						</div>
					</div>

				</div>

			{% endfor %}

		</div>
	</salla-slider>
	<div class="flex items-center justify-center w-fit gap-4 mx-auto mt-3">
		{% if component.show_navigation %}
			<button class="hero-prev-{{ position }} group relative overflow-hidden !size-11 rounded-full border border-white/20 bg-font backdrop-blur-md text-background flex items-center justify-center transition-all duration-300 hover:bg-background hover:text-font hover:border-font">
				<span class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/40 to-transparent transition-transform duration-700 group-hover:translate-x-full"></span>
				<i class="relative z-10 sicon-arrow-right transition-colors duration-300 group-hover:text-font ltr:scale-x-[-1]"></i>
			</button>
		{% endif %}

		{% if component.show_pagination %}
			<div class="hero-pagination-{{ position }} flex items-center gap-2"></div>
		{% endif %}
		{% if component.show_navigation %}
			<button class="hero-next-{{ position }} group relative overflow-hidden !size-11 rounded-full border border-white/20 bg-font backdrop-blur-md text-background flex items-center justify-center transition-all duration-300 hover:bg-background hover:text-font hover:border-font">
				<span class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/40 to-transparent transition-transform duration-700 group-hover:translate-x-full"></span>
				<i class="relative z-10 sicon-arrow-left transition-colors duration-300 group-hover:text-font ltr:scale-x-[-1]"></i>
			</button>
		{% endif %}
	</div>
</section>
<style>
	.shopify-hero-{{position}}.pagination-and-controls .swiper-pagination-bullet::before, .shopify-hero-{{position}}.pagination-and-controls .swiper-pagination-bullet::after, .shopify-hero-{{position}}.pagination-and-controls .swiper-pagination-bullet {
		background-color: white;
	}
	/* Apply animation */
	.AU-hero-section-{{position}}.swiper-pagination-bullet.swiper-pagination-bullet-active::after {
		animation: afterWidthExpand 5s ease-in-out forwards;
		animation-delay: 0.7s;
	}
	#shopify-hero-{{position}}.carousel-slider .swiper {
		padding: 10px 16px !important;
	}
	.shopify-hero-{{position}}.carousel-slider .swiper {
		padding: 0 12px !important;
		margin: 0 !important;
	}
	.shopify-hero-{{position}}.slide-bg-video, .shopify-hero-{{position}}.slide-bg-picture img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.shopify-hero-{{position}}.slide-bg-media {
		position: absolute;
		inset: 0;
	}
	{% if component.show_pagination %}

		.shopify-hero-{{position}}.hero-pagination-{{position}}.swiper-pagination-bullet {
			position: relative;
			width: 20px !important;
			height: 10px !important;
			margin: 0 4px !important;
			border-radius: 9999px !important;
			background: rgba(0, 0, 0, .2) !important;
			opacity: 1 !important;
			overflow: hidden;
		}
		.shopify-hero-{{position}}.hero-pagination-{{position}}.swiper-pagination-bullet-active {
			width: 40px !important;
		}

		.shopify-hero-{{position}}.hero-pagination-{{position}}.swiper-pagination-bullet::after {
			content: "";
			position: absolute;
			inset: 0;
			width: 0;
			height: 100%;
			background: #000;
			border-radius: inherit;
		}

		.shopify-hero-{{position}}.hero-pagination-{{position}}.swiper-pagination-bullet-active::after {
			animation: heroProgress-{{position}}{{component.delay_time|default(3)}}
			s linear forwards;
		}
		.swiper-pagination-bullets,
		.swiper-pagination-bullets.swiper-pagination-horizontal,
		.swiper-pagination-custom,
		.swiper-pagination-fraction {
			width: fit-content !important;
		}
		@keyframes heroProgress-{{position}}{
			from {
				width: 0;
			}
			to {
				width: 100%;
			}
		}
	{% endif %}
	{% if component.banner_width == 'percentage' %}
		.shopify-hero-percentage-{{position}}{
			width: 100%;
		}
		@media(min-width: 768px) {
			.shopify-hero-percentage-{{position}}{
				width: {{component.banner_percentage_width|default(90)}}
				%;
			}
		}
	{% endif %}

	/* Shopify Component Animations */
	.swiper-slide .is-animated[data-motion="fade-up"] {
		opacity: 0;
		transform: translateY(2.5rem);
		transition: opacity 0.8s ease, transform 0.8s ease;
	}
	.swiper-slide.swiper-slide-active .is-animated[data-motion="fade-up"] {
		opacity: 1;
		transform: translateY(0);
	}
	.swiper-slide .is-animated[data-motion="fade-up"][data-motion-delay="250"] { transition-delay: 250ms; }
	.swiper-slide .is-animated[data-motion="fade-up"][data-motion-delay="350"] { transition-delay: 350ms; }
	.swiper-slide .is-animated[data-motion="fade-up"][data-motion-delay="450"] { transition-delay: 450ms; }

	.swiper-slide .is-animated[data-motion="zoom-out"] {
		transform: scale(1.1);
		transition: transform 3s ease-out;
	}
	.swiper-slide.swiper-slide-active .is-animated[data-motion="zoom-out"] {
		transform: scale(1);
	}

	/* Button Styles */
	.btn--underline {
		background: transparent !important;
		color: currentColor !important;
		border: none !important;
		border-bottom: 1px solid currentColor !important;
		border-radius: 0 !important;
		padding-left: 0 !important;
		padding-right: 0 !important;
		padding-bottom: 2px !important;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}
	.btn-outline {
		background: transparent !important;
		border: 1px solid currentColor !important;
		color: currentColor !important;
	}
</style>
