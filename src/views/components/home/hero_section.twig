{# ============================================================ #}
{# Peek/Coverflow Hero Slider — يطابق تصميم الفيديو             #}
{# ============================================================ #}
<section class="shopify-hero-{{ position }} {% if component.rm_margin %}no-margin{% endif %}"
 style="
    --desktop-height: {{ component.desktop_height | default(90) }}vh;
    --mobile-height: {{ component.mobile_height | default(70) }}vh;
  "
>

<salla-slider
  id="shopify-hero-{{ position }}"
  type="carousel"
  auto-play="{{ component.enable_autoplay ? 'true' : 'false' }}"
  auto-height="{{ component.auto_height ? 'true' : 'false' }}"
  show-controls="false"
  pagination="{{ component.show_pagination ? 'true' : 'false' }}"
  slides-per-view="auto"
  centered="true"
  space-between="5"
  speed="700"
  class="custom-shopify-style-slider"
  data-delay="{{ component.delay_time | default(3) }}000"
  slider-config='{
    "slidesPerView": "auto",
    "centeredSlides": true,
    "spaceBetween": 5,
    "speed": 700,
    "loop": true,
    "navigation": {
      "nextEl": ".hero-next-{{ position }}",
      "prevEl": ".hero-prev-{{ position }}"
    },
    "pagination": {
      "el": ".hero-pagination-{{ position }}",
      "clickable": true
    },
    "autoplay": {
      "delay": {{ component.delay_time | default(3) }}000,
      "disableOnInteraction": false
    }
  }'
>
    <div slot="items">

      {% for slide in component.banner %}

        {% set v_align = slide.items_alignment_vertical[0] | default('center') %}
        {% set h_align = slide.items_alignment_horizontal[0] | default('start') %}
        {% set mobile_v_align = slide.mobile_items_alignment_vertical[0] | default(v_align) %}
        {% set mobile_h_align = slide.mobile_items_alignment_horizontal[0] | default(h_align) %}

        <div class="custom-slide-item">

          <picture class="slide-bg-picture{% if slide.blur %} blur-effect{% endif %} ltr:scale-x-[-1]">
            <source media="(max-width: 767px)" srcset="{{ slide.mobile_bg }}">
            <img
              src="{{ slide.desktop_bg }}"
              alt="{{ slide.block_title }}"
              loading="{{ loop.first ? 'eager' : 'lazy' }}"
              fetchpriority="{{ loop.first ? 'high' : 'auto' }}"
            >
          </picture>

          {% if slide.overlay > 0 %}
            <div class="slide-overlay" style="opacity: {{ slide.overlay / 10 }}"></div>
          {% endif %}

          <div class="  slide-content-wrapper
                    v-align-{{ v_align }}
                    h-align-{{ h_align }}
                    mobile-v-align-{{ mobile_v_align }}
                    mobile-h-align-{{ mobile_h_align }}">
            <div class="inner-content">

              {% if slide.subtext %}
                <p class="slide-subtext" style="color: {{ slide.subtext_color }}">
                  {{ slide.subtext }}
                </p>
              {% endif %}

              {% if slide.block_title %}
                <h2 class="slide-title" style="color: {{ slide.blocktitle_color }}">
                  {{ slide.block_title }}
                </h2>
              {% endif %}

              {% if slide.button_text %}
                <a
                  href="{{ slide.url }}"
                  class="slide-btn{% if slide.transparent_button %} btn-transparent{% endif %}"
                  style="background-color: {{ slide.button_bg }}; color: {{ slide.button_text_color }}"
                >
                  {{ slide.button_text }}
                </a>
              {% endif %}

            </div>
          </div>

        </div>

      {% endfor %}

    </div>
  </salla-slider>

</section>
<style>
    #shopify-hero-{{ position }} .carousel-slider .swiper {
    padding: 10px 16px !important;
}
.shopify-hero-{{ position }} .carousel-slider .swiper{
  padding:0 !important;
  margin:0 !important;
}
</style>