<section class="SK_special_categories_{{position}} SK_special_categories">

  {% set source_mode = component.categories_is_manual %}
  {% if source_mode is iterable %}{% set source_mode = source_mode.value %}{% endif %}
  {% set source_mode = source_mode | default('manual') %}

  {% set main_title       = component.main_title %}
  {% set main_description = component.main_description %}

  {# ===== عدد الأعمدة أوتوماتيك ===== #}
  {% if source_mode == 'categories' %}
    {% set item_count = component.categories_list | length %}
  {% else %}
    {% set item_count = component.card | length %}
  {% endif %}
  {% set grid_columns = item_count > 0 ? item_count : 4 %}
  {% if grid_columns > 6 %}{% set grid_columns = 6 %}{% endif %}

  {% if main_title or main_description %}
    <div class="sk-header">
      {% if main_title %}<h2 class="sk-main-title">{{ main_title }}</h2>{% endif %}
      {% if main_description %}<p class="sk-main-desc">{{ main_description }}</p>{% endif %}
    </div>
  {% endif %}

  <div class="sk-container">

    <div class="sk-grid" style="grid-template-columns: repeat({{ grid_columns }}, 1fr);">

      {% if source_mode == 'manual' %}
        {% for item in component.card %}
          {% set bg_image     = item.bg_image            | default('') %}
          {% set bg_color     = item.bg_color            | default('#f5f0eb') %}
          {% set is_image     = item.background_is_image %}
          {% set title        = item.title               | default('') %}
          {% set title_color  = item.title_color         | default('#ffffff') %}
          {% set radius       = item.corner_rounded      | default(16) %}
          {% set shadow_color = item.shadow_color        | default('#000000') %}
          {% set shadow_blur  = item.shadow_blur         | default(16) %}
          {% set btn_url      = item.btn_url             | default('#') %}

          <a href="{{ btn_url }}" class="sk-card"
             style="border-radius: {{ radius }}px; --shadow-color: {{ shadow_color }}; --shadow-blur: {{ shadow_blur }}px;">
            <div class="sk-card-image" style="
              {% if is_image and bg_image %}
                background-image: url('{{ bg_image }}');
              {% else %}
                background-color: {{ bg_color }};
              {% endif %}
            "></div>
            <div class="sk-card-overlay"></div>
            <span class="sk-card-title" style="color: {{ title_color }};">{{ title }}</span>
          </a>
        {% endfor %}

      {% else %}
        {% for cat in component.categories_list %}
          <a href="{{ cat.url | default('#') }}" class="sk-card"
             style="border-radius: 16px; --shadow-color: #000000; --shadow-blur: 16px;">
            <div class="sk-card-image" style="
              {% if cat.image %}
                background-image: url('{{ cat.image }}');
              {% else %}
                background-color: #f5f0eb;
              {% endif %}
            "></div>
            <div class="sk-card-overlay"></div>
            <span class="sk-card-title">{{ cat.name }}</span>
          </a>
        {% endfor %}
      {% endif %}

    </div>

  </div>

</section>

<style>
  .SK_special_categories_{{position}} {
    padding: clamp(30px, 5vw, 60px) clamp(12px, 3vw, 20px);
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #ffffff;
  }

  /* ===== Header ===== */
  .SK_special_categories_{{position}} .sk-header {
    text-align: center;
    margin-bottom: clamp(24px, 4vw, 40px);
    width: 100%;
  }

  .SK_special_categories_{{position}} .sk-main-title {
    font-size: clamp(1.3rem, 3.5vw, 2.4rem);
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: clamp(8px, 1.5vw, 14px);
    letter-spacing: -0.5px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: {{ component.main_title_color | default('#18181b') }};
  }

  .SK_special_categories_{{position}} .sk-main-desc {
    font-size: clamp(0.85rem, 1.8vw, 1.1rem);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: {{ component.main_description_color | default('#444444') }};
  }

  /* ===== Container ===== */
  .SK_special_categories_{{position}} .sk-container {
    width: 100%;
    {% if component.add_inside_container %}
      max-width: 1200px;
      margin-inline: auto;
    {% endif %}
  }

  /* ===== Grid ===== */
  .SK_special_categories_{{position}} .sk-grid {
    display: grid;
    gap: clamp(8px, 1.5vw, 16px);
    width: 100%;
    justify-content: center;
  }

  /* ===== Card ===== */
  .SK_special_categories_{{position}} .sk-card {
    position: relative;
    height: clamp(90px, 12vw, 160px);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
    --shadow-color: #000000;
    --shadow-blur: 16px;
  }

  .SK_special_categories_{{position}} .sk-card-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: transform 0.5s ease-in-out;
    z-index: 1;
  }

  /* ===== Overlay ===== */
  .SK_special_categories_{{position}} .sk-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--shadow-color) 0%,
      transparent var(--shadow-blur)
    );
    opacity: 0.85;
    transition: opacity 0.5s ease-in-out, background 0.5s ease-in-out;
    z-index: 2;
  }

  .SK_special_categories_{{position}} .sk-card:hover .sk-card-image {
    transform: scale(1.08);
  }

  .SK_special_categories_{{position}} .sk-card:hover .sk-card-overlay {
    opacity: 1;
    background: linear-gradient(
      to top,
      var(--shadow-color) 0%,
      transparent calc(var(--shadow-blur) * 1.5)
    );
  }

  /* ===== Card Title ===== */
  .SK_special_categories_{{position}} .sk-card-title {
    font-size: clamp(0.75rem, 1.4vw, 1.1rem);
    font-weight: 500;
    line-height: 1.3;
    position: relative;
    z-index: 3;
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
    text-align: center;
    padding: 0 clamp(6px, 1vw, 12px);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== Responsive ===== */
  @media (max-width: 767px) {
    .SK_special_categories_{{position}} .sk-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  @media (max-width: 480px) {
    .SK_special_categories_{{position}} .sk-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>