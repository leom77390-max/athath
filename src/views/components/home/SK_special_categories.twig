<section class="SK_special_categories_{{position}} SK_special_categories">

	{#
	  All three fields below are type:"items" format:"dropdown-list".
	  Salla returns them as an array of selected option objects:
	    [ { "label": "...", "value": "slider", "key": "..." } ]
	  After |first we get the object. Access .value to extract the string.
	  If Salla ever returns a plain string instead, .value is null and
	  |default() falls back to the raw first value transparently.
	#}
	{% set _mode_raw   = component.categories_is_manual %}
	{% set _mode_first = _mode_raw is iterable ? _mode_raw | first : _mode_raw %}
	{% set source_mode = _mode_first.value | default(_mode_first) | default('manual') %}

	{% set _shape_raw   = component.card_shape %}
	{% set _shape_first = _shape_raw is iterable ? _shape_raw | first : _shape_raw %}
	{% set card_shape   = _shape_first.value | default(_shape_first) | default('rounded') %}

	{% set _layout_raw  = component.layout_type %}
	{% set _layout_first = _layout_raw is iterable ? _layout_raw | first : _layout_raw %}
	{% set layout_type   = _layout_first.value | default(_layout_first) | default('grid') %}

	{% set grid_desktop    = component.grid_desktop_cols | default(5) %}
	{% set grid_tablet     = component.grid_tablet_cols | default(3) %}
	{% set grid_mobile     = component.grid_mobile_cols | default(2) %}

	{% set slider_desktop  = component.slider_desktop_cols | default(4.5) %}
	{% set slider_tablet   = component.slider_tablet_cols | default(3.5) %}
	{% set slider_mobile   = component.slider_mobile_cols | default(1.5) %}
	{% set autoplay        = component.slider_autoplay is same as(true) %}
	{% set loop            = component.slider_loop is not same as(false) %}
	{% set autoplay_speed  = component.slider_autoplay_speed | default(3000) %}

	{% set control_card_size = component.control_card_size is same as(true) %}
	{% set c_width_desktop   = component.card_width_desktop | default('100%') %}
	{% set c_width_tablet    = component.card_width_tablet | default('100%') %}
	{% set c_width_mobile    = component.card_width_mobile | default('100%') %}
	{% set c_height_desktop  = component.card_height_desktop | default('140px') %}
	{% set c_height_tablet   = component.card_height_tablet | default('140px') %}
	{% set c_height_mobile   = component.card_height_mobile | default('140px') %}

	{# Page direction — matches the rest of the theme #}
	{% set page_dir = user.language.code == 'ar' ? 'rtl' : 'ltr' %}

	{% set main_title       = component.main_title %}
	{% set main_description = component.main_description %}
	{% if main_title or main_description %}
		<div class="sk-header">
			{% if main_title %}
				<h2>{{ main_title }}</h2>
			{% endif %}
			{% if main_description %}
				<p>{{ main_description }}</p>
			{% endif %}
		</div>
	{% endif %}

	<div class="sk-container">



		{% if layout_type == 'slider' or layout_type == 'layout_slider' %}

			{# ── SLIDER MODE ─────────────────────────────────────────────────────── #}
			{#
			   salla-slider uses its own slot mechanism.
			   Rules for correct initialisation:
			   - slot="items" div must NOT have class="swiper-wrapper"
			   - Direct children of slot="items" are each rendered as one slide
			   - Do NOT add class="swiper-slide" to those children; the web component handles it
			   - dir must match page direction
			#}
			<salla-slider
				id="sk-special-cats-slider-{{ position }}"
				class="sk-special-cats-slider"
				dir="{{ page_dir }}"
				type="carousel"
				show-controls="false"
				loop="{{ loop ? 'true' : 'false' }}"
				slider-config='{
					"slidesPerView": {{ slider_mobile }},
					"spaceBetween": 16,
					"breakpoints": {
						"0":    { "slidesPerView": {{ slider_mobile }}, "spaceBetween": 12 },
						"640":  { "slidesPerView": {{ slider_tablet }}, "spaceBetween": 16 },
						"1024": { "slidesPerView": {{ slider_desktop }}, "spaceBetween": 16 }
					}
					{% if autoplay %},
					"autoplay": {
						"delay": {{ autoplay_speed }},
						"disableOnInteraction": false
					}
					{% endif %}
				}'>

				<div slot="items">

					{% if source_mode == 'manual' %}
						{% for item in component.card %}
							{% set bg_image    = item.bg_image     | default('') %}
							{% set bg_color    = item.bg_color     | default('#f5f0eb') %}
							{% set title       = item.title        | default('') %}
							{% set title_color = item.title_color  | default('#ffffff') %}
							{% set shadow_color= item.shadow_color | default('#18181b') %}
							{% set btn_url     = item.btn_url      | default('#') %}

							<div class="sk-slide-item">
								<a href="{{ btn_url }}" class="sk-card" style="--shadow-color: {{ shadow_color }};">
									<div class="sk-card-image" style="
										{% if bg_image %}
										  background-image: url('{{ bg_image }}');
										{% else %}
										  background-color: {{ bg_color }};
										{% endif %}
									"></div>
									<div class="sk-card-overlay"></div>
									<span class="sk-card-title" style="color: {{ title_color }};">
										{{ title }}
									</span>
								</a>
							</div>
						{% endfor %}

					{% else %}
						{% set title_color  = component.categories_title_color | default('#ffffff') %}
						{% set shadow_color = component.shadow_card_color      | default('#18181b') %}

						{% for cat in component.categories_list %}
							<div class="sk-slide-item">
								<a href="{{ cat.url | default('#') }}" class="sk-card" style="--shadow-color: {{ shadow_color }};">
									<div class="sk-card-image" style="
										{% if cat.image %}
										  background-image: url('{{ cat.image }}');
										{% else %}
										  background-color: #f5f0eb;
										{% endif %}
									"></div>
									<div class="sk-card-overlay"></div>
									<span class="sk-card-title" style="color: {{ title_color }};">{{ cat.name }}</span>
								</a>
							</div>
						{% endfor %}
					{% endif %}

				</div>
			</salla-slider>

		{% else %}

			{# ── GRID MODE ────────────────────────────────────────────────────────── #}
			<div class="sk-grid">

				{% if source_mode == 'manual' %}
					{% for item in component.card %}
						{% set bg_image    = item.bg_image     | default('') %}
						{% set bg_color    = item.bg_color     | default('#f5f0eb') %}
						{% set title       = item.title        | default('') %}
						{% set title_color = item.title_color  | default('#ffffff') %}
						{% set shadow_color= item.shadow_color | default('#18181b') %}
						{% set btn_url     = item.btn_url      | default('#') %}

						<a href="{{ btn_url }}" class="sk-card" style="--shadow-color: {{ shadow_color }};">
							<div class="sk-card-image" style="
								{% if bg_image %}
								  background-image: url('{{ bg_image }}');
								{% else %}
								  background-color: {{ bg_color }};
								{% endif %}
							"></div>
							<div class="sk-card-overlay"></div>
							<span class="sk-card-title" style="color: {{ title_color }};">
								{{ title }}
							</span>
						</a>
					{% endfor %}

				{% else %}
					{% set title_color  = component.categories_title_color | default('#ffffff') %}
					{% set shadow_color = component.shadow_card_color      | default('#18181b') %}

					{% for cat in component.categories_list %}
						<a href="{{ cat.url | default('#') }}" class="sk-card" style="--shadow-color: {{ shadow_color }};">
							<div class="sk-card-image" style="
								{% if cat.image %}
								  background-image: url('{{ cat.image }}');
								{% else %}
								  background-color: #f5f0eb;
								{% endif %}
							"></div>
							<div class="sk-card-overlay"></div>
							<span class="sk-card-title" style="color: {{ title_color }};">{{ cat.name }}</span>
						</a>
					{% endfor %}
				{% endif %}

			</div>

		{% endif %}

	</div>

</section>

<style>
	.SK_special_categories_{{position}} {
		padding: 60px 20px;
		display: flex;
		flex-direction: column;
		align-items: center;
		background-color: #ffffff;
	}

	.SK_special_categories_{{position}} .sk-header {
		text-align: center;
		margin-bottom: 40px;
		width: 100%;
	}

	.SK_special_categories_{{position}} .sk-header h2 {
		font-size: 2.2rem;
		font-weight: 600;
		margin-bottom: 12px;
		letter-spacing: -0.5px;
		color: {{ component.main_title_color | default('#18181b') }};
	}

	.SK_special_categories_{{position}} .sk-header p {
		font-size: 1.1rem;
		color: {{ component.main_description_color | default('#666666') }};
	}

	.SK_special_categories_{{position}} .sk-container {
		width: 100%;
		{% if component.add_inside_container %}
			max-width: 1200px;
			margin-inline: auto;
		{% endif %}
	}

	/* ── GRID layout ─────────────────────────────── */
	.SK_special_categories_{{position}} .sk-grid {
		display: grid;
		grid-template-columns: repeat({{ grid_desktop }}, 1fr);
		gap: 16px;
		width: 100%;
	}

	/* ── SLIDER layout ───────────────────────────── */
	.SK_special_categories_{{position}} .sk-special-cats-slider {
		width: 100%;
		display: block;
	}

	/* Slide item wrapper — fills the slide allocated by salla-slider */
	.SK_special_categories_{{position}} .sk-slide-item {
		width: 100%;
		height: 100%;
		display: block;
	}

	/* ── CARD ─────────────────────────────────────── */
	.SK_special_categories_{{position}} .sk-card {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		cursor: pointer;
		text-decoration: none;
		width: 100%;
		/* Shape */
		{% if card_shape == 'square' %}
			border-radius: 0;
			{% if not control_card_size %}
			aspect-ratio: 1 / 1;
			{% endif %}
		{% elseif card_shape == 'circle' %}
			border-radius: 50%;
			{% if not control_card_size %}
			aspect-ratio: 1 / 1;
			{% endif %}
		{% else %}
			border-radius: 16px;
			{% if not control_card_size %}
			height: 140px;
			{% endif %}
		{% endif %}
		/* Custom height (desktop default) */
		{% if control_card_size %}
		height: {{ c_height_desktop }};
		{% endif %}
		/*
		  Use specific properties only — "transition: all" breaks slider drag
		  because it transitions "width" and "transform" mid-swipe.
		*/
		transition: transform 0.4s ease-in-out, box-shadow 0.4s ease-in-out;
	}

	.SK_special_categories_{{position}} .sk-card-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		transition: transform 0.5s ease-in-out;
		z-index: 1;
	}

	.SK_special_categories_{{position}} .sk-card-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, var(--shadow-color, #18181b) 0%, transparent 60%);
		transition: background 0.4s ease-in-out;
		z-index: 2;
		/* pointer-events: none so it does NOT block link clicks or slider touch events */
		pointer-events: none;
	}

	.SK_special_categories_{{position}} .sk-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 20px -10px var(--shadow-color, #18181b);
	}

	.SK_special_categories_{{position}} .sk-card:hover .sk-card-image {
		transform: scale(1.06);
	}

	.SK_special_categories_{{position}} .sk-card:hover .sk-card-overlay {
		background: linear-gradient(to top, var(--shadow-color, #18181b) -20%, transparent 80%);
		transition-delay: 0.15s;
	}

	.SK_special_categories_{{position}} .sk-card-title {
		color: #ffffff;
		font-size: 1rem;
		font-weight: 500;
		position: relative;
		z-index: 3;
		padding: 12px 14px;
		text-align: center;
	}

	/* ── RESPONSIVE ─────────────────────────────── */
	@media(max-width: 950px) {
		.SK_special_categories_{{position}} .sk-grid {
			grid-template-columns: repeat({{ grid_tablet }}, 1fr);
		}
		{% if control_card_size %}
		.SK_special_categories_{{position}} .sk-card {
			height: {{ c_height_tablet }};
		}
		{% endif %}
	}

	@media(max-width: 600px) {
		.SK_special_categories_{{position}} .sk-grid {
			grid-template-columns: repeat({{ grid_mobile }}, 1fr);
		}
		{% if control_card_size %}
		.SK_special_categories_{{position}} .sk-card {
			height: {{ c_height_mobile }};
		}
		{% endif %}
	}
</style>
