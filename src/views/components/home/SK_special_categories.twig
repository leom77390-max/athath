<section class="SK_special_categories_{{position}} SK_special_categories">

	{#
	  categories_is_manual is a dropdown-list field.
	  Salla returns selected dropdown value as a string or array.
	  We compare as string by taking [0] if array, or directly if string.
	#}
	{% set _mode_raw    = component.categories_is_manual %}
	{% set source_mode  = _mode_raw is iterable ? _mode_raw | first : _mode_raw %}
	{% set source_mode  = source_mode | default('manual') %}

	{% set items_count  = source_mode == 'manual' ? component.card|length : component.categories_list|length %}
	{% set desktop_cols = items_count > 0 and items_count < 5 ? items_count : 5 %}
	{% set tablet_cols  = items_count > 0 and items_count < 3 ? items_count : 3 %}
	{% set mobile_cols  = items_count > 0 and items_count < 2 ? items_count : 2 %}

	{% set main_title       = component.main_title %}
	{% set main_description = component.main_description %}
	{% if main_title or main_description %}
		<div class="sk-header">
			{% if main_title %}
				<h2>{{ main_title }}</h2>
			{% endif %}
			{% if main_description %}
				<p>{{ main_description }}</p>
			{% endif %}
		</div>
	{% endif %}

	<div class="sk-container">

		<div class="sk-grid">

			{% if source_mode == 'manual' %}
				{% for item in component.card %}
					{% set bg_image    = item.bg_image            | default('') %}
					{% set bg_color    = item.bg_color            | default('#f5f0eb') %}
					{% set is_image    = item.background_is_image %}
					{% set title       = item.title               | default('') %}
					{% set title_color = item.title_color         | default('#ffffff') %}
					{% set radius      = item.corner_rounded      | default(16) %}
					{% set btn_url     = item.btn_url             | default('#') %}

					<a href="{{ btn_url }}" class="sk-card" style="border-radius: {{ radius }}px;">
						<div class="sk-card-image" style="
							{% if bg_image %}
							  background-image: url('{{ bg_image }}');
							{% else %}
							  background-color: {{ bg_color }};
							{% endif %}
						"></div>
						<div class="sk-card-overlay"></div>
						<span class="sk-card-title" style="color: {{ title_color }};">
							{{ title }}
						</span>
					</a>
				{% endfor %}

			{% else %}
				{% set radius      = component.corner_rounded         | default(16) %}
				{% set title_color = component.categories_title_color | default('#ffffff') %}

				{% for cat in component.categories_list %}
					<a href="{{ cat.url | default('#') }}" class="sk-card" style="border-radius: {{ radius }}px;">
						<div class="sk-card-image" style="
							{% if cat.image %}
							  background-image: url('{{ cat.image }}');
							{% else %}
							  background-color: #f5f0eb;
							{% endif %}
						"></div>
						<div class="sk-card-overlay"></div>
						<span class="sk-card-title" style="color: {{ title_color }};">{{ cat.name }}</span>
					</a>
				{% endfor %}
			{% endif %}

		</div>

	</div>

</section>

<style>
	.SK_special_categories_{{position}}{
		padding: 60px 20px;
		display: flex;
		flex-direction: column;
		align-items: center;
		background-color: #ffffff;
	}

	.SK_special_categories_{{position}} .sk-header {
		text-align: center;
		margin-bottom: 40px;
	}

	.SK_special_categories_{{position}} .sk-header h2 {
		font-size: 2.2rem;
		font-weight: 600;
		margin-bottom: 12px;
		letter-spacing: -0.5px;
		color: {{ component.main_title_color | default('#18181b') }};
	}

	.SK_special_categories_{{position}} .sk-header p {
		font-size: 1.1rem;
		color: {{ component.main_description_color | default('#666666') }};
	}

	.SK_special_categories_{{position}} .sk-container {
		width: 100%;
		{% if component.add_inside_container %}
			max-width: 1200px;
			margin-inline: auto;
		{% endif %}
	}

	.SK_special_categories_{{position}} .sk-grid {
		display: grid;
		grid-template-columns: repeat({{ desktop_cols }}, 1fr);
		gap: 16px;
		width: 100%;
		justify-content: center;
	}

	.SK_special_categories_{{position}} .sk-card {
		position: relative;
		height: 140px;
		border-radius: 16px;
		overflow: hidden;
		display: flex;
		align-items: flex-end;
		justify-content: flex-start;
		cursor: pointer;
		text-decoration: none;
	}

	.SK_special_categories_{{position}} .sk-card-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		transition: transform 0.5s ease-in-out;
		z-index: 1;
	}

	.SK_special_categories_{{position}} .sk-card-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.05) 60%);
		transition: background 0.4s ease-in-out;
		z-index: 2;
	}

	.SK_special_categories_{{position}} .sk-card:hover .sk-card-image {
		transform: scale(1.06);
	}

	.SK_special_categories_{{position}} .sk-card:hover .sk-card-overlay {
		background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.1) 70%);
		transition-delay: 0.15s;
	}

	.SK_special_categories_{{position}} .sk-card-title {
		color: #ffffff;
		font-size: 1rem;
		font-weight: 500;
		position: relative;
		z-index: 3;
		padding: 12px 14px;
	}

	@media(max-width: 950px) {
		.SK_special_categories_{{position}} .sk-grid {
			grid-template-columns: repeat({{ tablet_cols }}, 1fr);
		}
	}

	@media(max-width: 600px) {
		.SK_special_categories_{{position}} .sk-grid {
			grid-template-columns: repeat({{ mobile_cols }}, 1fr);
		}
	}
</style>
